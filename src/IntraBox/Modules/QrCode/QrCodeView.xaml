<UserControl x:Class="IntraBox.Modules.QrCode.QrCodeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:IntraBox.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <WrapPanel Grid.Row="0" Margin="0,0,0,8">
            <Button Content="生成" Style="{StaticResource PrimaryButton}" Margin="0,4,8,4" Click="Generate_Click"/>
            <Button Content="保存 PNG" Margin="0,4,8,4" Click="Save_Click"/>
            <Button Content="复制图片" Margin="0,4,8,4" Click="Copy_Click"/>
            <Button Content="从图片解码" Margin="0,4,8,4" Click="Decode_Click"/>
            <TextBlock x:Name="MsgText" VerticalAlignment="Center" Margin="8,4,0,4"
                       Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
        </WrapPanel>

        <TextBlock Grid.Row="1" Text="文本" Margin="0,0,0,4"
                   Foreground="{DynamicResource TextSecondaryBrush}"/>
        <controls:CodeEditor x:Name="InputBox" Grid.Row="2" MinHeight="80"/>

        <Border Grid.Row="3" Margin="0,12,0,0" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" Background="{DynamicResource PanelBgBrush}">
            <Grid>
                <TextBlock Text="预览" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8,6,0,0"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                <Image x:Name="PreviewImage" Margin="8,28,8,8" Stretch="Uniform"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
