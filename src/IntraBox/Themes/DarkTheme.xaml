<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- IntelliJ IDEA Darcula 风格 -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="#4A88C7"/>
    <SolidColorBrush x:Key="DarkPrimaryBrush" Color="#3A6FA8"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#4A88C7"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#5B97D4"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#3A6FA8"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#FF6B68"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#E6A23C"/>
    <SolidColorBrush x:Key="HostsUnsavedRowBrush" Color="#554A28"/>
    <SolidColorBrush x:Key="HostsUnsavedRowSelectedBrush" Color="#7A6430"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#629755"/>
    <SolidColorBrush x:Key="OkBrush" Color="#629755"/>
    <SolidColorBrush x:Key="WindowBgBrush" Color="#3C3F41"/>
    <SolidColorBrush x:Key="PanelBgBrush" Color="#2B2B2B"/>
    <SolidColorBrush x:Key="NavBgBrush" Color="#3C3F41"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#A9B7C6"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#808080"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#555555"/>
    <SolidColorBrush x:Key="TitleBrush" Color="#4A88C7"/>
    <SolidColorBrush x:Key="BackgroundBrush" Color="#3C3F41"/>
    <SolidColorBrush x:Key="RegionBrush" Color="#2B2B2B"/>
    <SolidColorBrush x:Key="SecondaryRegionBrush" Color="#3C3F41"/>
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#A9B7C6"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#808080"/>

    <SolidColorBrush x:Key="ButtonBgBrush" Color="#4C5052"/>
    <SolidColorBrush x:Key="ButtonFgBrush" Color="#A9B7C6"/>
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#646464"/>
    <SolidColorBrush x:Key="ButtonHoverBrush" Color="#585C5E"/>
    <SolidColorBrush x:Key="ButtonPressedBrush" Color="#404244"/>
    <SolidColorBrush x:Key="PrimaryButtonFgBrush" Color="#FFFFFF"/>

    <SolidColorBrush x:Key="NavHoverBrush" Color="#4C5052"/>
    <SolidColorBrush x:Key="NavSelectedBrush" Color="#4B6EAF"/>
    <SolidColorBrush x:Key="NavSelectedFgBrush" Color="#FFFFFF"/>

    <SolidColorBrush x:Key="EditorBackgroundBrush" Color="#2B2B2B"/>
    <SolidColorBrush x:Key="EditorForegroundBrush" Color="#A9B7C6"/>
    <SolidColorBrush x:Key="EditorLineNumberBrush" Color="#606366"/>
    <SolidColorBrush x:Key="NotesLineNumberBrush" Color="#7A9EAA"/>
    <SolidColorBrush x:Key="NotesLineNumberBgBrush" Color="#23262B"/>
    <SolidColorBrush x:Key="EditorCurrentLineBrush" Color="#323232"/>
    <SolidColorBrush x:Key="EditorCurrentLineBorderBrush" Color="#3C3C3C"/>
    <SolidColorBrush x:Key="EditorSelectionBrush" Color="#214283"/>
    <SolidColorBrush x:Key="EditorBorderBrush" Color="#555555"/>
    <SolidColorBrush x:Key="BracketHighlightBrush" Color="#3C5E86"/>

    <SolidColorBrush x:Key="DiffDeleteBrush" Color="#5A2D2D"/>
    <SolidColorBrush x:Key="DiffInsertBrush" Color="#2A4A32"/>
    <SolidColorBrush x:Key="DiffModifyBrush" Color="#4A4326"/>
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="#99FFFFFF"/>

    <!-- 覆盖 WPF 默认模板里的 SystemColors（TreeViewItem / DataGrid / 菜单 / 提示仍走这些键） -->
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#A9B7C6"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#A9B7C6"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="#808080"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#3C3F41"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#2B2B2B"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlLightBrushKey}" Color="#555555"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlDarkBrushKey}" Color="#555555"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlLightLightBrushKey}" Color="#646464"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlDarkDarkBrushKey}" Color="#3C3F41"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#4B6EAF"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#4C5052"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#A9B7C6"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}" Color="#2B2B2B"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuBarBrushKey}" Color="#3C3F41"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}" Color="#A9B7C6"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InfoBrushKey}" Color="#2B2B2B"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InfoTextBrushKey}" Color="#A9B7C6"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowFrameBrushKey}" Color="#555555"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ActiveBorderBrushKey}" Color="#555555"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveBorderBrushKey}" Color="#555555"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ActiveCaptionBrushKey}" Color="#3C3F41"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ActiveCaptionTextBrushKey}" Color="#A9B7C6"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveCaptionBrushKey}" Color="#3C3F41"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveCaptionTextBrushKey}" Color="#808080"/>
</ResourceDictionary>
