<UserControl x:Class="IntraBox.Modules.TextStats.TextStatsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:IntraBox.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <WrapPanel Margin="0,0,0,8">
            <Button Content="统计" Style="{StaticResource PrimaryButton}" Margin="0,4,8,4" Click="Run_Click"/>
            <Button Content="复制结果" Margin="0,4,8,4" Click="Copy_Click"/>
            <TextBlock Text="词频 Top" VerticalAlignment="Center" Margin="8,4,4,4" Foreground="{DynamicResource TextSecondaryBrush}"/>
            <TextBox x:Name="TopBox" Width="48" Text="20" Margin="0,4,8,4"/>
            <TextBlock x:Name="MsgText" VerticalAlignment="Center" Margin="8,4,0,4"
                       Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
        </WrapPanel>
        <controls:CodeEditor x:Name="InputBox" Grid.Row="1"/>
        <TextBlock Grid.Row="2" Text="结果" Margin="0,8,0,4" Foreground="{DynamicResource TextSecondaryBrush}"/>
        <controls:CodeEditor x:Name="OutputBox" Grid.Row="3" IsReadOnly="True" CanMaximize="True"/>
    </Grid>
</UserControl>
