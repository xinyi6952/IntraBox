<UserControl x:Class="IntraBox.Modules.Base64.Base64View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:IntraBox.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="3*"/>
        </Grid.RowDefinitions>

        <WrapPanel x:Name="ToolbarPanel" Grid.Row="0" Margin="0,0,0,8">
            <Button Content="文本 → Base64" Style="{StaticResource PrimaryButton}" Margin="0,4,8,4" Click="EncodeBtn_Click"/>
            <Button Content="Base64 → 文本" Margin="0,4,8,4" Click="DecodeBtn_Click"/>
            <Button Content="文件 → Base64" Margin="0,4,8,4" Click="FileToBase64_Click"/>
            <Button Content="Base64 → 文件" Margin="0,4,8,4" Click="Base64ToFile_Click"/>
            <TextBlock x:Name="MsgText" VerticalAlignment="Center" Margin="8,4,0,4"
                       Foreground="{DynamicResource OkBrush}" TextWrapping="Wrap"/>
        </WrapPanel>

        <TextBlock x:Name="InputCaption" Grid.Row="1" Text="输入（文本或 Base64 字符串）" Margin="0,0,0,4"
                   Foreground="{DynamicResource TextSecondaryBrush}"/>
        <controls:CodeEditor x:Name="InputBox" Grid.Row="2"/>

        <TextBlock x:Name="OutputCaption" Grid.Row="3" Text="输出" Margin="0,8,0,4" Foreground="{DynamicResource TextSecondaryBrush}"/>
        <controls:CodeEditor x:Name="OutputBox" Grid.Row="4" IsReadOnly="True" CanMaximize="True"/>
    </Grid>
</UserControl>
