<UserControl x:Class="IntraBox.Modules.DirSize.DirSizeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:IntraBox.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   Text="先看各盘占用，再选目录分析。结果是树形表格，展开文件夹继续往下看。只汇总体积与文件数，不删除。符号链接不跟随。"/>
        <DataGrid x:Name="DriveGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" HeadersVisibility="Column" BorderThickness="1"
                  Height="132" Margin="0,0,0,8" MouseDoubleClick="DriveGrid_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="盘符" Binding="{Binding Name}" Width="70"/>
                <DataGridTextColumn Header="卷标" Binding="{Binding Label}" Width="120"/>
                <DataGridTextColumn Header="文件系统" Binding="{Binding Format}" Width="90"/>
                <DataGridTextColumn Header="已用" Binding="{Binding UsedText}" Width="90"/>
                <DataGridTextColumn Header="剩余" Binding="{Binding FreeText}" Width="90"/>
                <DataGridTextColumn Header="总计" Binding="{Binding TotalText}" Width="90"/>
                <DataGridTextColumn Header="占用" Binding="{Binding PercentText}" Width="70"/>
                <DataGridTextColumn Header="备注" Binding="{Binding Note}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
        <WrapPanel Grid.Row="2" Margin="0,0,0,8">
            <controls:RequiredLabel Text="目录" VerticalAlignment="Center" Margin="0,4,8,4"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
            <TextBox x:Name="DirBox" Width="360" Margin="0,4,8,4"/>
            <Button Content="浏览…" Click="Browse_Click" Margin="0,4,8,4"/>
            <Button Content="分析" Style="{StaticResource PrimaryButton}" Click="Scan_Click" Margin="0,4,8,4"/>
            <Button Content="上级" Click="Up_Click" Margin="0,4,8,4"/>
            <Button Content="定位" Click="Locate_Click" Margin="0,4,8,4"/>
            <Button Content="复制路径" Click="Copy_Click" Margin="0,4,8,4"/>
            <controls:GridFilterBar x:Name="FilterBar" VerticalAlignment="Center" Margin="8,4,0,4"/>
        </WrapPanel>
        <DataGrid x:Name="ResultGrid" Grid.Row="3" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="All"
                  SelectionMode="Single" SelectionUnit="FullRow" BorderThickness="1"
                  MouseDoubleClick="ResultGrid_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="名称" Width="260">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid Margin="{Binding Indent}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="18"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Width="18" Height="18" MinWidth="18" MinHeight="18" Padding="0"
                                        FontSize="11" PreviewMouseLeftButtonDown="Expand_Click"
                                        Visibility="{Binding ExpanderVisibility}"
                                        Content="{Binding ExpanderGlyph}" ToolTip="展开/折叠"/>
                                <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="4,0,0,0"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Name}"/>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="类型" Binding="{Binding KindText}" Width="72"/>
                <DataGridTextColumn Header="大小" Binding="{Binding SizeText}" Width="110"/>
                <DataGridTextColumn Header="占用" Binding="{Binding PercentText}" Width="72"/>
                <DataGridTextColumn Header="文件数" Binding="{Binding FileCountText}" Width="90"/>
            </DataGrid.Columns>
        </DataGrid>
        <TextBlock x:Name="MsgText" Grid.Row="4" Margin="0,8,0,0" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextSecondaryBrush}"/>
    </Grid>
</UserControl>
