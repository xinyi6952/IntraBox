<UserControl x:Class="IntraBox.Modules.Timestamp.TimestampView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:IntraBox.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <WrapPanel x:Name="ToolbarPanel" Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="单位" VerticalAlignment="Center" Margin="0,4,8,4"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
            <ComboBox x:Name="UnitCombo" MinWidth="80" Margin="0,4,12,4" SelectedIndex="0">
                <ComboBoxItem Content="秒"/>
                <ComboBoxItem Content="毫秒"/>
            </ComboBox>
            <Button Content="时间戳 → 时间" Style="{StaticResource PrimaryButton}" Margin="0,4,8,4" Click="TsToTime_Click"/>
            <Button Content="时间 → 时间戳" Margin="0,4,8,4" Click="TimeToTs_Click"/>
            <Button Content="填入当前时间" Margin="0,4,8,4" Click="FillNow_Click"/>
            <TextBlock x:Name="MsgText" VerticalAlignment="Center" Margin="8,4,0,4"
                       Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap"/>
        </WrapPanel>

        <TextBlock x:Name="InputCaption" Grid.Row="1" Text="输入值" Margin="0,0,0,4" Foreground="{DynamicResource TextSecondaryBrush}"/>
        <controls:CodeEditor x:Name="InputBox" Grid.Row="2"/>

        <TextBlock x:Name="OutputCaption" Grid.Row="3" Text="结果" Margin="0,10,0,4" Foreground="{DynamicResource TextSecondaryBrush}"/>
        <controls:CodeEditor x:Name="OutputBox" Grid.Row="4" IsReadOnly="True" CanMaximize="True"/>
    </Grid>
</UserControl>
