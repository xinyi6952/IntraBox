<UserControl x:Class="IntraBox.Modules.FileLock.FileLockView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:IntraBox.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                   Foreground="{DynamicResource WarningBrush}"
                   Text="结束占用进程可能中断正在运行的程序或安全软件；部分进程需要管理员权限。请确认目标后再操作。"/>
        <WrapPanel Grid.Row="1" Margin="0,0,0,8">
            <Button Content="选择文件" Style="{StaticResource PrimaryButton}" Margin="0,4,8,4" Click="Pick_Click"/>
            <Button Content="刷新" Margin="0,4,8,4" Click="Refresh_Click"/>
            <Button Content="结束进程" Margin="0,4,8,4" Click="Kill_Click"/>
            <controls:GridFilterBar x:Name="FilterBar" VerticalAlignment="Center" Margin="8,4,0,4"/>
            <TextBlock x:Name="MsgText" VerticalAlignment="Center" Margin="8,4,0,4"
                       Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
        </WrapPanel>
        <TextBlock x:Name="PathText" Grid.Row="2" Margin="0,0,0,6" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextSecondaryBrush}"/>
        <DataGrid x:Name="ProcGrid" Grid.Row="3" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="80"/>
                <DataGridTextColumn Header="进程名" Binding="{Binding Name}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
