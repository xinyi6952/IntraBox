<UserControl x:Class="IntraBox.Modules.Settings.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:IntraBox.Core">
    <UserControl.Resources>
        <Style x:Key="SortMoveBtn" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinWidth" Value="44"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="4">
            <StackPanel MaxWidth="760" HorizontalAlignment="Left">
                <TextBlock Text="设置" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>

                <TextBlock Text="外观" FontWeight="SemiBold" Margin="0,0,0,6"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="选择浅色、深色，或跟随系统（Windows 10+；Windows 7 跟随系统时使用深色）。切换立即生效并记住。"/>
                <ComboBox x:Name="ThemeCombo" Width="220" HorizontalAlignment="Left" Margin="0,0,0,20"
                          SelectionChanged="ThemeCombo_SelectionChanged">
                    <ComboBoxItem Content="浅色"/>
                    <ComboBoxItem Content="深色"/>
                    <ComboBoxItem Content="跟随系统"/>
                </ComboBox>

                <TextBlock Text="状态记忆写入延迟" FontWeight="SemiBold" Margin="0,0,0,6"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock TextWrapping="Wrap" Margin="0,0,0,10"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="所有工具切换后记住的输入，以及桌面整理规则，写入磁盘前的等待时间。到期后在后台线程序列化并写盘，不占用界面。缩短更及时，拉长可减少连续操作时的磁盘写入。范围 300–1000 毫秒。"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                    <Slider x:Name="HistoryDelaySlider" Width="280"
                            Minimum="300" Maximum="1000" TickFrequency="50"
                            IsSnapToTickEnabled="True" VerticalAlignment="Center"
                            ValueChanged="HistoryDelaySlider_ValueChanged"/>
                    <TextBlock x:Name="HistoryDelayLabel" Margin="12,0,0,0" VerticalAlignment="Center"
                               FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                </StackPanel>

                <TextBlock Text="文件大小上限" FontWeight="SemiBold" Margin="0,0,0,6"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock TextWrapping="Wrap" Margin="0,0,0,10"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="打开、导入文件时的体积上限。默认 10 MB，最高 200 MB。粘贴超大文本、剪贴板图片同样受此限制。上限越高，通过检查的文件占用内存越多（文本大约再乘约 2 倍）；超过上限的文件只看磁盘大小，不会读进内存。建议保持默认，除非确实要处理更大文件。"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Slider x:Name="SizeSlider" Width="280" Minimum="1" Maximum="200" TickFrequency="1"
                            IsSnapToTickEnabled="True" VerticalAlignment="Center"
                            ValueChanged="SizeSlider_ValueChanged"/>
                    <TextBlock x:Name="SizeLabel" Margin="12,0,0,0" VerticalAlignment="Center"
                               FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                </StackPanel>
                <TextBlock x:Name="HardCapHint" Margin="0,0,0,16" FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>

                <TextBlock Text="剪贴板历史条数" FontWeight="SemiBold" Margin="0,0,0,6"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock TextWrapping="Wrap" Margin="0,0,0,10"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="默认 20 条，最多 200。下调上限时优先丢掉未固定的旧记录。"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Slider x:Name="ClipSlider" Width="280" Minimum="1" Maximum="200" TickFrequency="1"
                            IsSnapToTickEnabled="True" VerticalAlignment="Center"
                            ValueChanged="ClipSlider_ValueChanged"/>
                    <TextBlock x:Name="ClipLabel" Margin="12,0,0,0" VerticalAlignment="Center"
                               FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                </StackPanel>
                <TextBlock Text="剪贴板图片条数" FontWeight="SemiBold" Margin="0,8,0,6"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock TextWrapping="Wrap" Margin="0,0,0,10"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="勾选「记录剪切图片」后生效。默认 20 张，最多 50，且不超过上面的总条数。下调时只丢掉未固定的旧图片，写回仍是原图。"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Slider x:Name="ClipImageSlider" Width="280" Minimum="1" Maximum="50" TickFrequency="1"
                            IsSnapToTickEnabled="True" VerticalAlignment="Center"
                            ValueChanged="ClipImageSlider_ValueChanged"/>
                    <TextBlock x:Name="ClipImageLabel" Margin="12,0,0,0" VerticalAlignment="Center"
                               FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                </StackPanel>
                <CheckBox x:Name="VaultClipCheck" Margin="0,0,0,16"
                          Content="账号备忘复制的内容写入剪贴板历史"
                          Checked="VaultClip_Changed" Unchecked="VaultClip_Changed"/>

                <TextBlock Text="内存压缩" FontWeight="SemiBold" Margin="0,0,0,6"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock TextWrapping="Wrap" Margin="0,0,0,10"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="藏到托盘时立即压缩工作集。空闲超时后，无未保存内容则卸载当前工具（再打开从状态记忆恢复）；有未保存则只压工作集、卸预览文档。工作集达到高水位且已在托盘时再回收，落到低水位则停止。不会弹内存告警。切换轻工具不压工作集，避免导航抖动。"/>
                <CheckBox x:Name="RestoreLastCheck" Margin="0,0,0,8"
                          Content="启动时打开上次使用的工具"
                          Checked="MemOpt_Changed" Unchecked="MemOpt_Changed"/>
                <CheckBox x:Name="TrayUnloadCheck" Margin="0,0,0,8"
                          Content="托盘空闲后释放当前工具（无未保存时）"
                          Checked="MemOpt_Changed" Unchecked="MemOpt_Changed"/>
                <CheckBox x:Name="SkipClipImgParkCheck" Margin="0,0,0,12"
                          Content="藏托盘期间不把剪贴板图片记入历史"
                          Checked="MemOpt_Changed" Unchecked="MemOpt_Changed"/>
                <TextBlock Text="托盘空闲多久后再次回收 / 卸载" Margin="0,0,0,6"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <Slider x:Name="TrayIdleSlider" Width="280"
                            Minimum="30" Maximum="600" TickFrequency="30"
                            IsSnapToTickEnabled="True" VerticalAlignment="Center"
                            ValueChanged="TrayIdleSlider_ValueChanged"/>
                    <TextBlock x:Name="TrayIdleLabel" Margin="12,0,0,0" VerticalAlignment="Center"
                               FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                </StackPanel>
                <TextBlock Text="工作集高水位（达到后自动回收）" Margin="0,0,0,6"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <Slider x:Name="TrimHighSlider" Width="280"
                            Minimum="{x:Static core:MemoryTrimPolicy.MinHighMb}"
                            Maximum="{x:Static core:MemoryTrimPolicy.MaxHighMb}"
                            TickFrequency="20"
                            IsSnapToTickEnabled="True" VerticalAlignment="Center"
                            ValueChanged="TrimHighSlider_ValueChanged"/>
                    <TextBlock x:Name="TrimHighLabel" Margin="12,0,0,0" VerticalAlignment="Center"
                               FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                </StackPanel>
                <TextBlock Text="工作集低水位（低于此不再按阈值回收）" Margin="0,0,0,6"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                    <Slider x:Name="TrimLowSlider" Width="280"
                            Minimum="{x:Static core:MemoryTrimPolicy.MinLowMb}"
                            Maximum="{x:Static core:MemoryTrimPolicy.MaxLowMb}"
                            TickFrequency="20"
                            IsSnapToTickEnabled="True" VerticalAlignment="Center"
                            ValueChanged="TrimLowSlider_ValueChanged"/>
                    <TextBlock x:Name="TrimLowLabel" Margin="12,0,0,0" VerticalAlignment="Center"
                               FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                </StackPanel>

                <TextBlock Text="截屏快捷键" FontWeight="SemiBold" Margin="0,0,0,6"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="点击输入框后按下组合键（需包含 Ctrl 或 Alt）。托盘隐藏时仍然有效。"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <TextBox x:Name="HotkeyBox" Width="200" IsReadOnly="True"
                             ToolTip="点击后按下新的快捷键"
                             PreviewKeyDown="HotkeyBox_PreviewKeyDown"/>
                    <Button Content="恢复默认" Margin="8,0,0,0" Click="HotkeyReset_Click"/>
                </StackPanel>

                <TextBlock Text="启动器快捷键" FontWeight="SemiBold" Margin="0,0,0,6"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="呼出启动器浮层。默认 Ctrl+Alt+L。须包含 Ctrl 或 Alt。托盘隐藏时仍然有效。"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <TextBox x:Name="LauncherHotkeyBox" Width="200" IsReadOnly="True"
                             ToolTip="点击后按下新的快捷键"
                             PreviewKeyDown="LauncherHotkeyBox_PreviewKeyDown"/>
                    <Button Content="恢复默认" Margin="8,0,0,0" Click="LauncherHotkeyReset_Click"/>
                </StackPanel>

                <TextBlock Text="数据目录" FontWeight="SemiBold" Margin="0,0,0,6"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="配置、历史、待办等个人数据默认在本机 %LOCALAPPDATA%\IntraBox\Data。换免安装包只需覆盖程序文件夹。不建议放到程序目录内。"/>
                <TextBox x:Name="DataDirBox" IsReadOnly="True" TextWrapping="Wrap" Margin="0,0,0,8"
                         Foreground="{DynamicResource TextPrimaryBrush}"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                    <Button Content="打开文件夹" Click="DataDirOpen_Click" Margin="0,0,8,0"/>
                    <Button Content="更改目录…" Click="DataDirChange_Click" Margin="0,0,8,0"/>
                    <Button Content="恢复默认" Click="DataDirReset_Click"/>
                </StackPanel>

                <TextBlock Text="工具显隐" FontWeight="SemiBold" Margin="0,0,0,6"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="勾选的工具出现在左侧导航。设置始终固定在底部。至少保留一个工具。"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Content="全部显示" Click="ToolVisAllOn_Click" Margin="0,0,8,0"/>
                    <Button Content="全部隐藏" Click="ToolVisAllOff_Click" Margin="0,0,8,0"/>
                    <Button x:Name="NavSortToggleBtn" Content="调整顺序" Click="NavSortToggle_Click"/>
                </StackPanel>
                <ItemsControl x:Name="ToolVisGroups" Margin="0,0,0,16">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Text="{Binding Category}" FontWeight="SemiBold" Margin="0,0,0,6"
                                           Foreground="{DynamicResource AccentBrush}"/>
                                <ItemsControl ItemsSource="{Binding Items}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="4"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding DisplayName}" IsChecked="{Binding IsVisible, Mode=TwoWay}"
                                                      Margin="0,2,8,6" ToolTip="{Binding DisplayName}"
                                                      Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel x:Name="NavSortPanel" Visibility="Collapsed" Margin="0,0,0,16">
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="表格中分类、工具均可置顶/上移/下移/置底。工具缩进显示，只能在本分类内移动。设置始终固定在导航底部。"/>
                    <Button Content="恢复默认排序" HorizontalAlignment="Left" Margin="0,0,0,8"
                            Click="NavSortReset_Click"/>
                    <DataGrid x:Name="NavSortGrid" MinHeight="280" MaxHeight="480"
                              AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="False"
                              CanUserSortColumns="False" CanUserResizeRows="False"
                              HeadersVisibility="Column" SelectionMode="Single" SelectionUnit="FullRow"
                              EnableRowVirtualization="False" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="名称" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Title}" Margin="{Binding IndentMargin}"
                                                   VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="FontWeight" Value="Normal"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCategory}" Value="True">
                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="类型" Binding="{Binding KindText}" Width="56" IsReadOnly="True"/>
                            <DataGridTemplateColumn Header="操作" Width="240">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Content="置顶" Style="{StaticResource SortMoveBtn}"
                                                    Click="NavTreeTop_Click" Tag="{Binding}"/>
                                            <Button Content="上移" Style="{StaticResource SortMoveBtn}"
                                                    Click="NavTreeUp_Click" Tag="{Binding}"/>
                                            <Button Content="下移" Style="{StaticResource SortMoveBtn}"
                                                    Click="NavTreeDown_Click" Tag="{Binding}"/>
                                            <Button Content="置底" Style="{StaticResource SortMoveBtn}"
                                                    Click="NavTreeBottom_Click" Tag="{Binding}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- 固定底栏：保存按钮始终可见，无需滚到最底 -->
        <Border Grid.Row="1" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                Background="{DynamicResource PanelBgBrush}" Padding="8,8,8,8">
            <StackPanel Orientation="Horizontal">
                <Button Content="保存设置" Style="{StaticResource PrimaryButton}"
                        Click="Save_Click" Margin="0,0,8,0"/>
                <Button Content="再次显示欢迎引导" Click="Welcome_Click" Margin="0,0,8,0"/>
                <Button Content="关闭时再次询问" Click="ClosePromptReset_Click" Margin="0,0,12,0"
                        ToolTip="清除「不再提醒」，下次点关闭会再弹出最小化到托盘/退出选择"/>
                <TextBlock x:Name="MsgText" TextWrapping="Wrap" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
