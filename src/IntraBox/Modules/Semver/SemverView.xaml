<UserControl x:Class="IntraBox.Modules.Semver.SemverView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <WrapPanel Margin="0,0,0,8">
            <TextBlock Text="版本 A" VerticalAlignment="Center" Margin="0,4,8,4" Foreground="{DynamicResource TextSecondaryBrush}"/>
            <TextBox x:Name="ABox" Width="140" Margin="0,4,12,4"/>
            <ComboBox x:Name="OpCombo" Width="70" Margin="0,4,12,4" SelectedIndex="0">
                <ComboBoxItem Content=">"/>
                <ComboBoxItem Content="&lt;"/>
                <ComboBoxItem Content="="/>
                <ComboBoxItem Content=">="/>
                <ComboBoxItem Content="&lt;="/>
            </ComboBox>
            <TextBlock Text="版本 B" VerticalAlignment="Center" Margin="0,4,8,4" Foreground="{DynamicResource TextSecondaryBrush}"/>
            <TextBox x:Name="BBox" Width="140" Margin="0,4,12,4"/>
            <Button Content="比较" Style="{StaticResource PrimaryButton}" Margin="0,4,8,4" Click="Cmp_Click"/>
        </WrapPanel>
        <WrapPanel Margin="0,0,0,8">
            <TextBlock Text="版本" VerticalAlignment="Center" Margin="0,4,8,4" Foreground="{DynamicResource TextSecondaryBrush}"/>
            <TextBox x:Name="VBox" Width="140" Margin="0,4,12,4"/>
            <TextBlock Text="范围" VerticalAlignment="Center" Margin="0,4,8,4" Foreground="{DynamicResource TextSecondaryBrush}"/>
            <TextBox x:Name="RangeBox" Width="140" Margin="0,4,12,4" Text="^1.2.0"/>
            <Button Content="是否满足范围" Margin="0,4,8,4" Click="Range_Click"/>
        </WrapPanel>
        <TextBlock x:Name="ResultText" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextPrimaryBrush}"/>
        <TextBlock x:Name="MsgText" Margin="0,8,0,0" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
    </StackPanel>
</UserControl>
