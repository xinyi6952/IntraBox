<UserControl x:Class="IntraBox.Modules.JsonToClass.JsonToClassView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:IntraBox.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <WrapPanel x:Name="ToolbarPanel" Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="语言" VerticalAlignment="Center" Margin="0,4,8,4"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
            <ComboBox x:Name="LangCombo" MinWidth="100" Margin="0,4,12,4" SelectedIndex="0"
                      SelectionChanged="LangCombo_SelectionChanged">
                <ComboBoxItem Content="C#"/>
                <ComboBoxItem Content="Java"/>
            </ComboBox>
            <TextBlock Text="根类名" VerticalAlignment="Center" Margin="0,4,8,4"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
            <TextBox x:Name="RootNameBox" Width="140" Margin="0,4,12,4" Text="Root"/>
            <Button Content="生成" Style="{StaticResource PrimaryButton}" Margin="0,4,8,4" Click="Generate_Click"/>
            <Button Content="复制" Margin="0,4,8,4" Click="Copy_Click"/>
            <TextBlock x:Name="MsgText" VerticalAlignment="Center" Margin="8,4,0,4"
                       Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
        </WrapPanel>

        <TextBlock x:Name="InputCaption" Grid.Row="1" Text="JSON" Margin="0,0,0,4"
                   Foreground="{DynamicResource TextSecondaryBrush}"/>
        <controls:CodeEditor x:Name="InputBox" Grid.Row="2"/>

        <TextBlock x:Name="OutputCaption" Grid.Row="3" Text="生成的类" Margin="0,8,0,4"
                   Foreground="{DynamicResource TextSecondaryBrush}"/>
        <controls:CodeEditor x:Name="OutputBox" Grid.Row="4" IsReadOnly="True" CanMaximize="True"/>
    </Grid>
</UserControl>
