<UserControl x:Class="IntraBox.Modules.Notes.NotesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:notes="clr-namespace:IntraBox.Modules.Notes">
    <UserControl.Resources>
        <Style x:Key="NoteCellText" TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>
    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <WrapPanel Grid.Row="0" Margin="0,0,0,8">
            <Button x:Name="NewBtn" Content="新增" Style="{StaticResource PrimaryButton}" Margin="0,4,8,4" Click="NewBtn_Click">
                <Button.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="普通笔记" Click="NewRich_Click" Style="{StaticResource ContextMenuItemStyle}">
                            <MenuItem.Icon>
                                <Path Style="{StaticResource MenuIconPath}" Data="M4,2 L12,2 12,14 4,14 Z M6,5 L10,5 M6,8 L10,8 M6,11 L9,11"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Markdown" Click="NewMd_Click" Style="{StaticResource ContextMenuItemStyle}">
                            <MenuItem.Icon>
                                <Path Style="{StaticResource MenuIconPath}" Data="M3,12 L3,4 L6,8 L9,4 L9,12 M11,4 L13,4 13,12"/>
                            </MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>
            <TextBox x:Name="SearchBox" Width="200" MinHeight="32" Margin="0,4,8,4"
                     TextChanged="Search_Changed"/>
            <ComboBox x:Name="KindCombo" Width="120" MinHeight="32" Margin="0,4,8,4"
                      SelectedIndex="0" SelectionChanged="Kind_Changed">
                <ComboBoxItem Content="全部"/>
                <ComboBoxItem Content="普通"/>
                <ComboBoxItem Content="Markdown"/>
            </ComboBox>
            <TextBlock x:Name="MsgText" VerticalAlignment="Center" Margin="8,4,0,4"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
        </WrapPanel>
        <Grid Grid.Row="1">
            <ListView x:Name="NoteList" BorderThickness="1"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      SizeChanged="NoteList_SizeChanged"
                      GridViewColumnHeader.Click="Header_Click"
                      MouseLeftButtonUp="NoteList_MouseLeftButtonUp"
                      MouseDoubleClick="NoteList_MouseDoubleClick">
                <ListView.ContextMenu>
                    <ContextMenu Opened="ListMenu_Opened" Closed="ListMenu_Closed">
                        <MenuItem Header="编辑" Click="MenuEdit_Click" Style="{StaticResource ContextMenuItemStyle}">
                            <MenuItem.Icon>
                                <Path Style="{StaticResource MenuIconPath}" Data="M3,13 L5,15 13,7 11,5 Z M12,4 L14,6"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="置顶" Click="MenuPin_Click" Style="{StaticResource ContextMenuItemStyle}">
                            <MenuItem.Icon>
                                <Path Style="{StaticResource MenuIconPath}" Data="M8,2 L8,10 M5,6 L8,2 11,6"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="取消置顶" Click="MenuUnpin_Click" Style="{StaticResource ContextMenuItemStyle}">
                            <MenuItem.Icon>
                                <Path Style="{StaticResource MenuIconPath}" Data="M8,2 L8,10 M5,6 L8,10 11,6"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="复制" Click="MenuDup_Click" Style="{StaticResource ContextMenuItemStyle}">
                            <MenuItem.Icon>
                                <Path Style="{StaticResource MenuIconPath}" Data="M5,3 L11,3 11,11 5,11 Z M3,5 L3,13 9,13"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="导出" Click="MenuExport_Click" Style="{StaticResource ContextMenuItemStyle}">
                            <MenuItem.Icon>
                                <Path Style="{StaticResource MenuIconPath}" Data="M8,2 L8,10 M5,7 L8,10 11,7 M3,13 L13,13"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="删除" Click="MenuDelete_Click" Style="{StaticResource ContextMenuItemStyle}">
                            <MenuItem.Icon>
                                <Path Style="{StaticResource MenuIconPath}" Data="M4,4 L12,12 M12,4 L4,12"/>
                            </MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </ListView.ContextMenu>
                <ListView.View>
                    <GridView AllowsColumnReorder="False">
                        <GridViewColumn Header="置顶" Width="56">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding PinText}" Style="{StaticResource NoteCellText}"
                                               Foreground="{DynamicResource AccentBrush}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="类型" Width="88">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding KindText}" Style="{StaticResource NoteCellText}"
                                               ToolTip="{Binding KindText}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="标题" Width="220">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource NoteCellText}"
                                               ToolTip="{Binding Title}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="创建时间" Width="140">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding CreatedText}" Style="{StaticResource NoteCellText}"
                                               ToolTip="{Binding CreatedText}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="修改时间" Width="140">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding UpdatedText}" Style="{StaticResource NoteCellText}"
                                               ToolTip="{Binding UpdatedText}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
            </Grid>

            <Grid x:Name="DrawerHost" Grid.Row="0" Grid.RowSpan="2" Panel.ZIndex="10" Visibility="Collapsed">
                <Border x:Name="DrawerMask" Background="#99000000" MouseLeftButtonDown="DrawerMask_Click"/>
                <Border x:Name="DrawerPanel" HorizontalAlignment="Right"
                        Background="{DynamicResource PanelBgBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" Margin="16,12">
                            <Button DockPanel.Dock="Right" Content="×" Width="32" Height="32" MinWidth="32"
                                    Padding="0" Click="DrawerClose_Click" ToolTip="关闭"/>
                            <Button x:Name="DrawerMaxBtn" DockPanel.Dock="Right" Width="32" Height="32"
                                    MinWidth="32" Padding="0" Margin="0,0,4,0"
                                    Click="DrawerMax_Click" ToolTip="还原">
                                <Grid Width="12" Height="12">
                                    <Path x:Name="IconExpand" Visibility="Collapsed"
                                          Stroke="{DynamicResource TextSecondaryBrush}"
                                          StrokeThickness="1.5" StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          Data="M2,10 L10,2 M5,2 L10,2 L10,7"/>
                                    <Path x:Name="IconRestore"
                                          Stroke="{DynamicResource TextSecondaryBrush}"
                                          StrokeThickness="1.5" StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          Data="M10,2 L2,10 M2,5 L2,10 L7,10"/>
                                </Grid>
                            </Button>
                            <TextBlock x:Name="DrawerTitle" Text="笔记" FontSize="16" FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </DockPanel>
                        <notes:NoteEditorPanel x:Name="DrawerEditor" Grid.Row="1" Margin="16,0,8,16"/>
                    </Grid>
                </Border>
            </Grid>
    </Grid>
</UserControl>
