<Window x:Class="IntraBox.Modules.Todo.TodoImagePreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="查看图片" Width="860" Height="640"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False" Topmost="True"
        Background="{DynamicResource WindowBgBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewMouseWheel="Window_PreviewMouseWheel">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <DockPanel Margin="16,12,16,8">
            <Button DockPanel.Dock="Right" Content="关闭" MinWidth="72"
                    Style="{StaticResource PrimaryButton}" IsCancel="True" Click="Close_Click"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,12,0">
                <Button Content="缩小" MinWidth="64" Margin="0,0,8,0" Click="ZoomOut_Click"/>
                <Button Content="放大" MinWidth="64" Margin="0,0,8,0" Click="ZoomIn_Click"/>
                <Button Content="适应窗口" MinWidth="88" Margin="0,0,8,0" Click="ZoomFit_Click"/>
                <Button Content="1:1" MinWidth="52" Click="ZoomActual_Click"/>
            </StackPanel>
            <TextBlock x:Name="TitleText" FontWeight="SemiBold" FontSize="15"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       Margin="0,0,16,0"/>
        </DockPanel>
        <Border Grid.Row="1" Margin="16,0,16,16" Background="#FF111111"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <ScrollViewer x:Name="ZoomHost" HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          Padding="8">
                <Image x:Name="PreviewImage" Stretch="None" RenderTransformOrigin="0.5,0.5">
                    <Image.LayoutTransform>
                        <ScaleTransform x:Name="ZoomScale" ScaleX="1" ScaleY="1"/>
                    </Image.LayoutTransform>
                </Image>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
