<UserControl x:Class="IntraBox.Modules.WorkCal.WorkCalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:IntraBox.Controls">
    <UserControl.Resources>
        <Style x:Key="CalDayButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="3"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource ButtonHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource ButtonPressedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="NowStrip" Margin="0,0,0,8" TextWrapping="Wrap"/>

        <Expander x:Name="ToolsExpander" Grid.Row="1" IsExpanded="False" Margin="0,0,0,10"
                  Expanded="ToolsExpander_Changed" Collapsed="ToolsExpander_Changed">
            <Expander.Header>
                <TextBlock Text="时区换算与工作日推算" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
            </Expander.Header>
            <StackPanel Margin="20,8,0,0">
                <WrapPanel Margin="0,0,0,8">
                    <controls:RequiredLabel Text="时间" VerticalAlignment="Center" Margin="0,4,8,4"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBox x:Name="FromTimeBox" Width="160" Margin="0,4,8,4"/>
                    <controls:SearchCombo x:Name="TzFromCombo" Width="260" Margin="0,4,8,4"
                                          ToolTip="输入城市、UTC 或时区名筛选"/>
                    <TextBlock Text="→" VerticalAlignment="Center" Margin="0,4,8,4"/>
                    <controls:SearchCombo x:Name="TzToCombo" Width="260" Margin="0,4,8,4"
                                          ToolTip="输入城市、UTC 或时区名筛选"/>
                    <Button Content="转换" Style="{StaticResource PrimaryButton}" Margin="0,4,8,4" Click="ConvertTz_Click"/>
                    <Button Content="填入当前" Margin="0,4,8,4" Click="FillNow_Click"/>
                    <TextBlock x:Name="TzResult" VerticalAlignment="Center" Margin="8,4,0,4" TextWrapping="Wrap"/>
                </WrapPanel>
                <WrapPanel Margin="0,0,0,8">
                    <controls:RequiredLabel Text="基准日" VerticalAlignment="Center" Margin="0,4,8,4"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <DatePicker x:Name="WorkFromDate" Width="130" Margin="0,4,8,4"/>
                    <controls:RequiredLabel Text="工作日" VerticalAlignment="Center" Margin="0,4,8,4"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBox x:Name="WorkNBox" Width="48" Margin="0,4,8,4" Text="3"/>
                    <Button Content="计算" Margin="0,4,8,4" Click="Workdays_Click"/>
                    <TextBlock x:Name="WorkResult" VerticalAlignment="Center" Margin="8,4,16,4" TextWrapping="Wrap"/>
                </WrapPanel>
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="放假表随 IntraBox 升级内置（国务院通知公布后写入，当前含 2025、2026）。不联网拉取。没有内置的年份按周末休息，可点格子自己标放假/补班，保存在本机。"/>
            </StackPanel>
        </Expander>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>
            <Grid Margin="0,0,12,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,8">
                    <Button DockPanel.Dock="Left" Width="36" Height="32" MinWidth="36" Padding="0"
                            Click="CalPrev_Click" ToolTip="上个月">
                        <Path Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Width="10" Height="16" Stretch="Uniform" Data="M10,1 L2,8 L10,15"/>
                    </Button>
                    <Button DockPanel.Dock="Right" Width="36" Height="32" MinWidth="36" Padding="0"
                            Click="CalNext_Click" ToolTip="下个月">
                        <Path Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Width="10" Height="16" Stretch="Uniform" Data="M2,1 L10,8 L2,15"/>
                    </Button>
                    <TextBlock x:Name="CalTitle" HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontWeight="SemiBold" FontSize="16"/>
                </DockPanel>
                <UniformGrid x:Name="CalGrid" Grid.Row="1" Columns="7" Rows="7" ClipToBounds="False"/>
                <StackPanel Grid.Row="2" Margin="0,8,0,0">
                    <TextBlock x:Name="YearHint" TextWrapping="Wrap" Margin="0,0,0,4"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="周六日日期蓝色。收起换算时：右上角休蓝/班红，日期下方待办点。展开换算时只显示日期。"/>
                </StackPanel>
            </Grid>
            <DockPanel Grid.Column="1">
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <TextBlock x:Name="DayTitle" FontWeight="SemiBold" Margin="0,0,0,8" TextWrapping="Wrap"/>
                    <WrapPanel>
                        <Button Content="标为放假" Margin="0,0,8,8" Click="MarkOff_Click"/>
                        <Button Content="标为补班" Margin="0,0,8,8" Click="MarkWork_Click"/>
                        <Button Content="清除覆盖" Margin="0,0,8,8" Click="MarkClear_Click"/>
                    </WrapPanel>
                    <Button Content="在任务计划中新建" HorizontalAlignment="Left" Margin="0,0,0,8" Click="NewTodo_Click"/>
                    <TextBlock x:Name="DayMsg" TextWrapping="Wrap" Margin="0,0,0,8"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
                <ListView x:Name="DayList" BorderThickness="1" MouseDoubleClick="DayList_MouseDoubleClick">
                    <ListView.View>
                        <GridView AllowsColumnReorder="False">
                            <GridViewColumn Header="待办" Width="160" DisplayMemberBinding="{Binding Title}"/>
                            <GridViewColumn Header="时间" Width="90" DisplayMemberBinding="{Binding DueText}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </DockPanel>
        </Grid>
    </Grid>
</UserControl>
