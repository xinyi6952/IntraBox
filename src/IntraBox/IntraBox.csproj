<?xml version="1.0" encoding="utf-8"?>
<!--
  IntraBox（内聚）项目文件
  目标框架：.NET Framework 4.8 —— 兼容 Windows 7 SP1 及以上，绿色免安装部署。
  界面框架：WPF（经典 csproj 格式，配合 MSBuild 构建）。
-->
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />

  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <ProjectGuid>{7C1E2B3A-4D5E-4F6A-8B9C-0D1E2F3A4B5C}</ProjectGuid>
    <OutputType>WinExe</OutputType>
    <RootNamespace>IntraBox</RootNamespace>
    <AssemblyName>IntraBox</AssemblyName>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <FileAlignment>512</FileAlignment>
    <!-- WPF + C# 项目类型 GUID，触发 WPF XAML 编译目标 -->
    <ProjectTypeGuids>{60dc8134-eba5-43b8-bcc9-bb4bc16c2548};{FAE04EC0-301F-11D3-BF4B-00C04F79EFBC}</ProjectTypeGuids>
    <WarningLevel>4</WarningLevel>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <Deterministic>true</Deterministic>
    <!-- 锁定 C# 7.3，保证与 .NET Framework 4.8 完全兼容 -->
    <LangVersion>7.3</LangVersion>
    <!-- 应用图标：嵌入 exe，作为任务栏/桌面图标 -->
    <ApplicationIcon>app.ico</ApplicationIcon>
    <!-- 固定 64 位：32 位进程 ~2GB 地址空间装不下两个 AvalonEdit 编辑器各持一份大文本 + 格式化副本，
         大文本格式化/比对会 OOM。64 位下地址空间到 ~8TB。Tesseract 已随包带 x64 原生 DLL，其余依赖全托管 AnyCPU。
         代价：不再支持 32 位 Windows（已极少见）。 -->
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
    <Prefer32Bit>false</Prefer32Bit>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
    <Prefer32Bit>false</Prefer32Bit>
  </PropertyGroup>

  <ItemGroup>
    <!-- .NET Framework 基础程序集引用（骨架阶段零第三方依赖） -->
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Data" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Xaml" />
    <Reference Include="System.Xml" />
    <Reference Include="System.Xml.Linq" />
    <Reference Include="WindowsBase" />
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
  </ItemGroup>

  <ItemGroup>
    <!-- 应用程序入口 XAML -->
    <ApplicationDefinition Include="App.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </ApplicationDefinition>
    <!-- 各界面 XAML（新增窗口/控件在此登记） -->
    <Page Include="**\*.xaml" Exclude="App.xaml;obj\**;bin\**">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
    <!-- 所有 .cs 源码自动包含（排除编译产物目录） -->
    <Compile Include="**\*.cs" Exclude="obj\**;bin\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- 图标资源：供 WPF 窗口标题栏使用 -->
    <Resource Include="app.ico" />
  </ItemGroup>

  <PropertyGroup>
    <RestoreProjectStyle>PackageReference</RestoreProjectStyle>
  </PropertyGroup>

  <ItemGroup>
    <!-- 第三方 NuGet 包：JSON 格式化、文本比对、YAML 解析、代码编辑器等使用 -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="DiffPlex" Version="1.9.0" />
    <PackageReference Include="YamlDotNet" Version="13.7.1" />
    <PackageReference Include="AvalonEdit" Version="6.1.3.50" />
    <PackageReference Include="ClosedXML" Version="0.97.0" />
    <PackageReference Include="QRCoder" Version="1.4.3" />
    <PackageReference Include="ZXing.Net" Version="0.16.9" />
    <PackageReference Include="Tesseract" Version="4.1.1" />
    <PackageReference Include="Markdig" Version="0.37.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="tessdata\*.traineddata">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Tesseract 原生运行时（x86/x64 的 leptonica/tesseract41）。
       Tesseract.targets 用 None+PreserveNewest 复制它们，但 rebuild 删除 obj 后
       Restore 走缓存资产、不重新注入这些 None 项，导致原生 DLL 漏拷、OCR 报
       「调用的目标发生了异常」。这里用显式 Content + Link 兜底，保证 Rebuild 也复制。
       注意 NuGetPackageRoot 在某些环境被改写到缓存目录，故直接用用户 packages 目录。 -->
  <PropertyGroup>
    <TesseractPkgDir Condition="Exists('$(UserProfile)\.nuget\packages\tesseract\4.1.1\x64\tesseract41.dll')">$(UserProfile)\.nuget\packages\tesseract\4.1.1</TesseractPkgDir>
    <TesseractPkgDir Condition="'$(TesseractPkgDir)' == '' and Exists('$(NuGetPackageRoot)\tesseract\4.1.1\x64\tesseract41.dll')">$(NuGetPackageRoot)\tesseract\4.1.1</TesseractPkgDir>
  </PropertyGroup>
  <ItemGroup Condition="'$(TesseractPkgDir)' != ''">
    <Content Include="$(TesseractPkgDir)\x86\leptonica-1.80.0.dll">
      <Link>x86\leptonica-1.80.0.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="$(TesseractPkgDir)\x86\tesseract41.dll">
      <Link>x86\tesseract41.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="$(TesseractPkgDir)\x64\leptonica-1.80.0.dll">
      <Link>x64\leptonica-1.80.0.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="$(TesseractPkgDir)\x64\tesseract41.dll">
      <Link>x64\tesseract41.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
