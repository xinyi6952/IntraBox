<UserControl x:Class="IntraBox.Modules.JsonSchema.JsonSchemaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:IntraBox.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="120"/>
        </Grid.RowDefinitions>
        <WrapPanel Margin="0,0,0,8">
            <Button Content="用 Schema 校验 JSON" Style="{StaticResource PrimaryButton}" Margin="0,4,8,4" Click="Validate_Click"/>
            <Button Content="从 JSON 生成 Schema" Margin="0,4,8,4" Click="Infer_Click"/>
            <TextBlock x:Name="MsgText" VerticalAlignment="Center" Margin="8,4,0,4" Foreground="{DynamicResource TextSecondaryBrush}"/>
        </WrapPanel>
        <controls:CodeEditor x:Name="JsonBox" Grid.Row="1"/>
        <controls:CodeEditor x:Name="SchemaBox" Grid.Row="2" Margin="0,8,0,0"/>
        <TextBlock Grid.Row="3" Text="结果" Margin="0,8,0,4" Foreground="{DynamicResource TextSecondaryBrush}"/>
        <controls:CodeEditor x:Name="OutBox" Grid.Row="4" IsReadOnly="True"/>
    </Grid>
</UserControl>
