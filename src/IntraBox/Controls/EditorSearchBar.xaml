<UserControl x:Class="IntraBox.Controls.EditorSearchBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="{DynamicResource PanelBgBrush}"
            BorderBrush="{DynamicResource EditorBorderBrush}" BorderThickness="0,0,0,1"
            Padding="8,5" SnapsToDevicePixels="True">
        <StackPanel Orientation="Horizontal">
            <ComboBox x:Name="SideCombo" MinWidth="80" Margin="0,0,8,0" SelectedIndex="0"
                      Visibility="Collapsed" SelectionChanged="Side_Changed">
                <ComboBoxItem Content="左侧"/>
                <ComboBoxItem Content="右侧"/>
            </ComboBox>
            <TextBlock Text="查找" VerticalAlignment="Center" Margin="0,0,8,0"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
            <TextBox x:Name="SearchBox" Width="240" VerticalAlignment="Center" Margin="0,0,8,0"
                     TextChanged="SearchBox_TextChanged" PreviewKeyDown="SearchBox_PreviewKeyDown"
                     ToolTip="输入要查找的内容，点击「查找」或按 Enter 开始搜索；Enter 下一个 / Shift+Enter 上一个 / Esc 关闭"/>
            <Button x:Name="FindBtn" Content="查找" Margin="0,0,8,0" Padding="10,2"
                    MinWidth="56" MinHeight="26" Click="FindBtn_Click"
                    ToolTip="开始查找（Enter）"/>
            <TextBlock x:Name="CountText" VerticalAlignment="Center" Margin="0,0,8,0" MinWidth="52"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
            <Button x:Name="PrevBtn" Content="↑" ToolTip="上一个 (Shift+Enter)" Margin="0,0,4,0"
                    Padding="8,2" MinWidth="28" MinHeight="26" Click="PrevBtn_Click"/>
            <Button x:Name="NextBtn" Content="↓" ToolTip="下一个 (Enter)" Margin="0,0,8,0"
                    Padding="8,2" MinWidth="28" MinHeight="26" Click="NextBtn_Click"/>
            <CheckBox x:Name="CaseChk" Content="大小写" Margin="0,0,8,0"
                      Checked="Option_Changed" Unchecked="Option_Changed"/>
            <CheckBox x:Name="WordChk" Content="全字" Margin="0,0,8,0"
                      Checked="Option_Changed" Unchecked="Option_Changed"/>
            <CheckBox x:Name="RegexChk" Content="正则" Margin="0,0,8,0"
                      Checked="Option_Changed" Unchecked="Option_Changed"/>
            <Button x:Name="CloseBtn" Content="×" ToolTip="关闭 (Esc)" Margin="4,0,0,0"
                    Padding="8,2" MinWidth="28" MinHeight="26" Click="CloseBtn_Click"/>
        </StackPanel>
    </Border>
</UserControl>
