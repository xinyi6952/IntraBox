<UserControl x:Class="IntraBox.Modules.Timestamp.TimestampView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:IntraBox.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Margin="0,0,0,8" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   Text="粘贴任意常见时间，自动列出可互抄写法；点「值」即可复制。"/>

        <WrapPanel x:Name="ToolbarPanel" Grid.Row="1" Margin="0,0,0,8">
            <Button Content="转换" Style="{StaticResource PrimaryButton}" Margin="0,4,8,4" Click="Convert_Click"/>
            <Button Content="填入当前" Margin="0,4,8,4" Click="FillNow_Click"/>
            <Button Content="复制全部" Margin="0,4,8,4" Click="Copy_Click"/>
            <controls:GridFilterBar x:Name="FilterBar" VerticalAlignment="Center" Margin="8,4,0,4"/>
            <TextBlock x:Name="MsgText" VerticalAlignment="Center" Margin="8,4,0,4"
                       Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
        </WrapPanel>

        <controls:RequiredLabel x:Name="InputCaption" Grid.Row="2" Text="时间" Margin="0,0,0,4"
                   Foreground="{DynamicResource TextSecondaryBrush}"/>
        <controls:CodeEditor x:Name="InputBox" Grid.Row="3"/>
        <DataGrid x:Name="ResultGrid" Grid.Row="4" Margin="0,8,0,0" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" HeadersVisibility="Column" FontSize="13" RowHeight="26"
                  SelectionMode="Single" SelectionUnit="FullRow">
            <DataGrid.Columns>
                <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="110"
                                    ElementStyle="{StaticResource DataGridEllipsisText}"/>
                <DataGridTemplateColumn Header="值" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Background="Transparent" Cursor="Hand"
                                    VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                                    Padding="4,2" ToolTip="点击复制"
                                    PreviewMouseLeftButtonUp="Value_MouseLeftButtonUp">
                                <TextBlock Text="{Binding Value}" FontSize="13"
                                           FontFamily="Consolas, Microsoft YaHei UI, Microsoft YaHei"
                                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                           VerticalAlignment="Center"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
