<UserControl x:Class="IntraBox.Modules.Screenshot.ScreenshotToolbar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="IconToolButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinWidth" Value="32"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="200"/>
        </Style>
        <Style x:Key="ColorDot" TargetType="Button">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="MinWidth" Value="18"/>
            <Setter Property="MinHeight" Value="18"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Width="16" Height="16" CornerRadius="8"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#DDFFFFFF" BorderThickness="1"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="White"/>
                                <Setter TargetName="bd" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Border Background="{DynamicResource PanelBgBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
            CornerRadius="6" Padding="6,4" Cursor="Arrow">
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <Button x:Name="BtnSelect" Style="{StaticResource IconToolButton}" Tag="select"
                        ToolTip="移动/选择" Click="Tool_Click">
                    <Path Width="16" Height="16" Stretch="Uniform"
                          Fill="{DynamicResource TextPrimaryBrush}"
                          Data="M4,3 L4,17 L8,13 L11,20 L13.5,19 L10.5,12 L16,12 Z"/>
                </Button>
                <Button x:Name="BtnRect" Style="{StaticResource IconToolButton}" Tag="rect"
                        ToolTip="矩形" Click="Tool_Click">
                    <Path Width="16" Height="16" Stretch="Uniform" Fill="Transparent"
                          Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.6"
                          Data="M3,5 H21 V19 H3 Z"/>
                </Button>
                <Button x:Name="BtnEllipse" Style="{StaticResource IconToolButton}" Tag="ellipse"
                        ToolTip="圆形" Click="Tool_Click">
                    <Path Width="16" Height="16" Stretch="Uniform" Fill="Transparent"
                          Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.6"
                          Data="M12,4 A8,8 0 1 1 11.99,4 Z"/>
                </Button>
                <Button x:Name="BtnArrow" Style="{StaticResource IconToolButton}" Tag="arrow"
                        ToolTip="箭头" Click="Tool_Click">
                    <Path Width="16" Height="16" Stretch="Uniform" Fill="Transparent"
                          Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.6"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Data="M4,20 L18,6 M12,6 H18 V12"/>
                </Button>
                <Button x:Name="BtnPen" Style="{StaticResource IconToolButton}" Tag="pen"
                        ToolTip="画笔" Click="Tool_Click">
                    <Path Width="16" Height="16" Stretch="Uniform"
                          Fill="{DynamicResource TextPrimaryBrush}"
                          Data="M3,17.25V21h3.75L17.81,9.94l-3.75-3.75L3,17.25z M20.71,7.04c0.39-0.39,0.39-1.02,0-1.41l-2.34-2.34c-0.39-0.39-1.02-0.39-1.41,0l-1.83,1.83l3.75,3.75L20.71,7.04z"/>
                </Button>
                <Button x:Name="BtnText" Style="{StaticResource IconToolButton}" Tag="text"
                        ToolTip="文字" Click="Tool_Click">
                    <Path Width="16" Height="16" Stretch="Uniform"
                          Fill="{DynamicResource TextPrimaryBrush}"
                          Data="M5,4 H19 V7 H13.5 V20 H10.5 V7 H5 Z"/>
                </Button>
                <Button x:Name="BtnMosaic" Style="{StaticResource IconToolButton}" Tag="mosaic"
                        ToolTip="马赛克" Click="Tool_Click">
                    <Path Width="16" Height="16" Stretch="Uniform"
                          Fill="{DynamicResource TextPrimaryBrush}"
                          Data="M3,3 H9 V9 H3 Z M10,3 H16 V9 H10 Z M17,3 H21 V9 H17 Z M3,10 H9 V16 H3 Z M10,10 H16 V16 H10 Z M17,10 H21 V16 H17 Z M3,17 H9 V21 H3 Z M10,17 H16 V21 H10 Z M17,17 H21 V21 H17 Z"/>
                </Button>

                <Rectangle Width="1" Height="20" Fill="{DynamicResource BorderBrush}" Margin="4,0"/>

                <Button Style="{StaticResource IconToolButton}" ToolTip="撤销" Click="Undo_Click">
                    <Path Width="16" Height="16" Stretch="Uniform" Fill="Transparent"
                          Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.6"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Data="M8,8 H5 V5 M5,8 C8,3 16,3 19,8 M19,16 C16,21 8,21 5,16"/>
                </Button>
                <Button Style="{StaticResource IconToolButton}" ToolTip="OCR 识别文字" Click="Ocr_Click">
                    <Path Width="16" Height="16" Stretch="Uniform"
                          Fill="{DynamicResource TextPrimaryBrush}"
                          Data="M4,4 H20 V8 H17 V20 H13 V8 H11 V20 H7 V8 H4 Z"/>
                </Button>
                <Button Style="{StaticResource IconToolButton}" ToolTip="重做" Click="Redo_Click">
                    <Path Width="16" Height="16" Stretch="Uniform" Fill="Transparent"
                          Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.6"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Data="M16,8 H19 V5 M19,8 C16,3 8,3 5,8 M5,16 C8,21 16,21 19,16"/>
                </Button>

                <Rectangle Width="1" Height="20" Fill="{DynamicResource BorderBrush}" Margin="4,0"/>

                <Button Style="{StaticResource IconToolButton}" ToolTip="复制到剪贴板" Click="Copy_Click">
                    <Path Width="16" Height="16" Stretch="Uniform" Fill="Transparent"
                          Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.6"
                          Data="M8,8 H19 V20 H8 Z M5,4 H16 V7"/>
                </Button>
                <Button Style="{StaticResource IconToolButton}" ToolTip="保存到文件" Click="Save_Click">
                    <Path Width="16" Height="16" Stretch="Uniform"
                          Fill="{DynamicResource TextPrimaryBrush}"
                          Data="M4,4 H16 L20,8 V20 H4 Z M8,4 V10 H16 V4 M8,13 H16 V18 H8 Z"/>
                </Button>
                <Button x:Name="BtnPin" Style="{StaticResource IconToolButton}" ToolTip="钉在桌面" Click="Pin_Click">
                    <Path Width="16" Height="16" Stretch="Uniform"
                          Fill="{DynamicResource TextPrimaryBrush}"
                          Data="M14,4 L16,6 L13,9 L17,13 L15,15 L11,11 L8,14 L7,13 L10,10 L6,6 L8,4 Z"/>
                </Button>
                <Button x:Name="BtnUnpin" Style="{StaticResource IconToolButton}" ToolTip="取消钉住" Click="Unpin_Click" Visibility="Collapsed">
                    <Path Width="16" Height="16" Stretch="Uniform" Fill="Transparent"
                          Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.6"
                          Data="M6,6 L18,18 M14,4 L16,6 L13,9 L17,13 L15,15 L11,11 L8,14 L7,13"/>
                </Button>
                <Button Style="{StaticResource PrimaryButton}" Width="32" Height="32" MinWidth="32" MinHeight="32"
                        Padding="0" Margin="2" ToolTip="确认（复制并关闭）" Click="Confirm_Click">
                    <Path Width="14" Height="14" Stretch="Uniform" Fill="White"
                          Data="M5,12 L10,17 L19,6"/>
                </Button>
                <Button Style="{StaticResource IconToolButton}" ToolTip="取消" Click="Cancel_Click">
                    <Path Width="14" Height="14" Stretch="Uniform" Fill="Transparent"
                          Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.8"
                          StrokeStartLineCap="Round" Data="M5,5 L19,19 M19,5 L5,19"/>
                </Button>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="2,6,2,0">
                <TextBlock Text="颜色" VerticalAlignment="Center" Margin="2,0,6,0" FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                <Button Style="{StaticResource ColorDot}" Background="#E53935" Tag="#E53935" ToolTip="红" Click="Color_Click"/>
                <Button Style="{StaticResource ColorDot}" Background="#FB8C00" Tag="#FB8C00" ToolTip="橙" Click="Color_Click"/>
                <Button Style="{StaticResource ColorDot}" Background="#FDD835" Tag="#FDD835" ToolTip="黄" Click="Color_Click"/>
                <Button Style="{StaticResource ColorDot}" Background="#43A047" Tag="#43A047" ToolTip="绿" Click="Color_Click"/>
                <Button Style="{StaticResource ColorDot}" Background="#1E88E5" Tag="#1E88E5" ToolTip="蓝" Click="Color_Click"/>
                <Button Style="{StaticResource ColorDot}" Background="#FFFFFF" Tag="#FFFFFF" ToolTip="白" Click="Color_Click"/>
                <Button Style="{StaticResource ColorDot}" Background="#212121" Tag="#212121" ToolTip="黑" Click="Color_Click"/>
                <TextBlock Text="粗细" VerticalAlignment="Center" Margin="10,0,6,0" FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                <ComboBox x:Name="WidthCombo" Width="72" Height="26" SelectedIndex="0" SelectionChanged="Width_Changed">
                    <ComboBoxItem Content="细" Tag="2"/>
                    <ComboBoxItem Content="中" Tag="4"/>
                    <ComboBoxItem Content="粗" Tag="8"/>
                </ComboBox>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
