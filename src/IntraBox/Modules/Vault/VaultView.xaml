<UserControl x:Class="IntraBox.Modules.Vault.VaultView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vault="clr-namespace:IntraBox.Modules.Vault">
    <UserControl.Resources>
        <Style x:Key="VaultCellText" TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>
    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <WrapPanel Grid.Row="0" Margin="0,0,0,8">
            <Button Content="新增分类" Style="{StaticResource PrimaryButton}" Margin="0,4,8,4" Click="New_Click"/>
            <Button Content="复制全部" Margin="0,4,8,4" Click="CopyAll_Click"/>
            <Button Content="导出" Margin="0,4,8,4" Click="Export_Click"/>
            <Button Content="导入" Margin="0,4,8,4" Click="Import_Click"/>
            <TextBox x:Name="SearchBox" Width="240" MinHeight="32" Margin="0,4,8,4"
                     ToolTip="搜索分类、平台、URL 或账号（不含密码与加密账号）"
                     TextChanged="Search_Changed"/>
            <TextBlock x:Name="MsgText" VerticalAlignment="Center" Margin="8,4,0,4"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
        </WrapPanel>
        <Grid Grid.Row="1">
            <ListView x:Name="VaultList" BorderThickness="1"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      SizeChanged="VaultList_SizeChanged"
                      GridViewColumnHeader.Click="Header_Click"
                      MouseLeftButtonUp="VaultList_MouseLeftButtonUp"
                      MouseDoubleClick="VaultList_MouseDoubleClick">
                <ListView.ContextMenu>
                    <ContextMenu Opened="ListMenu_Opened" Closed="ListMenu_Closed">
                        <MenuItem x:Name="MenuEditItem" Header="编辑" Click="MenuEdit_Click" Style="{StaticResource ContextMenuItemStyle}">
                            <MenuItem.Icon>
                                <Path Style="{StaticResource MenuIconPath}" Data="M3,13 L5,15 13,7 11,5 Z M12,4 L14,6"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="复制全部" Click="MenuCopyAll_Click" Style="{StaticResource ContextMenuItemStyle}">
                            <MenuItem.Icon>
                                <Path Style="{StaticResource MenuIconPath}" Data="M5,3 L11,3 11,11 5,11 Z M3,5 L3,13 9,13"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="导出" Click="MenuExport_Click" Style="{StaticResource ContextMenuItemStyle}">
                            <MenuItem.Icon>
                                <Path Style="{StaticResource MenuIconPath}" Data="M8,2 L8,10 M5,7 L8,10 11,7 M3,13 L13,13"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="导入" Click="MenuImport_Click" Style="{StaticResource ContextMenuItemStyle}">
                            <MenuItem.Icon>
                                <Path Style="{StaticResource MenuIconPath}" Data="M8,14 L8,6 M5,9 L8,6 11,9 M3,3 L13,3"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem x:Name="MenuPinItem" Header="置顶" Click="MenuPin_Click" Style="{StaticResource ContextMenuItemStyle}">
                            <MenuItem.Icon>
                                <Path Style="{StaticResource MenuIconPath}" Data="M8,2 L8,10 M5,6 L8,2 11,6"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem x:Name="MenuUnpinItem" Header="取消置顶" Click="MenuUnpin_Click" Style="{StaticResource ContextMenuItemStyle}">
                            <MenuItem.Icon>
                                <Path Style="{StaticResource MenuIconPath}" Data="M8,2 L8,10 M5,6 L8,10 11,6"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="删除" Click="MenuDelete_Click" Style="{StaticResource ContextMenuItemStyle}">
                            <MenuItem.Icon>
                                <Path Style="{StaticResource MenuIconPath}" Data="M4,4 L12,12 M12,4 L4,12"/>
                            </MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </ListView.ContextMenu>
                <ListView.View>
                    <GridView AllowsColumnReorder="False">
                        <GridViewColumn Header="置顶" Width="56">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding PinText}" Style="{StaticResource VaultCellText}"
                                               Foreground="{DynamicResource AccentBrush}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="分类" Width="220">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource VaultCellText}"
                                               ToolTip="{Binding Title}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="条数" Width="64">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding CountText}" Style="{StaticResource VaultCellText}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="创建时间" Width="140">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding CreatedText}" Style="{StaticResource VaultCellText}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="修改时间" Width="140">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding UpdatedText}" Style="{StaticResource VaultCellText}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </Grid>

        <Grid x:Name="DrawerHost" Grid.Row="0" Grid.RowSpan="2" Panel.ZIndex="10" Visibility="Collapsed">
            <Border x:Name="DrawerMask" Background="#99000000" MouseLeftButtonDown="DrawerMask_Click"/>
            <Border x:Name="DrawerPanel" HorizontalAlignment="Right"
                    Background="{DynamicResource PanelBgBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="16,12">
                        <Button DockPanel.Dock="Right" Content="×" Width="32" Height="32" MinWidth="32"
                                Padding="0" Click="DrawerClose_Click" ToolTip="关闭"/>
                        <Button x:Name="DrawerMaxBtn" DockPanel.Dock="Right" Width="32" Height="32"
                                MinWidth="32" Padding="0" Margin="0,0,4,0"
                                Click="DrawerMax_Click" ToolTip="还原">
                            <Grid Width="12" Height="12">
                                <Path x:Name="IconExpand" Visibility="Collapsed"
                                      Stroke="{DynamicResource TextSecondaryBrush}"
                                      StrokeThickness="1.5" StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Data="M2,10 L10,2 M5,2 L10,2 L10,7"/>
                                <Path x:Name="IconRestore"
                                      Stroke="{DynamicResource TextSecondaryBrush}"
                                      StrokeThickness="1.5" StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Data="M10,2 L2,10 M2,5 L2,10 L7,10"/>
                            </Grid>
                        </Button>
                        <TextBlock x:Name="DrawerTitle" Text="账号备忘" FontSize="16" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </DockPanel>
                    <vault:VaultEditorPanel x:Name="DrawerEditor" Grid.Row="1" Margin="16,0,8,16"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
