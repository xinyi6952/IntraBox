<Window x:Class="IntraBox.Modules.JobFlow.JobPickStepWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="从步骤库选择" Width="560" Height="420"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBgBrush}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   Text="选中后插入编排快照（最多 5 步）。之后改步骤库不会改已加入的任务。"/>
        <DataGrid x:Name="LibGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" HeadersVisibility="Column" SelectionMode="Single"
                  MouseDoubleClick="LibGrid_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*"
                                    ElementStyle="{StaticResource DataGridEllipsisText}"/>
                <DataGridTextColumn Header="类型" Binding="{Binding KindText}" Width="80"
                                    ElementStyle="{StaticResource DataGridEllipsisText}"/>
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="插入快照" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Click="Ok_Click"/>
            <Button Content="取消" Width="88" IsCancel="True" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
