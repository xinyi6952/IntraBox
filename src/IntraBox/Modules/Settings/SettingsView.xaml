<UserControl x:Class="IntraBox.Modules.Settings.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="4">
            <StackPanel MaxWidth="560" HorizontalAlignment="Left">
                <TextBlock Text="设置" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>

                <TextBlock Text="外观" FontWeight="SemiBold" Margin="0,0,0,6"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="选择浅色、深色，或跟随系统（Windows 10+；Windows 7 跟随系统时使用深色）。切换立即生效并记住。"/>
                <ComboBox x:Name="ThemeCombo" Width="220" HorizontalAlignment="Left" Margin="0,0,0,20"
                          SelectionChanged="ThemeCombo_SelectionChanged">
                    <ComboBoxItem Content="浅色"/>
                    <ComboBoxItem Content="深色"/>
                    <ComboBoxItem Content="跟随系统"/>
                </ComboBox>

                <TextBlock Text="状态记忆写入延迟" FontWeight="SemiBold" Margin="0,0,0,6"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock TextWrapping="Wrap" Margin="0,0,0,10"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="所有工具切换后记住的输入，以及桌面整理规则，写入磁盘前的等待时间。到期后在后台线程序列化并写盘，不占用界面。缩短更及时，拉长可减少连续操作时的磁盘写入。范围 300–1000 毫秒。"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                    <Slider x:Name="HistoryDelaySlider" Width="280"
                            Minimum="300" Maximum="1000" TickFrequency="50"
                            IsSnapToTickEnabled="True" VerticalAlignment="Center"
                            ValueChanged="HistoryDelaySlider_ValueChanged"/>
                    <TextBlock x:Name="HistoryDelayLabel" Margin="12,0,0,0" VerticalAlignment="Center"
                               FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                </StackPanel>

                <TextBlock Text="文件大小上限" FontWeight="SemiBold" Margin="0,0,0,6"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock TextWrapping="Wrap" Margin="0,0,0,10"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="打开、导入文件时的体积上限。默认 10 MB，最高 200 MB。粘贴超大文本、剪贴板图片同样受此限制。上限越高，通过检查的文件占用内存越多（文本大约再乘约 2 倍）；超过上限的文件只看磁盘大小，不会读进内存。建议保持默认，除非确实要处理更大文件。"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Slider x:Name="SizeSlider" Width="280" Minimum="1" Maximum="200" TickFrequency="1"
                            IsSnapToTickEnabled="True" VerticalAlignment="Center"
                            ValueChanged="SizeSlider_ValueChanged"/>
                    <TextBlock x:Name="SizeLabel" Margin="12,0,0,0" VerticalAlignment="Center"
                               FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                </StackPanel>
                <TextBlock x:Name="HardCapHint" Margin="0,0,0,16" FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>

                <TextBlock Text="剪贴板历史条数" FontWeight="SemiBold" Margin="0,0,0,6"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock TextWrapping="Wrap" Margin="0,0,0,10"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="默认 20 条，最多 200。下调上限时优先丢掉未固定的旧记录。"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <Slider x:Name="ClipSlider" Width="280" Minimum="1" Maximum="200" TickFrequency="1"
                            IsSnapToTickEnabled="True" VerticalAlignment="Center"
                            ValueChanged="ClipSlider_ValueChanged"/>
                    <TextBlock x:Name="ClipLabel" Margin="12,0,0,0" VerticalAlignment="Center"
                               FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                </StackPanel>

                <TextBlock Text="截屏快捷键" FontWeight="SemiBold" Margin="0,0,0,6"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="点击输入框后按下组合键（需包含 Ctrl 或 Alt）。托盘隐藏时仍然有效。"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <TextBox x:Name="HotkeyBox" Width="200" IsReadOnly="True"
                             ToolTip="点击后按下新的快捷键"
                             PreviewKeyDown="HotkeyBox_PreviewKeyDown"/>
                    <Button Content="恢复默认" Margin="8,0,0,0" Click="HotkeyReset_Click"/>
                </StackPanel>

                <TextBlock Text="工具显隐" FontWeight="SemiBold" Margin="0,0,0,6"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="勾选的工具出现在左侧导航。设置始终固定在底部。至少保留一个工具。"/>
                <ItemsControl x:Name="ToolVisList" Margin="0,0,0,16">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Content="{Binding DisplayName}" IsChecked="{Binding IsVisible, Mode=TwoWay}"
                                      Margin="0,4" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- 固定底栏：保存按钮始终可见，无需滚到最底 -->
        <Border Grid.Row="1" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                Background="{DynamicResource PanelBgBrush}" Padding="8,8,8,8">
            <StackPanel Orientation="Horizontal">
                <Button Content="保存设置" Style="{StaticResource PrimaryButton}"
                        Click="Save_Click" Margin="0,0,8,0"/>
                <Button Content="再次显示欢迎引导" Click="Welcome_Click" Margin="0,0,12,0"/>
                <TextBlock x:Name="MsgText" TextWrapping="Wrap" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
