<UserControl x:Class="IntraBox.Modules.Demo.DemoModule"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="8">
        <TextBlock Text="这是一个示例模块，用于演示「按需加载、用完销毁」机制。"
                   FontSize="15" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimaryBrush}" />
        <TextBlock Text="切换到左侧其它模块再切回来，观察下面时间变化：本控件会被销毁并重新创建。"
                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,0" TextWrapping="Wrap" />
        <TextBlock x:Name="CreateTimeText" Margin="0,20,0,0" FontSize="14"
                   Foreground="{DynamicResource TextPrimaryBrush}" />
    </StackPanel>
</UserControl>
