<UserControl x:Class="IntraBox.Modules.Diff.DiffView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:avalonEdit="clr-namespace:ICSharpCode.AvalonEdit;assembly=ICSharpCode.AvalonEdit">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <WrapPanel x:Name="DiffToolbar" Grid.Row="0" Margin="0,0,0,10">
            <CheckBox x:Name="IgnoreWhitespace" Content="忽略空白" Margin="0,4,16,4"
                      Checked="OnOptionChanged" Unchecked="OnOptionChanged"/>
            <CheckBox x:Name="IgnoreCase" Content="忽略大小写" Margin="0,4,16,4"
                      Checked="OnOptionChanged" Unchecked="OnOptionChanged"/>
            <Button Content="打开左侧文件" Margin="0,4,8,4" Click="LeftFile_Click"/>
            <Button Content="打开右侧文件" Margin="0,4,8,4" Click="RightFile_Click"/>
            <Button Content="交换左右" Margin="0,4,8,4" Click="Swap_Click"/>
            <Button Content="清空" Margin="0,4,16,4" Click="Clear_Click"/>
            <Button Content="上一个差异" Margin="0,4,8,4" Click="PrevDiff_Click"/>
            <Button Content="下一个差异" Margin="0,4,12,4" Click="NextDiff_Click"/>
            <Button Content="撤销" Margin="0,4,8,4" Click="Undo_Click"
                    ToolTip="撤销合并或编辑（Ctrl+Z）。保存到文件后编辑器内仍可撤销。"/>
            <TextBlock x:Name="StatText" VerticalAlignment="Center" Margin="4,4,0,4"
                       Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
        </WrapPanel>

        <Grid x:Name="EditorsGrid" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="ArrowCol" Width="32"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左：原文（旧） -->
            <Grid x:Name="LeftPane" Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,6">
                    <Button x:Name="LeftMaxBtn" DockPanel.Dock="Right" Click="LeftMax_Click"
                            Width="22" Height="22" MinWidth="22" MinHeight="22" Padding="0"
                            Background="Transparent" BorderThickness="0" ToolTip="最大化原文">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="Transparent" CornerRadius="3" Padding="3">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="{DynamicResource ButtonHoverBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <Grid Width="12" Height="12">
                            <Path x:Name="LeftMaxExpand"
                                  Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Data="M2,10 L10,2 M5,2 L10,2 L10,7"/>
                            <Path x:Name="LeftMaxRestore" Visibility="Collapsed"
                                  Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Data="M10,2 L2,10 M2,5 L2,10 L7,10"/>
                        </Grid>
                    </Button>
                    <TextBlock Text="原文（旧）" FontWeight="SemiBold" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                </DockPanel>
                <Border Grid.Row="1" BorderBrush="{DynamicResource EditorBorderBrush}" BorderThickness="1"
                        CornerRadius="4" Background="{DynamicResource EditorBackgroundBrush}"
                        AllowDrop="True" PreviewDragOver="Left_DragOver" PreviewDrop="Left_Drop">
                    <avalonEdit:TextEditor x:Name="LeftEditor" ShowLineNumbers="True"
                                           FontFamily="Consolas" FontSize="13" WordWrap="False"
                                           BorderThickness="0" Padding="4" AllowDrop="False"
                                           HorizontalScrollBarVisibility="Auto"
                                           VerticalScrollBarVisibility="Auto"/>
                </Border>
                <Grid Grid.Row="2" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="LeftPathText" Text="文本输入（未关联文件）"
                             IsReadOnly="True" IsReadOnlyCaretVisible="True"
                             BorderThickness="0" Background="Transparent" Padding="0" MinHeight="0"
                             Foreground="{DynamicResource TextSecondaryBrush}"
                             TextWrapping="Wrap" VerticalAlignment="Center" FontSize="12"/>
                    <ComboBox x:Name="LeftEncCombo" Grid.Column="1" MinWidth="120" Margin="8,0,8,0"
                              SelectionChanged="LeftEnc_SelectionChanged"/>
                    <Button x:Name="LeftSaveBtn" Grid.Column="2" Content="保存到文件"
                            Style="{StaticResource PrimaryButton}" Click="LeftSave_Click"
                            Visibility="Collapsed"/>
                </Grid>
            </Grid>

            <Canvas x:Name="ArrowCanvas" Grid.Column="1" Background="{DynamicResource NavBgBrush}"
                    ClipToBounds="True" Margin="1,28,1,40"/>

            <!-- 右：新文（新） -->
            <Grid x:Name="RightPane" Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,6">
                    <Button x:Name="RightMaxBtn" DockPanel.Dock="Right" Click="RightMax_Click"
                            Width="22" Height="22" MinWidth="22" MinHeight="22" Padding="0"
                            Background="Transparent" BorderThickness="0" ToolTip="最大化新文">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="Transparent" CornerRadius="3" Padding="3">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="{DynamicResource ButtonHoverBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <Grid Width="12" Height="12">
                            <Path x:Name="RightMaxExpand"
                                  Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Data="M2,10 L10,2 M5,2 L10,2 L10,7"/>
                            <Path x:Name="RightMaxRestore" Visibility="Collapsed"
                                  Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Data="M10,2 L2,10 M2,5 L2,10 L7,10"/>
                        </Grid>
                    </Button>
                    <TextBlock Text="新文（新）" FontWeight="SemiBold" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                </DockPanel>
                <Border Grid.Row="1" BorderBrush="{DynamicResource EditorBorderBrush}" BorderThickness="1"
                        CornerRadius="4" Background="{DynamicResource EditorBackgroundBrush}"
                        AllowDrop="True" PreviewDragOver="Right_DragOver" PreviewDrop="Right_Drop">
                    <avalonEdit:TextEditor x:Name="RightEditor" ShowLineNumbers="True"
                                           FontFamily="Consolas" FontSize="13" WordWrap="False"
                                           BorderThickness="0" Padding="4" AllowDrop="False"
                                           HorizontalScrollBarVisibility="Auto"
                                           VerticalScrollBarVisibility="Auto"/>
                </Border>
                <Grid Grid.Row="2" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="RightPathText" Text="文本输入（未关联文件）"
                             IsReadOnly="True" IsReadOnlyCaretVisible="True"
                             BorderThickness="0" Background="Transparent" Padding="0" MinHeight="0"
                             Foreground="{DynamicResource TextSecondaryBrush}"
                             TextWrapping="Wrap" VerticalAlignment="Center" FontSize="12"/>
                    <ComboBox x:Name="RightEncCombo" Grid.Column="1" MinWidth="120" Margin="8,0,8,0"
                              SelectionChanged="RightEnc_SelectionChanged"/>
                    <Button x:Name="RightSaveBtn" Grid.Column="2" Content="保存到文件"
                            Style="{StaticResource PrimaryButton}" Click="RightSave_Click"
                            Visibility="Collapsed"/>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
