<UserControl x:Class="IntraBox.Modules.FileOrganize.FileOrganizeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <WrapPanel Margin="0,0,0,8">
            <TextBlock Text="源目录" VerticalAlignment="Center" Margin="0,4,8,4"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
            <TextBox x:Name="DirBox" Width="320" Margin="0,4,8,4" LostFocus="DirBox_LostFocus"/>
            <Button Content="浏览…" Click="Browse_Click" Margin="0,4,12,4"/>
            <CheckBox x:Name="SubDirCheck" Content="包含子目录" VerticalAlignment="Center" Margin="0,4,12,4"
                      Click="OptionChanged_Click"/>
        </WrapPanel>
        <StackPanel Grid.Row="1" Margin="0,0,0,6">
            <TextBlock TextWrapping="Wrap" Margin="0,0,0,6"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Text="勾选「启用」的规则才会参与整理，至少勾选一条。从上到下先匹配到的规则生效。整理根目录固定为当天日期（yyyy-MM-dd），「目标目录」列填写它下面的子目录。规则会永久保存，下次打开软件自动加载。切换匹配条件会清空条件值。"/>
            <TextBlock TextWrapping="Wrap" Margin="0,0,0,2"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Text="目标目录占位符（可单独使用，也可组合）："/>
            <TextBlock TextWrapping="Wrap" Margin="12,0,0,0"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Text="{}{ext}    文件扩展名，不含点。例：a.jpg → jpg"/>
            <TextBlock TextWrapping="Wrap" Margin="12,0,0,0"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Text="{}{name}   不含扩展名的文件名。例：报告.pdf → 报告"/>
            <TextBlock TextWrapping="Wrap" Margin="12,0,0,0"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Text="{}{type}   按扩展名自动归类：图片、文档、表格、演示、压缩包、音频、视频、代码、其他"/>
            <TextBlock TextWrapping="Wrap" Margin="12,0,0,4"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Text="{}根目录已是当天日期，不必再写 {date}。例：目标填「图片」→ 源目录/2026-08-29/图片/a.jpg；填「{type}/{ext}」→ 源目录/2026-08-29/图片/jpg/a.jpg。选中日期规则后，在表格上方的日期框填写。"/>
            <TextBlock TextWrapping="Wrap"
                       Foreground="{DynamicResource WarningBrush}"
                       Text="预览时文件默认全部不勾选。只有勾选的文件会被移动；未勾选的保持原位。"/>
        </StackPanel>
        <WrapPanel x:Name="DateBar" Grid.Row="2" Margin="0,0,0,8" Visibility="Collapsed">
            <TextBlock Text="日期条件" VerticalAlignment="Center" Margin="0,4,8,4"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
            <DatePicker x:Name="RuleDatePicker" Width="180" Margin="0,4,8,4"
                        SelectedDateChanged="RuleDate_Changed"/>
            <TextBlock Text="选中「早于指定日期」规则后在此填写。修改日期会写回当前选中行。"
                       VerticalAlignment="Center" Margin="0,4,0,4"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
        </WrapPanel>
        <DataGrid x:Name="RuleGrid" Grid.Row="3" AutoGenerateColumns="False" CanUserAddRows="False"
                  HeadersVisibility="Column" BorderThickness="1" MinHeight="120"
                  EnableRowVirtualization="False" EnableColumnVirtualization="False"
                  VirtualizingPanel.IsVirtualizing="False"
                  SelectionUnit="FullRow"
                  SelectionChanged="RuleGrid_SelectionChanged"
                  CellEditEnding="RuleGrid_CellEditEnding">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="启用" Width="50">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                                      IsChecked="{Binding Enabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Click="EnableCheck_Click"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="匹配条件" Width="150">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding KindChoices}"
                                      SelectedItem="{Binding KindName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      SelectionChanged="KindCombo_SelectionChanged"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="条件值" Width="180">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding Pattern, UpdateSourceTrigger=LostFocus}"
                                     LostFocus="RuleField_LostFocus"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="目标目录" Binding="{Binding TargetTemplate, UpdateSourceTrigger=LostFocus}" Width="*"/>
                <DataGridTemplateColumn Header="删除" Width="64">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="删除" Padding="8,1" Margin="2,0"
                                    Click="DeleteRow_Click"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <WrapPanel Grid.Row="4" Margin="0,8,0,0">
            <Button Content="添加规则" Click="AddRule_Click" Margin="0,4,8,4"/>
            <Button Content="删除规则" Click="RemoveRule_Click" Margin="0,4,8,4"/>
            <Button Content="预览并执行" Style="{StaticResource PrimaryButton}" Click="Run_Click" Margin="0,4,8,4"/>
            <Button x:Name="UndoBtn" Content="撤销上次整理" Click="Undo_Click" Margin="0,4,8,4"/>
        </WrapPanel>
        <TextBlock x:Name="MsgText" Grid.Row="5" Margin="0,8,0,0" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextSecondaryBrush}"/>
    </Grid>
</UserControl>
