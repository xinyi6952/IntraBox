<UserControl x:Class="IntraBox.Modules.JobFlow.JobFlowView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:IntraBox.Controls"
             xmlns:local="clr-namespace:IntraBox.Modules.JobFlow"
             SizeChanged="Root_SizeChanged">
    <UserControl.Resources>
        <Style x:Key="JobCellText" TargetType="TextBlock" BasedOn="{StaticResource DataGridEllipsisText}"/>
        <Style x:Key="JobTabItem" TargetType="TabItem">
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="bd" Background="{DynamicResource ButtonBgBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                CornerRadius="4" Padding="{TemplateBinding Padding}" Margin="0,0,8,0"
                                SnapsToDevicePixels="True">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center"
                                              VerticalAlignment="Center" RecognizesAccessKey="True"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource ButtonHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonFgBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="JobTabControl" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource JobTabItem}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TabPanel Grid.Row="0" IsItemsHost="True" Margin="0,0,0,8"/>
                            <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Row="1"
                                              ContentSource="SelectedContent"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="JobAutoGrowBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="VerticalContentAlignment" Value="Top"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
        </Style>
        <ContextMenu x:Key="JobNewMenu">
            <MenuItem Header="空白编排" Click="NewBlank_Click" Style="{StaticResource ContextMenuItemStyle}"/>
        </ContextMenu>
        <ContextMenu x:Key="LibNewMenu">
            <MenuItem Header="REST" Click="LibNewRest_Click" Style="{StaticResource ContextMenuItemStyle}"/>
            <MenuItem Header="从 curl 新建 REST" Click="LibNewCurl_Click" Style="{StaticResource ContextMenuItemStyle}"/>
            <MenuItem Header="SOAP" Click="LibNewSoap_Click" Style="{StaticResource ContextMenuItemStyle}"/>
            <MenuItem Header="打开链接" Click="LibNewUrl_Click" Style="{StaticResource ContextMenuItemStyle}"/>
            <MenuItem Header="程序" Click="LibNewProgram_Click" Style="{StaticResource ContextMenuItemStyle}"/>
            <MenuItem Header="批处理" Click="LibNewBat_Click" Style="{StaticResource ContextMenuItemStyle}"/>
            <MenuItem Header="Python" Click="LibNewPython_Click" Style="{StaticResource ContextMenuItemStyle}"/>
        </ContextMenu>
        <ContextMenu x:Key="JobRowMenu">
            <MenuItem Header="编辑" Click="RowEdit_Click" Style="{StaticResource ContextMenuItemStyle}"/>
            <MenuItem Header="立即运行" Click="RowRun_Click" Style="{StaticResource ContextMenuItemStyle}"/>
            <MenuItem Header="设为草稿" Click="RowDraft_Click" Style="{StaticResource ContextMenuItemStyle}"/>
            <MenuItem Header="设为启用" Click="RowEnable_Click" Style="{StaticResource ContextMenuItemStyle}"/>
            <MenuItem Header="设为停用" Click="RowDisable_Click" Style="{StaticResource ContextMenuItemStyle}"/>
            <MenuItem Header="执行记录" Click="RowHistory_Click" Style="{StaticResource ContextMenuItemStyle}"/>
            <MenuItem Header="删除" Click="RowDelete_Click" Style="{StaticResource ContextMenuItemStyle}"/>
        </ContextMenu>
        <ContextMenu x:Key="LibRowMenu">
            <MenuItem Header="编辑" Click="LibEdit_Click" Style="{StaticResource ContextMenuItemStyle}"/>
            <MenuItem Header="删除" Click="LibDelete_Click" Style="{StaticResource ContextMenuItemStyle}"/>
        </ContextMenu>
    </UserControl.Resources>
    <Grid x:Name="RootGrid">
        <TabControl x:Name="MainTabs" Style="{StaticResource JobTabControl}"
                    SelectionChanged="MainTabs_SelectionChanged">
            <TabItem Header="编排">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0">
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                                   Foreground="{DynamicResource WarningBrush}"
                                   Text="在「步骤库」编好步骤后，再回到本页挑选快照（最多 5 步）。进程在才会到点跑；须手动成功一次且状态为「启用」。超过 5 步的旧编排只读打开、不能保存。"/>
                        <WrapPanel Margin="0,0,0,8">
                            <Button x:Name="JobNewBtn" Content="新建" Style="{StaticResource PrimaryButton}" Margin="0,4,8,4" Click="JobNewBtn_Click"/>
                            <Button Content="刷新" Margin="0,4,8,4" Click="Reload_Click"/>
                            <controls:GridFilterBar x:Name="JobFilterBar" VerticalAlignment="Center" Margin="8,4,0,4"/>
                            <TextBlock x:Name="JobMsgText" VerticalAlignment="Center" Margin="8,4,0,4"
                                       Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                        </WrapPanel>
                    </StackPanel>
                    <DataGrid x:Name="JobGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" HeadersVisibility="Column" BorderThickness="1"
                              SelectionMode="Single" MouseDoubleClick="JobGrid_MouseDoubleClick"
                              RowHeight="36" EnableRowVirtualization="True">
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                <Setter Property="Padding" Value="8,0"/>
                            </Style>
                        </DataGrid.CellStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*" MinWidth="120"
                                                ElementStyle="{StaticResource JobCellText}"/>
                            <DataGridTextColumn Header="状态" Binding="{Binding StatusText}" Width="56"
                                                ElementStyle="{StaticResource JobCellText}"/>
                            <DataGridTextColumn Header="触发" Binding="{Binding TriggerText}" Width="110"
                                                ElementStyle="{StaticResource JobCellText}"/>
                            <DataGridTextColumn Header="测通时间" Binding="{Binding TestPassText}" Width="110"
                                                ElementStyle="{StaticResource JobCellText}"/>
                            <DataGridTextColumn Header="执行次数" Binding="{Binding RunCount}" Width="70"
                                                ElementStyle="{StaticResource JobCellText}"/>
                            <DataGridTextColumn Header="上次时间" Binding="{Binding LastRunText}" Width="120"
                                                ElementStyle="{StaticResource JobCellText}"/>
                            <DataGridTextColumn Header="上次状态" Binding="{Binding LastOkText}" Width="70"
                                                ElementStyle="{StaticResource JobCellText}"/>
                            <DataGridTemplateColumn Header="操作" Width="72">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="操作" Padding="8,2" MinHeight="26" MinWidth="56"
                                                Click="RowOp_Click" Tag="{Binding}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="步骤库">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0">
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="在此编写步骤（REST 可从 curl 识别）。【示例】步骤只读。编好后到「编排」页挑选快照。"/>
                        <WrapPanel Margin="0,0,0,8">
                            <Button x:Name="LibNewBtn" Content="新建" Style="{StaticResource PrimaryButton}" Margin="0,4,8,4" Click="LibNewBtn_Click"/>
                            <Button Content="刷新" Margin="0,4,8,4" Click="Reload_Click"/>
                            <controls:GridFilterBar x:Name="LibFilterBar" VerticalAlignment="Center" Margin="8,4,0,4"/>
                            <TextBlock x:Name="LibMsgText" VerticalAlignment="Center" Margin="8,4,0,4"
                                       Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                        </WrapPanel>
                    </StackPanel>
                    <DataGrid x:Name="LibGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" HeadersVisibility="Column" BorderThickness="1"
                              SelectionMode="Single" MouseDoubleClick="LibGrid_MouseDoubleClick"
                              RowHeight="36">
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                <Setter Property="Padding" Value="8,0"/>
                            </Style>
                        </DataGrid.CellStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*" MinWidth="120"
                                                ElementStyle="{StaticResource JobCellText}"/>
                            <DataGridTextColumn Header="类型" Binding="{Binding KindText}" Width="90"
                                                ElementStyle="{StaticResource JobCellText}"/>
                            <DataGridTemplateColumn Header="操作" Width="72">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="操作" Padding="8,2" MinHeight="26" MinWidth="56"
                                                Click="LibOp_Click" Tag="{Binding}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>

        <Grid x:Name="DrawerHost" Panel.ZIndex="10" Visibility="Collapsed">
            <Border x:Name="DrawerMask" Background="#99000000" MouseLeftButtonDown="DrawerMask_Click"/>
            <Border x:Name="DrawerPanel" HorizontalAlignment="Right" VerticalAlignment="Stretch"
                    Background="{DynamicResource PanelBgBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="16,12">
                        <Button DockPanel.Dock="Right" Content="×" Width="32" Height="32" MinWidth="32"
                                Padding="0" Click="DrawerClose_Click" ToolTip="关闭"/>
                        <Button x:Name="DrawerMaxBtn" DockPanel.Dock="Right" Width="32" Height="32"
                                MinWidth="32" Padding="0" Margin="0,0,4,0"
                                Click="DrawerMax_Click" ToolTip="最大化">
                            <Grid Width="12" Height="12">
                                <Path x:Name="IconExpand" Stroke="{DynamicResource TextSecondaryBrush}"
                                      StrokeThickness="1.5" Data="M2,10 L10,2 M5,2 L10,2 L10,7"/>
                                <Path x:Name="IconRestore" Visibility="Collapsed"
                                      Stroke="{DynamicResource TextSecondaryBrush}"
                                      StrokeThickness="1.5" Data="M10,2 L2,10 M2,5 L2,10 L7,10"/>
                            </Grid>
                        </Button>
                        <TextBlock x:Name="DrawerTitle" Text="编排详情" FontSize="16" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </DockPanel>

                    <ScrollViewer x:Name="DrawerScroll" Grid.Row="1" Margin="16,0,4,0"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  CanContentScroll="False"
                                  PreviewMouseWheel="DrawerScroll_PreviewMouseWheel">
                        <StackPanel Margin="0,0,12,16">
                            <StackPanel x:Name="JobEditHost">
                                <TextBlock x:Name="OverflowText" Visibility="Collapsed" TextWrapping="Wrap" Margin="0,0,0,10"
                                           Foreground="{DynamicResource DangerBrush}"
                                           Text="此编排步骤超过 5 个，只读打开，不能保存。请拆成多条编排。"/>
                                <WrapPanel Margin="0,0,0,8">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,8,4">
                                        <TextBlock Text="*" Foreground="{DynamicResource DangerBrush}" FontWeight="Bold" Margin="0,0,4,0"/>
                                        <TextBlock Text="名称"/>
                                    </StackPanel>
                                    <TextBox x:Name="NameBox" Width="220" Margin="0,4,12,4"/>
                                    <TextBlock Text="状态" VerticalAlignment="Center" Margin="0,4,8,4"/>
                                    <ComboBox x:Name="StatusCombo" Width="90" Margin="0,4,12,4">
                                        <ComboBoxItem Content="草稿"/>
                                        <ComboBoxItem Content="启用"/>
                                        <ComboBoxItem Content="停用"/>
                                    </ComboBox>
                                    <TextBlock x:Name="MetaText" VerticalAlignment="Center" Margin="8,4,0,4"
                                               Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                </WrapPanel>
                                <TextBlock Text="备注" FontWeight="SemiBold" Margin="0,4,0,6"/>
                                <TextBox x:Name="RemarksBox" Style="{StaticResource JobAutoGrowBox}"
                                         MinHeight="72" MaxHeight="320" Margin="0,0,0,10"/>

                                <DockPanel Margin="0,4,0,6">
                                    <TextBlock x:Name="StepCountText" Text="步骤 0/5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <StackPanel x:Name="StepMenuBar" DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Button Content="从步骤库选择" Style="{StaticResource BarMenuButton}" Margin="0,0,8,0" Click="PickStep_Click"/>
                                        <Button Content="上移" Style="{StaticResource BarMenuButton}" Margin="0,0,8,0" Click="StepUp_Click"/>
                                        <Button Content="下移" Style="{StaticResource BarMenuButton}" Margin="0,0,8,0" Click="StepDown_Click"/>
                                        <Button Content="从库替换" Style="{StaticResource BarMenuButton}" Margin="0,0,8,0" Click="ReplaceStep_Click"/>
                                        <Button Content="移除" Style="{StaticResource BarMenuButton}" Click="DelStep_Click"/>
                                    </StackPanel>
                                </DockPanel>
                                <DataGrid x:Name="StepGrid" Height="140" AutoGenerateColumns="False" IsReadOnly="True"
                                          CanUserAddRows="False" HeadersVisibility="Column" BorderThickness="1"
                                          Margin="0,0,0,10">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*"
                                                            ElementStyle="{StaticResource JobCellText}"/>
                                        <DataGridTextColumn Header="类型" Binding="{Binding KindText}" Width="80"
                                                            ElementStyle="{StaticResource JobCellText}"/>
                                        <DataGridTextColumn Header="来源库" Binding="{Binding LibraryText}" Width="140"
                                                            ElementStyle="{StaticResource JobCellText}"/>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <TextBlock Text="本任务参数（从步骤 ${变量} 汇总；密钥请用立即运行时「记住密钥」，默认值不落盘）" FontWeight="SemiBold" Margin="0,4,0,6"/>
                                <DataGrid x:Name="ParamGrid" Height="120" AutoGenerateColumns="False" CanUserAddRows="False"
                                          HeadersVisibility="Column" BorderThickness="1" Margin="0,0,0,10">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="100"
                                                            ElementStyle="{StaticResource JobCellText}"/>
                                        <DataGridTextColumn Header="显示名" Binding="{Binding DisplayName}" Width="100"
                                                            ElementStyle="{StaticResource JobCellText}"/>
                                        <DataGridTextColumn Header="类型" Binding="{Binding TypeText}" Width="70"
                                                            ElementStyle="{StaticResource JobCellText}"/>
                                        <DataGridCheckBoxColumn Header="必填" Binding="{Binding Required}" Width="50"/>
                                        <DataGridTextColumn Header="默认值" Binding="{Binding DefaultValue}" Width="*"
                                                            ElementStyle="{StaticResource JobCellText}"/>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <TextBlock Text="触发器" FontWeight="SemiBold" Margin="0,4,0,6"/>
                                <WrapPanel x:Name="TriggerPanel" Margin="0,0,0,10">
                                    <ComboBox x:Name="TriggerCombo" Width="120" Margin="0,4,12,4">
                                        <ComboBoxItem Content="仅手动"/>
                                        <ComboBoxItem Content="每天"/>
                                        <ComboBoxItem Content="工作日"/>
                                        <ComboBoxItem Content="每周"/>
                                    </ComboBox>
                                    <TextBlock Text="时刻" VerticalAlignment="Center" Margin="0,4,8,4"/>
                                    <TextBox x:Name="TriggerTimeBox" Width="60" Margin="0,4,12,4" Text="09:00"/>
                                    <TextBlock Text="最小间隔分" VerticalAlignment="Center" Margin="0,4,8,4"/>
                                    <TextBox x:Name="IntervalBox" Width="48" Margin="0,4,12,4" Text="60"/>
                                    <TextBlock Text="周几(0日)" VerticalAlignment="Center" Margin="0,4,8,4"/>
                                    <TextBox x:Name="WeekdayBox" Width="40" Margin="0,4,8,4" Text="1"/>
                                </WrapPanel>

                                <TextBlock Text="最近运行日志" FontWeight="SemiBold" Margin="0,4,0,6"/>
                                <TextBox x:Name="LogBox" Style="{StaticResource JobAutoGrowBox}"
                                         MinHeight="80" MaxHeight="240" IsReadOnly="True" FontFamily="Consolas"/>
                            </StackPanel>
                            <local:JobStepEditorPanel x:Name="StepEditor" Visibility="Collapsed"/>
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,10">
                        <DockPanel>
                            <StackPanel x:Name="DrawerEditButtons" DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="立即运行" Margin="0,0,8,0" Click="DrawerRun_Click"/>
                                <Button Content="保存" Margin="0,0,8,0" Click="DrawerSave_Click"/>
                                <Button Content="保存并关闭" Style="{StaticResource PrimaryButton}" Click="DrawerSaveClose_Click"/>
                            </StackPanel>
                            <Button x:Name="DrawerViewCloseBtn" DockPanel.Dock="Right" Content="关闭"
                                    Style="{StaticResource PrimaryButton}" Visibility="Collapsed"
                                    Click="DrawerClose_Click"/>
                            <TextBlock x:Name="DrawerMsg" VerticalAlignment="Center" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </DockPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
