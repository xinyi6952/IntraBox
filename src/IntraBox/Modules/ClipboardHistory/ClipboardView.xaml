<UserControl x:Class="IntraBox.Modules.ClipboardHistory.ClipboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <WrapPanel x:Name="ToolbarPanel" Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="搜索" VerticalAlignment="Center" Margin="0,4,8,4"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
            <TextBox x:Name="SearchBox" MinWidth="180" Margin="0,4,8,4" TextChanged="SearchBox_TextChanged"/>
            <Button Content="清空搜索" Margin="0,4,8,4" Click="ClearSearch_Click"/>
            <Button Content="写回剪贴板" Style="{StaticResource PrimaryButton}" Margin="0,4,8,4" Click="PasteBtn_Click"/>
            <Button Content="固定/取消" Margin="0,4,8,4" Click="PinBtn_Click"/>
            <Button Content="删除" Margin="0,4,8,4" Click="DeleteBtn_Click"/>
            <Button Content="清空非固定" Margin="0,4,8,4" Click="ClearBtn_Click"/>
            <TextBlock x:Name="MsgText" VerticalAlignment="Center" Margin="8,4,0,4"
                       Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
            <TextBlock Text="图片历史仅保留缩略图（最长边 128px）" VerticalAlignment="Center" Margin="12,4,0,4"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
        </WrapPanel>

        <ListBox x:Name="HistoryList" Grid.Row="1"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 MouseDoubleClick="HistoryList_MouseDoubleClick"
                 PreviewMouseRightButtonDown="HistoryList_PreviewMouseRightButtonDown"
                 HorizontalContentAlignment="Stretch">
            <ListBox.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="查看" Click="ViewMenu_Click"/>
                    <MenuItem Header="删除" Click="DeleteMenu_Click"/>
                </ContextMenu>
            </ListBox.ContextMenu>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Image Source="{Binding Thumb}" Width="44" Height="44" Stretch="Uniform" Margin="0,0,6,0"/>
                        <TextBlock Grid.Column="1" Text="★" Foreground="#E6A23C" VerticalAlignment="Center" Margin="0,0,4,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Grid.Column="2" Text="{Binding ShortPreview}" TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap" VerticalAlignment="Center"
                                   ToolTip="{Binding Preview}"/>
                        <TextBlock Grid.Column="3" Text="{Binding Time, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"
                                   FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- 窗口内最大化查看：文本全文 / 图片缩略图，右上角缩小恢复 -->
        <Border x:Name="ViewerOverlay" Grid.Row="0" Grid.RowSpan="2" Visibility="Collapsed"
                Background="{DynamicResource WindowBgBrush}" Panel.ZIndex="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,8">
                    <Button DockPanel.Dock="Right" Content="缩小" MinWidth="72" Click="ViewerClose_Click"
                            ToolTip="恢复列表"/>
                    <TextBlock x:Name="ViewerTitle" VerticalAlignment="Center" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <TextBox x:Name="ViewerText" AcceptsReturn="True" IsReadOnly="True" TextWrapping="Wrap"
                                 FontFamily="Consolas" FontSize="13" BorderThickness="0"
                                 VerticalScrollBarVisibility="Disabled"/>
                        <Image x:Name="ViewerImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
