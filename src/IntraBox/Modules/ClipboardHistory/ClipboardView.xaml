<UserControl x:Class="IntraBox.Modules.ClipboardHistory.ClipboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <WrapPanel x:Name="ToolbarPanel" Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="搜索" VerticalAlignment="Center" Margin="0,4,8,4"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
            <TextBox x:Name="SearchBox" MinWidth="180" Margin="0,4,8,4" TextChanged="SearchBox_TextChanged"/>
            <Button Content="清空搜索" Margin="0,4,8,4" Click="ClearSearch_Click"/>
            <TextBlock x:Name="MsgText" VerticalAlignment="Center" Margin="8,4,0,4"
                       Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
        </WrapPanel>

        <ListBox x:Name="HistoryList" Grid.Row="1"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 MouseDoubleClick="HistoryList_MouseDoubleClick"
                 PreviewMouseRightButtonDown="HistoryList_PreviewMouseRightButtonDown"
                 HorizontalContentAlignment="Stretch">
            <ListBox.ContextMenu>
                <ContextMenu Opened="ListMenu_Opened">
                    <MenuItem x:Name="MenuViewItem" Header="查看" Click="ViewMenu_Click"
                              Style="{StaticResource ContextMenuItemStyle}">
                        <MenuItem.Icon>
                            <Path Style="{StaticResource MenuIconPath}"
                                  Data="M1,8 C4,3 12,3 15,8 C12,13 4,13 1,8 M6.5,8 A1.5,1.5 0 1 0 9.5,8 A1.5,1.5 0 1 0 6.5,8"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem x:Name="MenuPasteItem" Header="写回剪贴板" Click="PasteMenu_Click"
                              Style="{StaticResource ContextMenuItemStyle}">
                        <MenuItem.Icon>
                            <Path Style="{StaticResource MenuIconPath}"
                                  Data="M5,3 H11 V5 H13 V14 H3 V5 H5 V3 M6,2 H10 V5 H6 Z"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem x:Name="MenuPinItem" Header="固定" Click="PinMenu_Click"
                              Style="{StaticResource ContextMenuItemStyle}">
                        <MenuItem.Icon>
                            <Path Style="{StaticResource MenuIconPath}"
                                  Data="M6,2 H10 L11,7 H13 L8,12 V15 M8,12 L3,7 H5 L6,2"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem x:Name="MenuDeleteItem" Header="删除" Click="DeleteMenu_Click"
                              Style="{StaticResource ContextMenuItemStyle}">
                        <MenuItem.Icon>
                            <Path Style="{StaticResource MenuIconPath}" Data="M4,4 L12,12 M12,4 L4,12"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem x:Name="MenuClearItem" Header="清空非固定" Click="ClearMenu_Click"
                              Style="{StaticResource ContextMenuItemStyle}">
                        <MenuItem.Icon>
                            <Path Style="{StaticResource MenuIconPath}"
                                  Data="M3,5 H13 M5,5 V13 H11 V5 M7,7 V11 M9,7 V11"/>
                        </MenuItem.Icon>
                    </MenuItem>
                </ContextMenu>
            </ListBox.ContextMenu>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Image Source="{Binding Thumb}" Width="44" Height="44" Stretch="Uniform" Margin="0,0,6,0"/>
                        <TextBlock Grid.Column="1" Text="★" Foreground="#E6A23C" VerticalAlignment="Center" Margin="0,0,4,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Grid.Column="2" Text="{Binding ShortPreview}" TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap" VerticalAlignment="Center"
                                   ToolTip="{Binding Preview}"/>
                        <TextBlock Grid.Column="3" Text="{Binding Time, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"
                                   FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Border x:Name="ViewerOverlay" Grid.Row="0" Grid.RowSpan="2" Visibility="Collapsed"
                Background="{DynamicResource WindowBgBrush}" Panel.ZIndex="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,8">
                    <Button DockPanel.Dock="Right" Content="缩小" MinWidth="72" Click="ViewerClose_Click"
                            ToolTip="恢复列表"/>
                    <TextBlock x:Name="ViewerTitle" VerticalAlignment="Center" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
                <ScrollViewer x:Name="ViewerScroll" Grid.Row="1"
                              HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <Grid HorizontalAlignment="Left" VerticalAlignment="Top">
                        <TextBox x:Name="ViewerText" AcceptsReturn="True" IsReadOnly="True" TextWrapping="Wrap"
                                 FontFamily="Consolas" FontSize="13" BorderThickness="0"
                                 VerticalAlignment="Top" HorizontalAlignment="Left"
                                 VerticalContentAlignment="Top" HorizontalContentAlignment="Left"
                                 VerticalScrollBarVisibility="Disabled"
                                 Width="{Binding ViewportWidth, ElementName=ViewerScroll}"/>
                        <Image x:Name="ViewerImage" Stretch="None" HorizontalAlignment="Left" VerticalAlignment="Top"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
