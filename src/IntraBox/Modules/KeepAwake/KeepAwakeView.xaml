<UserControl x:Class="IntraBox.Modules.KeepAwake.KeepAwakeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,10" FontWeight="SemiBold"
                   Foreground="{DynamicResource DangerBrush}"
                   Text="此功能可能违反组织的电源管理/安全策略，请勿用于对抗管理员强制睡眠。仅建议在长时间编译、下载或本地任务时使用，风险自负。"/>
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   Text="开启后在设定时长内阻止系统进入睡眠（并尽量保持显示器唤醒）。到期自动关闭。状态不随切换工具丢失，退出程序时恢复。"/>
        <TextBlock Margin="0,0,0,6" Foreground="{DynamicResource TextSecondaryBrush}"
                   Text="时长：可点快捷项，也可自己输入数字并选择分钟或小时。"/>
        <WrapPanel x:Name="DurationPanel" Margin="0,0,0,8">
            <Button Content="10分钟" MinWidth="72" Margin="0,4,8,4" Tag="10|分钟" Click="Preset_Click"/>
            <Button Content="20分钟" MinWidth="72" Margin="0,4,8,4" Tag="20|分钟" Click="Preset_Click"/>
            <Button Content="30分钟" MinWidth="72" Margin="0,4,8,4" Tag="30|分钟" Click="Preset_Click"/>
            <Button Content="1小时" MinWidth="72" Margin="0,4,8,4" Tag="1|小时" Click="Preset_Click"/>
        </WrapPanel>
        <WrapPanel Margin="0,0,0,12">
            <TextBlock Text="自定义" VerticalAlignment="Center" Margin="0,4,8,4"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
            <TextBox x:Name="AmountBox" Width="80" Margin="0,4,8,4" Text="30"/>
            <ComboBox x:Name="UnitCombo" Width="80" Margin="0,4,8,4">
                <ComboBoxItem Content="分钟" IsSelected="True"/>
                <ComboBoxItem Content="小时"/>
            </ComboBox>
        </WrapPanel>
        <Button x:Name="ToggleBtn" Content="开启防止睡眠" Style="{StaticResource PrimaryButton}"
                HorizontalAlignment="Left" MinWidth="160" Click="Toggle_Click"/>
        <TextBlock x:Name="StateText" Margin="0,12,0,0" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextSecondaryBrush}"/>
    </StackPanel>
</UserControl>
