<UserControl x:Class="IntraBox.Controls.CodeEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:avalonEdit="clr-namespace:ICSharpCode.AvalonEdit;assembly=ICSharpCode.AvalonEdit"
             xmlns:local="clr-namespace:IntraBox.Controls">
    <UserControl.Resources>
        <!-- 编辑器内滚动条常驻可见：全局 overlay 样式默认 Opacity=0（悬停才浮现），
             大文本下用户看不到滚动条。这里在编辑器范围内覆盖为常驻可见。 -->
        <Style TargetType="ScrollBar" BasedOn="{StaticResource {x:Type ScrollBar}}">
            <Setter Property="Opacity" Value="0.85"/>
            <Setter Property="Width" Value="10"/>
            <Setter Property="MinWidth" Value="10"/>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- 左列：编辑器 + 悬浮搜索条/按钮 -->
        <Grid Grid.Column="0">
            <Border BorderBrush="{DynamicResource EditorBorderBrush}" BorderThickness="1"
                    Background="{DynamicResource EditorBackgroundBrush}" CornerRadius="4">
                <avalonEdit:TextEditor x:Name="Editor"
                                       ShowLineNumbers="True"
                                       FontFamily="Consolas" FontSize="13"
                                       WordWrap="False"
                                       BorderThickness="0"
                                       Padding="4"
                                       HorizontalScrollBarVisibility="Auto"
                                       VerticalScrollBarVisibility="Visible" />
            </Border>
            <local:EditorSearchBar x:Name="SearchBar" VerticalAlignment="Top" Visibility="Collapsed" Panel.ZIndex="1"/>
            <Button x:Name="MaxBtn" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Width="22" Height="22" MinWidth="22" MinHeight="22" Padding="0"
                    Margin="0,4,18,0" Click="MaxBtn_Click"
                    Visibility="Collapsed" Panel.ZIndex="2"
                    Background="Transparent" BorderThickness="0"
                    ToolTip="最大化输出">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="3" Padding="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource ButtonHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <Grid Width="12" Height="12">
                    <!-- ↗ 放大 -->
                    <Path x:Name="IconExpand"
                          Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.5"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          Data="M2,10 L10,2 M5,2 L10,2 L10,7"/>
                    <!-- ↙ 还原 -->
                    <Path x:Name="IconRestore" Visibility="Collapsed"
                          Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.5"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          Data="M10,2 L2,10 M2,5 L2,10 L7,10"/>
                </Grid>
            </Button>
            <Button x:Name="CopyBtn" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Width="22" Height="22" MinWidth="22" MinHeight="22" Padding="0"
                    Margin="0,4,44,0" Click="CopyBtn_Click"
                    Visibility="Collapsed" Panel.ZIndex="2"
                    Background="Transparent" BorderThickness="0"
                    ToolTip="复制全部内容">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="3" Padding="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource ButtonHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <!-- 复制图标：两张重叠的卡片 -->
                <Canvas Width="12" Height="12">
                    <Border Canvas.Left="1" Canvas.Top="1" Width="7" Height="8" CornerRadius="1"
                            BorderBrush="{DynamicResource TextSecondaryBrush}" BorderThickness="1.2"
                            Background="Transparent"/>
                    <Border Canvas.Left="4" Canvas.Top="3" Width="7" Height="8" CornerRadius="1"
                            BorderBrush="{DynamicResource TextSecondaryBrush}" BorderThickness="1.2"
                            Background="{DynamicResource EditorBackgroundBrush}"/>
                </Canvas>
            </Button>
        </Grid>

        <!-- 右列：CodeGlance 风格 minimap（代码里挂 MinimapMargin） -->
        <ContentControl x:Name="MinimapHost" Grid.Column="1" VerticalAlignment="Stretch" />
    </Grid>
</UserControl>
