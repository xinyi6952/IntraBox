<Window x:Class="IntraBox.Modules.Launcher.LauncherOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="启动器" Width="560" Height="440"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        Topmost="True" ShowActivated="True"
        Background="{DynamicResource WindowBgBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontSize="14"
        Deactivated="Window_Deactivated"
        PreviewKeyDown="Window_PreviewKeyDown"
        Loaded="Window_Loaded">
    <Border BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2">
        <Grid Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <DockPanel Grid.Row="0" Margin="0,0,0,8">
                <Button DockPanel.Dock="Right" Content="×" Width="28" Height="28" MinWidth="28" MinHeight="28"
                        Padding="0" FontSize="16" Background="Transparent" BorderThickness="0"
                        Foreground="{DynamicResource TextSecondaryBrush}" Click="Close_Click"/>
                <TextBlock Text="启动器" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </DockPanel>
            <TextBox x:Name="SearchBox" Grid.Row="1" Margin="0,0,0,8"
                     ToolTip="搜索可见工具、收藏、待办标题、笔记标题、账号分类名"
                     TextChanged="SearchBox_TextChanged"
                     PreviewKeyDown="SearchBox_PreviewKeyDown"/>
            <ListBox x:Name="HitsList" Grid.Row="2"
                     BorderThickness="0"
                     Background="Transparent"
                     Foreground="{DynamicResource TextPrimaryBrush}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     MouseDoubleClick="HitsList_MouseDoubleClick"
                     PreviewKeyDown="HitsList_PreviewKeyDown">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="4,6">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Subtitle}" FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Border>
</Window>
