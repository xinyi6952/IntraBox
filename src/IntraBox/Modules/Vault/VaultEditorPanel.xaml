<UserControl x:Class="IntraBox.Modules.Vault.VaultEditorPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             PreviewKeyDown="Panel_PreviewKeyDown">
    <UserControl.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Save" Executed="SaveCommand_Executed"/>
    </UserControl.CommandBindings>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBox x:Name="TitleBox" Grid.Row="0" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"
                 BorderThickness="0,0,0,1" Padding="4,6" ToolTip="分类 / 系统名称"
                 TextChanged="Field_Changed"/>
        <TextBox x:Name="RemarkBox" Grid.Row="1" Margin="0,0,0,8"
                 BorderThickness="1" Padding="8,6" ToolTip="说明（可选）"
                 TextChanged="Field_Changed"/>
        <WrapPanel x:Name="ToolbarPanel" Grid.Row="2" Margin="0,0,0,8" VerticalAlignment="Center">
            <Button x:Name="AddRowBtn" Content="添加一行" Click="AddRow_Click" Margin="0,0,8,4"/>
            <Button Content="复制全部" Click="CopyAll_Click" Margin="0,0,8,4"/>
            <Button Content="导出" Click="Export_Click" Margin="0,0,8,4"/>
            <Button x:Name="ImportBtn" Content="导入" Click="Import_Click" Margin="0,0,8,4"/>
            <Button x:Name="PwdBtn" Content="设置查看密码" Click="Password_Click" Margin="0,0,8,4"/>
            <TextBlock x:Name="LockHint" VerticalAlignment="Center" Margin="4,0,0,4"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
        </WrapPanel>
        <Grid Grid.Row="3" Grid.IsSharedSizeScope="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.3*"/>
                    <ColumnDefinition Width="1.6*"/>
                    <ColumnDefinition Width="1.1*"/>
                    <ColumnDefinition Width="1.1*"/>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="VaultEnc"/>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="VaultCopy"/>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="VaultDel"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="平台（可空）" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                <TextBlock Grid.Column="1" Text="URL（可空）" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                <TextBlock Grid.Column="2" Text="账号" Foreground="{DynamicResource TextSecondaryBrush}"/>
                <TextBlock Grid.Column="3" Text="密码" Foreground="{DynamicResource TextSecondaryBrush}"/>
                <TextBlock Grid.Column="4" Text="加密" HorizontalAlignment="Center" Margin="8,0"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
            </Grid>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="RowList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.3*"/>
                                    <ColumnDefinition Width="1.6*"/>
                                    <ColumnDefinition Width="1.1*"/>
                                    <ColumnDefinition Width="1.1*"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="VaultEnc"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="VaultCopy"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="VaultDel"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Margin="0,0,6,0"
                                         Text="{Binding PlatformsText, UpdateSourceTrigger=PropertyChanged}"
                                         IsReadOnly="{Binding EditorLocked}"
                                         ToolTip="多个平台可用 / 分隔"
                                         TextChanged="RowField_Changed"/>
                                <TextBox Grid.Column="1" Margin="0,0,6,0"
                                         Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}"
                                         IsReadOnly="{Binding EditorLocked}"
                                         TextChanged="RowField_Changed"/>
                                <Grid Grid.Column="2" Margin="0,0,6,0" Background="Transparent"
                                      PreviewMouseLeftButtonDown="SecretCell_PreviewMouseDown">
                                    <TextBox Text="{Binding AccountText, UpdateSourceTrigger=PropertyChanged}"
                                             IsEnabled="{Binding SecretsEditable}"
                                             ToolTip="加密后不显示明文，取消勾选「加密」可查看并编辑"
                                             TextChanged="RowField_Changed"/>
                                </Grid>
                                <Grid Grid.Column="3" Margin="0,0,6,0" Background="Transparent"
                                      PreviewMouseLeftButtonDown="SecretCell_PreviewMouseDown">
                                    <TextBox Text="{Binding PasswordText, UpdateSourceTrigger=PropertyChanged}"
                                             IsEnabled="{Binding SecretsEditable}"
                                             ToolTip="加密后不显示明文，取消勾选「加密」可查看并编辑"
                                             TextChanged="RowField_Changed"/>
                                </Grid>
                                <CheckBox Grid.Column="4" VerticalAlignment="Center" HorizontalAlignment="Center"
                                          Margin="8,0" ToolTip="勾选后账号密码加密且不显示明文；取消勾选需验证查看密码后显示明文"
                                          IsEnabled="{Binding CanEditRow}"
                                          IsChecked="{Binding Masked, Mode=TwoWay}"
                                          Click="Mask_Click"/>
                                <Button Grid.Column="5" Content="复制" MinWidth="64" Margin="8,0,6,0"
                                        Padding="10,2" Click="CopyBtn_Click" Tag="{Binding}">
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="复制账号密码" Click="CopyAp_Click" Tag="{Binding}"
                                                      Style="{StaticResource ContextMenuItemStyle}">
                                                <MenuItem.Icon>
                                                    <Path Style="{StaticResource MenuIconPath}" Data="M5,3 L11,3 11,11 5,11 Z M3,5 L3,13 9,13"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="复制平台与账号密码" Click="CopyPap_Click" Tag="{Binding}"
                                                      Style="{StaticResource ContextMenuItemStyle}">
                                                <MenuItem.Icon>
                                                    <Path Style="{StaticResource MenuIconPath}" Data="M3,4 L13,4 M3,8 L13,8 M3,12 L9,12"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="复制账号" Click="CopyA_Click" Tag="{Binding}"
                                                      Style="{StaticResource ContextMenuItemStyle}">
                                                <MenuItem.Icon>
                                                    <Path Style="{StaticResource MenuIconPath}" Data="M4,12 L4,4 12,4"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="复制密码" Click="CopyP_Click" Tag="{Binding}"
                                                      Style="{StaticResource ContextMenuItemStyle}">
                                                <MenuItem.Icon>
                                                    <Path Style="{StaticResource MenuIconPath}" Data="M8,8 A3,3 0 1 0 8,8 M8,11 L8,13"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="复制新增当前行" Click="CopyNewRow_Click" Tag="{Binding}"
                                                      Style="{StaticResource ContextMenuItemStyle}">
                                                <MenuItem.Icon>
                                                    <Path Style="{StaticResource MenuIconPath}" Data="M8,3 L8,13 M3,8 L13,8"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                                <Button Grid.Column="6" MinWidth="88" Padding="12,2"
                                        Click="DelRow_Click" Tag="{Binding}"
                                        IsEnabled="{Binding CanEditRow}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                            <Setter Property="Content" Value="删除"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ConfirmingDelete}" Value="True">
                                                    <Setter Property="Content" Value="确认删除"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
        <DockPanel Grid.Row="4" Margin="0,8,0,0">
            <Button x:Name="SaveCloseBtn" DockPanel.Dock="Right" Content="保存并关闭" Style="{StaticResource PrimaryButton}"
                    MinWidth="88" Click="SaveClose_Click" ToolTip="保存并关闭"/>
            <Button x:Name="SaveBtn" DockPanel.Dock="Right" Content="保存" MinWidth="64" Margin="0,0,8,0"
                    Click="Save_Click" ToolTip="保存 (Ctrl+S)"/>
            <CheckBox x:Name="AutoSaveCheck" DockPanel.Dock="Right" Content="自动保存" Margin="0,0,12,0"
                      VerticalAlignment="Center" Checked="AutoSave_Changed" Unchecked="AutoSave_Changed"
                      ToolTip="勾选后修改会自动写入。锁定时即使勾选也不会自动保存。"/>
            <CheckBox x:Name="ReadOnlyCheck" DockPanel.Dock="Right" Content="锁定" Margin="0,0,12,0"
                      VerticalAlignment="Center" Checked="ReadOnly_Changed" Unchecked="ReadOnly_Changed"
                      ToolTip="勾选后只能查看，不能编辑或删除。锁定时即使勾选自动保存也不会写入。"/>
            <TextBlock x:Name="StatusText" DockPanel.Dock="Left"
                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"
                       VerticalAlignment="Center" TextWrapping="Wrap"
                       Text="加密行不显示明文。取消勾选需验证查看密码。忘记密码无法找回。"/>
            <TextBlock x:Name="SaveHint" HorizontalAlignment="Right" Margin="8,0"
                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"
                       VerticalAlignment="Center" Text="未保存"/>
        </DockPanel>
    </Grid>
</UserControl>
