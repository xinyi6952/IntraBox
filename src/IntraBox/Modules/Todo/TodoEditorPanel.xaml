<UserControl x:Class="IntraBox.Modules.Todo.TodoEditorPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="RteBtn" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="MinWidth" Value="28"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="200"/>
        </Style>
        <Style x:Key="ColorDot" TargetType="Button">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="MinWidth" Value="16"/>
            <Setter Property="MinHeight" Value="16"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Width="14" Height="14" CornerRadius="7"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="bd" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  CanContentScroll="False" Padding="0,0,4,0">
    <StackPanel Margin="0,0,8,8">
            <TextBlock Text="任务 ID" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <CheckBox x:Name="AutoIdCheck" Content="自动生成" IsChecked="True" Margin="0,0,0,6"
                      Checked="AutoId_Changed" Unchecked="AutoId_Changed"/>
            <Grid Margin="0,0,0,12">
                <TextBox x:Name="IdBox" IsReadOnly="True" TextChanged="IdBox_TextChanged"/>
                <TextBlock x:Name="IdHint" Text="可填写内网工单号或其它系统中的任务编号"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           IsHitTestVisible="False" VerticalAlignment="Center" Margin="10,0,0,0"
                           Visibility="Collapsed"/>
            </Grid>

            <TextBlock Text="优先级" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <ComboBox x:Name="PriorityCombo" Width="140" HorizontalAlignment="Left" Margin="0,0,0,12">
                <ComboBoxItem Content="低"/>
                <ComboBoxItem Content="中" IsSelected="True"/>
                <ComboBoxItem Content="高"/>
            </ComboBox>

            <TextBlock Text="计划完成时间" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <WrapPanel Margin="0,0,0,4">
                <DatePicker x:Name="DueDate" Width="168" Margin="0,0,8,6" SelectedDateChanged="DueDate_Changed"/>
                <ComboBox x:Name="DueHourCombo" Width="64" MinHeight="32" Margin="0,0,4,6" SelectionChanged="DueTime_Changed"/>
                <TextBlock Text=":" VerticalAlignment="Center" Margin="0,0,4,6"/>
                <ComboBox x:Name="DueMinuteCombo" Width="64" MinHeight="32" Margin="0,0,8,6" SelectionChanged="DueTime_Changed"/>
                <Button x:Name="ClearDueBtn" Content="清除日期" Margin="0,0,0,6" Click="ClearDue_Click"/>
            </WrapPanel>
            <TextBlock x:Name="DueHint" Text="计划完成时间不能早于当前时间"
                       FontSize="12" Margin="0,0,0,12"
                       Foreground="{DynamicResource DangerBrush}" Visibility="Collapsed"/>

            <StackPanel x:Name="RemindPanel">
                <TextBlock Text="提醒频次" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <ComboBox x:Name="RemindKindCombo" Width="240" MinHeight="32"
                          HorizontalAlignment="Left" Margin="0,0,0,8"
                          SelectionChanged="RemindKind_Changed">
                    <ComboBoxItem Content="每天"/>
                    <ComboBoxItem Content="关闭"/>
                    <ComboBoxItem Content="仅工作日"/>
                    <ComboBoxItem Content="每周"/>
                    <ComboBoxItem Content="每 N 天"/>
                    <ComboBoxItem Content="仅到期当天"/>
                </ComboBox>
                <WrapPanel Margin="0,0,0,8">
                    <TextBlock Text="时刻" VerticalAlignment="Center" Margin="0,0,8,6"/>
                    <ComboBox x:Name="RemindHourCombo" Width="64" MinHeight="32" Margin="0,0,4,6"/>
                    <TextBlock Text=":" VerticalAlignment="Center" Margin="0,0,4,6"/>
                    <ComboBox x:Name="RemindMinuteCombo" Width="64" MinHeight="32" Margin="0,0,12,6"/>
                    <TextBlock x:Name="RemindExtraLabel" VerticalAlignment="Center" Margin="0,0,8,6"/>
                    <ComboBox x:Name="RemindWeekCombo" Width="80" MinHeight="32" Margin="0,0,8,6" Visibility="Collapsed">
                        <ComboBoxItem Content="日"/><ComboBoxItem Content="一"/><ComboBoxItem Content="二"/>
                        <ComboBoxItem Content="三"/><ComboBoxItem Content="四"/><ComboBoxItem Content="五"/>
                        <ComboBoxItem Content="六"/>
                    </ComboBox>
                    <TextBox x:Name="RemindNBox" Width="50" MinHeight="32" Margin="0,0,0,6" Visibility="Collapsed" Text="2"/>
                </WrapPanel>
                <WrapPanel x:Name="RemindRepeatPanel" Margin="0,0,0,12">
                    <TextBlock Text="到点后共" VerticalAlignment="Center" Margin="0,0,8,6"/>
                    <ComboBox x:Name="RemindTimesCombo" Width="56" MinHeight="32" Margin="0,0,8,6"/>
                    <TextBlock Text="次，每" VerticalAlignment="Center" Margin="0,0,8,6"/>
                    <ComboBox x:Name="RemindIntervalCombo" Width="64" MinHeight="32" Margin="0,0,8,6"/>
                    <TextBlock Text="分钟一次" VerticalAlignment="Center" Margin="0,0,0,6"/>
                </WrapPanel>
            </StackPanel>

        <Grid Margin="0,0,12,8" MinHeight="280" Height="320">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="任务详情" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <Border Grid.Row="1" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="4" Background="{DynamicResource EditorBackgroundBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="{DynamicResource PanelBgBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                            Padding="4,3">
                        <WrapPanel x:Name="RteToolbar" VerticalAlignment="Center">
                            <Button Style="{StaticResource RteBtn}" ToolTip="加粗 (Ctrl+B)"
                                    Command="EditingCommands.ToggleBold" CommandTarget="{Binding ElementName=DetailBox}">
                                <TextBlock Text="B" FontWeight="Bold" FontFamily="Times New Roman" FontSize="14"/>
                            </Button>
                            <Button Style="{StaticResource RteBtn}" ToolTip="斜体 (Ctrl+I)"
                                    Command="EditingCommands.ToggleItalic" CommandTarget="{Binding ElementName=DetailBox}">
                                <TextBlock Text="I" FontStyle="Italic" FontFamily="Times New Roman" FontSize="14"/>
                            </Button>
                            <Button Style="{StaticResource RteBtn}" ToolTip="下划线 (Ctrl+U)"
                                    Command="EditingCommands.ToggleUnderline" CommandTarget="{Binding ElementName=DetailBox}">
                                <TextBlock Text="U" FontFamily="Times New Roman" FontSize="14" TextDecorations="Underline"/>
                            </Button>
                            <Rectangle Width="1" Height="16" Fill="{DynamicResource BorderBrush}" Margin="4,0"/>
                            <Button Style="{StaticResource RteBtn}" ToolTip="项目符号"
                                    Command="EditingCommands.ToggleBullets" CommandTarget="{Binding ElementName=DetailBox}">
                                <Path Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.4"
                                      StrokeStartLineCap="Round" Width="12" Height="12" Stretch="Uniform"
                                      Data="M1,2.5 H2.5 M4,2.5 H11 M1,6 H2.5 M4,6 H11 M1,9.5 H2.5 M4,9.5 H11"/>
                            </Button>
                            <Button Style="{StaticResource RteBtn}" ToolTip="编号列表"
                                    Command="EditingCommands.ToggleNumbering" CommandTarget="{Binding ElementName=DetailBox}">
                                <TextBlock Text="1." FontSize="11" FontFamily="Segoe UI"/>
                            </Button>
                            <Rectangle Width="1" Height="16" Fill="{DynamicResource BorderBrush}" Margin="4,0"/>
                            <Button Style="{StaticResource RteBtn}" ToolTip="左对齐"
                                    Command="EditingCommands.AlignLeft" CommandTarget="{Binding ElementName=DetailBox}">
                                <Path Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.4"
                                      StrokeStartLineCap="Round" Width="12" Height="12" Stretch="Uniform"
                                      Data="M1,2.5 H11 M1,6 H8 M1,9.5 H11"/>
                            </Button>
                            <Button Style="{StaticResource RteBtn}" ToolTip="居中"
                                    Command="EditingCommands.AlignCenter" CommandTarget="{Binding ElementName=DetailBox}">
                                <Path Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.4"
                                      StrokeStartLineCap="Round" Width="12" Height="12" Stretch="Uniform"
                                      Data="M2,2.5 H10 M3.5,6 H8.5 M2,9.5 H10"/>
                            </Button>
                            <Button Style="{StaticResource RteBtn}" ToolTip="右对齐"
                                    Command="EditingCommands.AlignRight" CommandTarget="{Binding ElementName=DetailBox}">
                                <Path Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.4"
                                      StrokeStartLineCap="Round" Width="12" Height="12" Stretch="Uniform"
                                      Data="M1,2.5 H11 M4,6 H11 M1,9.5 H11"/>
                            </Button>
                            <Rectangle Width="1" Height="16" Fill="{DynamicResource BorderBrush}" Margin="4,0"/>
                            <ComboBox x:Name="FontCombo" Width="108" Height="28" Margin="2,0"
                                      FontSize="12" SelectionChanged="Font_Changed"/>
                            <ComboBox x:Name="SizeCombo" Width="56" Height="28" Margin="2,0"
                                      FontSize="12" SelectionChanged="Size_Changed"/>
                            <Rectangle Width="1" Height="16" Fill="{DynamicResource BorderBrush}" Margin="4,0"/>
                            <Button Style="{StaticResource ColorDot}" Background="{DynamicResource TextPrimaryBrush}"
                                    ToolTip="默认颜色" Click="Color_Click" Tag="default"/>
                            <Button Style="{StaticResource ColorDot}" Background="#E81123"
                                    ToolTip="红色" Click="Color_Click" Tag="#E81123"/>
                            <Button Style="{StaticResource ColorDot}" Background="#FF8C00"
                                    ToolTip="橙色" Click="Color_Click" Tag="#FF8C00"/>
                            <Button Style="{StaticResource ColorDot}" Background="#107C10"
                                    ToolTip="绿色" Click="Color_Click" Tag="#107C10"/>
                            <Button Style="{StaticResource ColorDot}" Background="#0078D4"
                                    ToolTip="蓝色" Click="Color_Click" Tag="#0078D4"/>
                            <Rectangle Width="1" Height="16" Fill="{DynamicResource BorderBrush}" Margin="4,0"/>
                            <Button Style="{StaticResource RteBtn}" Width="Auto" MinWidth="28" Padding="6,0"
                                    ToolTip="插入图片" Click="InsertImage_Click">
                                <Path Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.3"
                                      StrokeStartLineCap="Round" StrokeLineJoin="Round"
                                      Width="14" Height="12" Stretch="Uniform"
                                      Data="M1,11 L1,1 L13,1 L13,11 Z M1,8 L4.5,5 L7,7.5 L9,6 L13,10"/>
                            </Button>
                        </WrapPanel>
                    </Border>
                    <RichTextBox x:Name="DetailBox" Grid.Row="1" MinHeight="140"
                                 BorderThickness="0" Padding="10,8"
                                 VerticalScrollBarVisibility="Auto"
                                 AcceptsReturn="True" AcceptsTab="True"
                                 IsDocumentEnabled="False"
                                 FontFamily="Microsoft YaHei" FontSize="14"
                                 Background="{DynamicResource EditorBackgroundBrush}"
                                 Foreground="{DynamicResource EditorForegroundBrush}"
                                 CaretBrush="{DynamicResource TextPrimaryBrush}"
                                 SelectionChanged="DetailBox_SelectionChanged"
                                 PreviewDragOver="DetailBox_PreviewDragOver"
                                 Drop="DetailBox_Drop"
                                 AllowDrop="True"/>
                </Grid>
            </Border>
        </Grid>

            <TextBlock x:Name="CreatedAtText" FontSize="12" Margin="0,12,0,4"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
            <TextBlock x:Name="UpdatedAtText" FontSize="12" Margin="0,0,0,4"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
            <TextBlock x:Name="CompletedAtText" FontSize="12" Margin="0,0,0,0"
                       Foreground="{DynamicResource TextSecondaryBrush}" Visibility="Collapsed"/>
    </StackPanel>
    </ScrollViewer>
</UserControl>
