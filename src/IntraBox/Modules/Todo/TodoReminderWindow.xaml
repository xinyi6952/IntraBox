<Window x:Class="IntraBox.Modules.Todo.TodoReminderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="任务提醒" Width="360" SizeToContent="Height"
        WindowStartupLocation="Manual" ResizeMode="NoResize"
        WindowStyle="None" ShowInTaskbar="False" ShowActivated="False"
        Background="{DynamicResource WindowBgBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        BorderThickness="0"
        Topmost="True" FontSize="14"
        Loaded="Window_Loaded">
    <Grid>
        <Border BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2">
            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0,0,0,10">
                    <Button DockPanel.Dock="Right" Content="×" Width="28" Height="28" MinWidth="28" MinHeight="28"
                            Padding="0" FontSize="16" Background="Transparent" BorderThickness="0"
                            Foreground="{DynamicResource TextSecondaryBrush}" Click="Close_Click"/>
                    <TextBlock Text="任务提醒" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </DockPanel>
                <StackPanel Grid.Row="1" Margin="0,0,0,14">
                    <TextBlock x:Name="IdText" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,6"/>
                    <TextBlock x:Name="TitleText" TextWrapping="Wrap" Margin="0,0,0,6"/>
                    <TextBlock x:Name="DueText" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                    <TextBlock x:Name="MoreText" Margin="0,8,0,0" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap"/>
                </StackPanel>
                <WrapPanel Grid.Row="2" HorizontalAlignment="Right">
                    <Button Content="稍后 15 分钟" MinWidth="100" Margin="0,0,8,0" Click="Snooze_Click"/>
                    <Button Content="关闭" MinWidth="72" Style="{StaticResource PrimaryButton}" Click="Close_Click"/>
                </WrapPanel>
            </Grid>
        </Border>
        <Border x:Name="FlashOverlay" Background="{DynamicResource AccentBrush}"
                Opacity="0" IsHitTestVisible="False"/>
    </Grid>
</Window>
