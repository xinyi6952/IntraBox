<UserControl x:Class="IntraBox.Modules.CertDecode.CertDecodeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:IntraBox.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <WrapPanel Margin="0,0,0,8">
            <Button Content="打开证书文件" Style="{StaticResource PrimaryButton}" Margin="0,4,8,4" Click="Open_Click"/>
            <Button Content="解析粘贴内容" Margin="0,4,8,4" Click="Parse_Click"/>
            <Button Content="复制结果" Margin="0,4,8,4" Click="Copy_Click"/>
            <TextBlock Text="PFX 密码" VerticalAlignment="Center" Margin="8,4,4,4" Foreground="{DynamicResource TextSecondaryBrush}"/>
            <PasswordBox x:Name="PwdBox" Width="140" Margin="0,4,8,4"/>
            <TextBlock x:Name="MsgText" VerticalAlignment="Center" Margin="8,4,0,4"
                       Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
        </WrapPanel>
        <TextBlock Grid.Row="1" Text="粘贴 Base64 / PEM" Margin="0,0,0,4" Foreground="{DynamicResource TextSecondaryBrush}"/>
        <controls:CodeEditor x:Name="InputBox" Grid.Row="2"/>
        <TextBlock Grid.Row="3" Text="解析结果" Margin="0,8,0,4" Foreground="{DynamicResource TextSecondaryBrush}"/>
        <controls:CodeEditor x:Name="OutputBox" Grid.Row="4" IsReadOnly="True" CanMaximize="True"/>
    </Grid>
</UserControl>
