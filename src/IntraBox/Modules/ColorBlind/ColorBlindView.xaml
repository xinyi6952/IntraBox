<UserControl x:Class="IntraBox.Modules.ColorBlind.ColorBlindView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <WrapPanel Margin="0,0,0,8">
            <Button Content="打开图片" Style="{StaticResource PrimaryButton}" Margin="0,4,8,4" Click="Open_Click"/>
            <ComboBox x:Name="ModeCombo" Width="140" SelectedIndex="0" Margin="0,4,12,4">
                <ComboBoxItem Content="红绿色盲(红)"/>
                <ComboBoxItem Content="红绿色盲(绿)"/>
                <ComboBoxItem Content="蓝黄色盲"/>
                <ComboBoxItem Content="全色盲"/>
            </ComboBox>
            <Button Content="模拟" Margin="0,4,8,4" Click="Apply_Click"/>
            <Button Content="导出" Margin="0,4,8,4" Click="Save_Click"/>
            <TextBlock Text="或输入颜色" VerticalAlignment="Center" Margin="8,4,4,4" Foreground="{DynamicResource TextSecondaryBrush}"/>
            <TextBox x:Name="ColorBox" Width="90" Text="#E74C3C" Margin="0,4,8,4"/>
            <Rectangle x:Name="ColorPreview" Width="36" Height="22" Margin="0,4,8,4" Stroke="{DynamicResource BorderBrush}"/>
            <TextBlock x:Name="MsgText" VerticalAlignment="Center" Margin="8,4,0,4" Foreground="{DynamicResource TextSecondaryBrush}"/>
        </WrapPanel>
        <Image x:Name="Preview" Grid.Row="1" Stretch="Uniform"/>
    </Grid>
</UserControl>
