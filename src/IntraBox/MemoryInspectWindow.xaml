<Window x:Class="IntraBox.MemoryInspectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="内存占用" Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBgBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontSize="14">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="当前进程" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,12"/>
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" Text="工作集" Margin="0,0,0,6"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
            <TextBlock x:Name="WorkingText" Grid.Row="0" Grid.Column="1" Margin="0,0,0,6"/>
            <TextBlock Grid.Row="1" Grid.Column="0" Text="专用内存" Margin="0,0,0,6"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
            <TextBlock x:Name="PrivateText" Grid.Row="1" Grid.Column="1" Margin="0,0,0,6"/>
            <TextBlock Grid.Row="2" Grid.Column="0" Text="托管堆" Margin="0,0,0,6"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
            <TextBlock x:Name="ManagedText" Grid.Row="2" Grid.Column="1" Margin="0,0,0,6"/>
            <TextBlock Grid.Row="3" Grid.Column="0" Text="当前工具" Margin="0,0,0,6"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
            <TextBlock x:Name="ToolText" Grid.Row="3" Grid.Column="1" Margin="0,0,0,6" TextWrapping="Wrap"/>
            <TextBlock Grid.Row="4" Grid.Column="0" Text="剪贴板历史" Margin="0,0,0,6"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
            <TextBlock x:Name="ClipText" Grid.Row="4" Grid.Column="1" Margin="0,0,0,6"/>
        </Grid>
        <TextBlock Grid.Row="2" TextWrapping="Wrap" Margin="0,0,0,16" FontSize="12"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   Text="状态栏数字是工作集（任务管理器「内存」同一口径）。偏高常见于剪贴板里的原图、刚用过大文本工具。.NET 不会立刻把空闲页还给系统；点「回收内存」会强制 GC 并交还空闲页，随后用到时还会涨回来。"/>
        <DockPanel Grid.Row="3" LastChildFill="False">
            <TextBlock x:Name="MsgText" DockPanel.Dock="Left" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"
                       TextWrapping="Wrap" MaxWidth="220"/>
            <Button DockPanel.Dock="Right" Content="关闭" MinWidth="72" IsCancel="True" Click="Close_Click"/>
            <Button DockPanel.Dock="Right" Content="回收内存" MinWidth="88" Margin="0,0,10,0"
                    Style="{StaticResource PrimaryButton}" Click="Trim_Click"/>
        </DockPanel>
    </Grid>
</Window>
