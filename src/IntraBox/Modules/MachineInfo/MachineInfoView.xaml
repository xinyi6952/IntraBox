<UserControl x:Class="IntraBox.Modules.MachineInfo.MachineInfoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:IntraBox.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <WrapPanel Margin="0,0,0,8">
            <Button Content="刷新" Style="{StaticResource PrimaryButton}" Margin="0,4,8,4" Click="Refresh_Click"/>
            <Button x:Name="CopyBtn" Content="复制" Margin="0,4,8,4" Click="CopyBtn_Click">
                <Button.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="全部" Click="CopyAll_Click" Style="{StaticResource ContextMenuItemStyle}">
                            <MenuItem.Icon>
                                <Path Style="{StaticResource MenuIconPath}"
                                      Data="M5,3 L11,3 11,11 5,11 Z M3,5 L3,13 9,13"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="ipv4" Click="CopyIpv4_Click" Style="{StaticResource ContextMenuItemStyle}">
                            <MenuItem.Icon>
                                <Path Style="{StaticResource MenuIconPath}"
                                      Data="M5,3 L11,3 11,11 5,11 Z M3,5 L3,13 9,13"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="ipv6" Click="CopyIpv6_Click" Style="{StaticResource ContextMenuItemStyle}">
                            <MenuItem.Icon>
                                <Path Style="{StaticResource MenuIconPath}"
                                      Data="M5,3 L11,3 11,11 5,11 Z M3,5 L3,13 9,13"/>
                            </MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>
            <TextBlock x:Name="MsgText" VerticalAlignment="Center" Margin="8,4,0,4"
                       Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
        </WrapPanel>
        <controls:CodeEditor x:Name="OutputBox" Grid.Row="1" IsReadOnly="True" CanMaximize="True"/>
    </Grid>
</UserControl>
