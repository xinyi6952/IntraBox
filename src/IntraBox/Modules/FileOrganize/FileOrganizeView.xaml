<UserControl x:Class="IntraBox.Modules.FileOrganize.FileOrganizeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:IntraBox.Controls">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <controls:InverseBoolToVisConverter x:Key="InvBoolToVis"/>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <WrapPanel Margin="0,0,0,8">
            <TextBlock Text="源目录" VerticalAlignment="Center" Margin="0,4,8,4"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
            <TextBox x:Name="DirBox" Width="320" Margin="0,4,8,4"/>
            <Button Content="浏览…" Click="Browse_Click" Margin="0,4,12,4"/>
            <CheckBox x:Name="SubDirCheck" Content="包含子目录" VerticalAlignment="Center" Margin="0,4,12,4"/>
        </WrapPanel>
        <StackPanel Grid.Row="1" Margin="0,0,0,6">
            <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Text="每条规则：匹配条件 + 目标子目录。整理根目录为当天日期（yyyy-MM-dd），规则里的目标目录作为其子目录。例：规则填「图片」→ 源目录/2026-08-24/图片/文件.jpg。子目录仍可用 {ext} {type} {name}。切换匹配条件会清空条件值，避免类型对不上。"/>
            <TextBlock TextWrapping="Wrap"
                       Foreground="{DynamicResource WarningBrush}"
                       Text="预览时默认全部不勾选。只有勾选的文件会被移动，未勾选的保持原位，不会改动磁盘。"/>
        </StackPanel>
        <DataGrid x:Name="RuleGrid" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False"
                  HeadersVisibility="Column" BorderThickness="1" MinHeight="120"
                  EnableRowVirtualization="False">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="匹配条件" Width="150">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding KindChoices}"
                                      SelectedItem="{Binding KindName, UpdateSourceTrigger=PropertyChanged}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="条件值" Width="180" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid>
                                <TextBox Text="{Binding Pattern, UpdateSourceTrigger=PropertyChanged}"
                                         Visibility="{Binding IsDateKind, Converter={StaticResource InvBoolToVis}}"/>
                                <DatePicker SelectedDate="{Binding DateValue, UpdateSourceTrigger=PropertyChanged}"
                                            Visibility="{Binding IsDateKind, Converter={StaticResource BoolToVis}}"/>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="目标目录" Binding="{Binding TargetTemplate, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
        <WrapPanel Grid.Row="3" Margin="0,8,0,0">
            <Button Content="添加规则" Click="AddRule_Click" Margin="0,4,8,4"/>
            <Button Content="删除规则" Click="RemoveRule_Click" Margin="0,4,8,4"/>
            <Button Content="预览并执行" Style="{StaticResource PrimaryButton}" Click="Run_Click" Margin="0,4,8,4"/>
            <Button Content="撤销上次" Click="Undo_Click" Margin="0,4,8,4"/>
        </WrapPanel>
        <TextBlock x:Name="MsgText" Grid.Row="4" Margin="0,8,0,0" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextSecondaryBrush}"/>
    </Grid>
</UserControl>
