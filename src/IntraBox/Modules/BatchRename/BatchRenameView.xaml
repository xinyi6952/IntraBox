<UserControl x:Class="IntraBox.Modules.BatchRename.BatchRenameView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <WrapPanel Margin="0,0,0,8">
            <Button Content="选文件" Style="{StaticResource PrimaryButton}" Margin="0,4,8,4" Click="PickFiles_Click"/>
            <Button Content="选目录" Margin="0,4,8,4" Click="PickDir_Click"/>
            <CheckBox x:Name="SubDirCheck" Content="含子目录" Margin="0,4,12,4"/>
            <TextBlock Text="前缀" VerticalAlignment="Center" Margin="8,4,4,4" Foreground="{DynamicResource TextSecondaryBrush}"/>
            <TextBox x:Name="PrefixBox" Width="80" Margin="0,4,8,4"/>
            <TextBlock Text="后缀" VerticalAlignment="Center" Margin="0,4,4,4" Foreground="{DynamicResource TextSecondaryBrush}"/>
            <TextBox x:Name="SuffixBox" Width="80" Margin="0,4,8,4"/>
            <TextBlock Text="序号起" VerticalAlignment="Center" Margin="0,4,4,4" Foreground="{DynamicResource TextSecondaryBrush}"/>
            <TextBox x:Name="SeqBox" Width="48" Text="0" Margin="0,4,8,4"/>
            <TextBlock Text="查找" VerticalAlignment="Center" Margin="0,4,4,4" Foreground="{DynamicResource TextSecondaryBrush}"/>
            <TextBox x:Name="FindBox" Width="90" Margin="0,4,8,4"/>
            <TextBlock Text="替换" VerticalAlignment="Center" Margin="0,4,4,4" Foreground="{DynamicResource TextSecondaryBrush}"/>
            <TextBox x:Name="ReplaceBox" Width="90" Margin="0,4,8,4"/>
            <CheckBox x:Name="RegexCheck" Content="正则" Margin="0,4,12,4"/>
            <Button Content="预览" Margin="0,4,8,4" Click="Preview_Click"/>
            <Button Content="执行" Margin="0,4,8,4" Click="Run_Click"/>
            <Button Content="撤销" Margin="0,4,8,4" Click="Undo_Click"/>
            <TextBlock x:Name="MsgText" VerticalAlignment="Center" Margin="8,4,0,4"
                       Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
        </WrapPanel>
        <TextBlock x:Name="PathText" Grid.Row="1" Margin="0,0,0,6" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextSecondaryBrush}"/>
        <DataGrid x:Name="PreviewGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="原文件名" Binding="{Binding OldName}" Width="*"/>
                <DataGridTextColumn Header="新文件名" Binding="{Binding NewName}" Width="*"/>
                <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="140"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
