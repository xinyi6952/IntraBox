<UserControl x:Class="IntraBox.Modules.EnvVars.EnvVarsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:IntraBox.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                   Foreground="{DynamicResource WarningBrush}"
                   Text="只改用户级变量。系统与进程只读。改完后已打开的程序（含 IntraBox）不会立刻更新，需要新开终端或重启对应软件。"/>
        <WrapPanel Grid.Row="1" Margin="0,0,0,8">
            <RadioButton x:Name="ScopeUser" Content="用户" GroupName="EnvScope" IsChecked="True"
                         VerticalAlignment="Center" Margin="0,4,16,4" Checked="Scope_Checked"/>
            <RadioButton x:Name="ScopeMachine" Content="系统" GroupName="EnvScope"
                         VerticalAlignment="Center" Margin="0,4,16,4" Checked="Scope_Checked"/>
            <RadioButton x:Name="ScopeProcess" Content="进程" GroupName="EnvScope"
                         VerticalAlignment="Center" Margin="0,4,16,4" Checked="Scope_Checked"/>
        </WrapPanel>
        <WrapPanel Grid.Row="2" Margin="0,0,0,8">
            <Button x:Name="ReloadBtn" Content="刷新" Margin="0,4,8,4" Click="Reload_Click"/>
            <Button x:Name="NewBtn" Content="新建" Margin="0,4,8,4" Click="New_Click"/>
            <Button x:Name="SaveBtn" Content="保存" Style="{StaticResource PrimaryButton}" Margin="0,4,8,4" Click="Save_Click"/>
            <Button x:Name="DeleteBtn" Content="删除" Margin="0,4,8,4" Click="Delete_Click"/>
            <Button Content="复制名称" Margin="0,4,8,4" Click="CopyName_Click"/>
            <Button Content="复制值" Margin="0,4,8,4" Click="CopyValue_Click"/>
            <controls:GridFilterBar x:Name="FilterBar" VerticalAlignment="Center" Margin="8,4,0,4"/>
        </WrapPanel>
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <DataGrid x:Name="VarGrid" AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" HeadersVisibility="Column" BorderThickness="1"
                      SelectionChanged="VarGrid_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="180"/>
                    <DataGridTextColumn Header="值" Binding="{Binding Preview}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
            <GridSplitter Grid.Column="1" Width="8"/>
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <WrapPanel Margin="0,0,0,8">
                    <controls:RequiredLabel Text="名称" VerticalAlignment="Center" Margin="0,4,8,4"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBox x:Name="NameBox" Width="240" Margin="0,4,8,4"/>
                </WrapPanel>
                <TextBox x:Name="ValueBox" Grid.Row="1" AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         FontFamily="Consolas" LostFocus="ValueBox_LostFocus"/>
                <DockPanel x:Name="PathPanel" Grid.Row="2" Margin="0,8,0,0" Visibility="Collapsed" LastChildFill="True">
                    <TextBlock DockPanel.Dock="Top" Margin="0,0,0,6"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="PATH 条目。不存在的目录仍会保存。"/>
                    <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <Button x:Name="PathUpBtn" Content="上移" Margin="0,0,8,0" Click="PathUp_Click"/>
                        <Button x:Name="PathDownBtn" Content="下移" Margin="0,0,8,0" Click="PathDown_Click"/>
                        <Button x:Name="PathAddBtn" Content="添加目录" Margin="0,0,8,0" Click="PathAdd_Click"/>
                        <Button x:Name="PathDelBtn" Content="移除" Click="PathDel_Click"/>
                    </WrapPanel>
                    <ListBox x:Name="PathList" Height="140" BorderThickness="1"/>
                </DockPanel>
            </Grid>
        </Grid>
        <TextBlock x:Name="HintText" Grid.Row="4" Margin="0,8,0,0" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextSecondaryBrush}"/>
        <TextBlock x:Name="MsgText" Grid.Row="5" Margin="0,8,0,0" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextSecondaryBrush}"/>
    </Grid>
</UserControl>
