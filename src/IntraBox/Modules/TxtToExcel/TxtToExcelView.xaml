<UserControl x:Class="IntraBox.Modules.TxtToExcel.TxtToExcelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:IntraBox.Controls">
    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="1.5*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <WrapPanel x:Name="ToolbarPanel" Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="分列方式" VerticalAlignment="Center" Margin="0,4,8,4"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
            <ComboBox x:Name="ModeCombo" MinWidth="110" Margin="0,4,12,4" SelectedIndex="0" SelectionChanged="OnOptionChanged"
                      ToolTip="对齐 WPS 智能分列：分隔符、按中英数切换、按关键字、固定宽度">
                <ComboBoxItem Content="分隔符"/>
                <ComboBoxItem Content="按文本类型"/>
                <ComboBoxItem Content="按关键字"/>
                <ComboBoxItem Content="固定宽度"/>
            </ComboBox>
            <TextBlock x:Name="SepLabel" Text="分隔符" VerticalAlignment="Center" Margin="0,4,8,4"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
            <ComboBox x:Name="SepCombo" MinWidth="110" Margin="0,4,8,4" SelectedIndex="0" SelectionChanged="OnOptionChanged">
                <ComboBoxItem Content="自动检测"/>
                <ComboBoxItem Content="逗号"/>
                <ComboBoxItem Content="制表符"/>
                <ComboBoxItem Content="分号"/>
                <ComboBoxItem Content="自定义"/>
                <ComboBoxItem Content="空格"/>
            </ComboBox>
            <TextBox x:Name="CustomSepBox" Width="72" Margin="0,4,8,4" Visibility="Collapsed"
                     ToolTip="自定义分隔符，可多字符，如 || 或中文逗号 ，" TextChanged="OnOptionChanged"/>
            <CheckBox x:Name="ConsecutiveCheck" Content="连续分隔符视为一个" VerticalAlignment="Center"
                      Margin="0,4,12,4" Checked="OnOptionChanged" Unchecked="OnOptionChanged"
                      ToolTip="空格分列时建议勾选，避免连续空格产生空列"/>
            <TextBlock x:Name="KeywordLabel" Text="关键字" VerticalAlignment="Center" Margin="0,4,8,4"
                       Foreground="{DynamicResource TextSecondaryBrush}" Visibility="Collapsed"/>
            <TextBox x:Name="KeywordBox" Width="140" Margin="0,4,12,4" Visibility="Collapsed"
                     ToolTip="在关键字处拆分；多个用 | 分隔，如 省|市|区" TextChanged="OnOptionChanged"/>
            <TextBlock x:Name="WidthLabel" Text="宽度" VerticalAlignment="Center" Margin="0,4,8,4"
                       Foreground="{DynamicResource TextSecondaryBrush}" Visibility="Collapsed"/>
            <TextBox x:Name="WidthBox" Width="120" Margin="0,4,12,4" Visibility="Collapsed"
                     ToolTip="每段字符数，逗号分隔，如身份证 6,8,3,1" TextChanged="OnOptionChanged"/>
            <Button Content="选文件" Margin="0,4,8,4" Click="LoadFile_Click"/>
            <Button Content="导出 Excel" Style="{StaticResource PrimaryButton}" Margin="0,4,8,4" Click="Export_Click"/>
            <TextBlock x:Name="MsgText" VerticalAlignment="Center" Margin="8,4,0,4"
                       Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
        </WrapPanel>

        <controls:CodeEditor x:Name="InputBox" Grid.Row="1"/>

        <Grid x:Name="PreviewHost" Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <DockPanel Margin="0,8,0,4">
                <Button x:Name="MaxBtn" DockPanel.Dock="Right" Width="22" Height="22"
                        MinWidth="22" MinHeight="22" Padding="0" Click="MaxBtn_Click"
                        Background="Transparent" BorderThickness="0" ToolTip="最大化预览">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="Transparent" CornerRadius="3" Padding="3">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource ButtonHoverBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <Grid Width="12" Height="12">
                        <Path x:Name="IconExpand" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.5"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Data="M2,10 L10,2 M5,2 L10,2 L10,7"/>
                        <Path x:Name="IconRestore" Visibility="Collapsed"
                              Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.5"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Data="M10,2 L2,10 M2,5 L2,10 L7,10"/>
                    </Grid>
                </Button>
                <Button x:Name="CopyBtn" DockPanel.Dock="Right" Content="复制" Margin="0,0,8,0" Padding="8,2"
                        Click="Copy_Click" ToolTip="复制预览表格。粘贴到 Excel / WPS 时已分列，文本列保留 00001 等原文"/>
                <TextBlock Text="预览" VerticalAlignment="Center" Margin="0,0,12,0"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                <TextBlock Text="点击列标题或右键单元格设置该列格式（默认文本）"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
            </DockPanel>
            <DataGrid x:Name="PreviewGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                      HeadersVisibility="Column" CanUserAddRows="False" CanUserSortColumns="False"
                      BorderThickness="1" FontSize="12"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      PreviewMouseLeftButtonUp="PreviewGrid_PreviewMouseLeftButtonUp"
                      MouseRightButtonUp="PreviewGrid_MouseRightButtonUp"/>
        </Grid>
    </Grid>
</UserControl>
