<?xml version="1.0" encoding="utf-8"?>
<!--
  IntraBox.Tests —— MSTest 单元测试项目，引用主项目 IntraBox。
  用于对「确定性逻辑」（格式化/哈希/编解码/转换等）做自动化回归。
-->
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />

  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <ProjectGuid>{A1B2C3D4-0000-4000-8000-000000000001}</ProjectGuid>
    <OutputType>Library</OutputType>
    <RootNamespace>IntraBox.Tests</RootNamespace>
    <AssemblyName>IntraBox.Tests</AssemblyName>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <FileAlignment>512</FileAlignment>
    <LangVersion>7.3</LangVersion>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <!-- 与主项目对齐 64 位，消除 MSB3270 处理器架构不匹配警告 -->
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Data" />
  </ItemGroup>

  <ItemGroup>
    <!-- MSTest 测试框架与适配器 -->
    <PackageReference Include="MSTest.TestFramework" Version="2.2.10" />
    <PackageReference Include="MSTest.TestAdapter" Version="2.2.10" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\IntraBox\IntraBox.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="**\*.cs" Exclude="obj\**;bin\**" />
  </ItemGroup>

  <!-- 经典 csproj 不自动执行 NuGet 的 build 目标，需手动把 MSTest 适配器 DLL 复制到输出目录，
       否则 vstest.console 无法发现测试。 -->
  <Target Name="CopyMSTestAdapter" AfterTargets="Build">
    <ItemGroup>
      <_AdapterFiles Include="$(UserProfile)\.nuget\packages\mstest.testadapter\2.2.10\build\_common\*.dll" />
      <_AdapterFiles Include="$(UserProfile)\.nuget\packages\mstest.testadapter\2.2.10\build\net46\*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(_AdapterFiles)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
  </Target>

  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
