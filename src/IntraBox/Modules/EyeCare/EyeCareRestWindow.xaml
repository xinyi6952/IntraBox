<Window x:Class="IntraBox.Modules.EyeCare.EyeCareRestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="用眼提醒" Width="360" SizeToContent="Height"
        WindowStartupLocation="Manual" ResizeMode="NoResize"
        WindowStyle="None" ShowInTaskbar="False" ShowActivated="False"
        Background="{DynamicResource WindowBgBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        BorderThickness="0"
        Topmost="True" FontSize="14"
        Loaded="Window_Loaded">
    <Border BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2">
        <StackPanel Margin="16">
            <TextBlock Text="用眼提醒" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10"/>
            <TextBlock TextWrapping="Wrap" Margin="0,0,0,14"
                       Text="看向约 6 米外 20 秒，让睫状肌放松（20-20-20）。"/>
            <Button Content="知道了" HorizontalAlignment="Right" MinWidth="88"
                    Style="{StaticResource PrimaryButton}" Click="Ok_Click"/>
        </StackPanel>
    </Border>
</Window>
