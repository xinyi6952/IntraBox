<UserControl x:Class="IntraBox.Modules.ScreenRuler.ScreenRulerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"
                   Foreground="{DynamicResource TextPrimaryBrush}" Text="屏幕标尺"/>
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" Foreground="{DynamicResource TextSecondaryBrush}"
                   Text="全屏十字线测量像素距离。H 水平、V 垂直、R 矩形（宽×高），并按屏幕 DPI 换算厘米/英寸。默认热键 Ctrl+Shift+M。"/>
        <Button Content="打开标尺" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"
                Click="Open_Click" Margin="0,0,0,8"/>
        <TextBlock x:Name="HotkeyHint" Foreground="{DynamicResource TextSecondaryBrush}"/>
    </StackPanel>
</UserControl>
