<UserControl x:Class="IntraBox.Modules.Launcher.LauncherView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="FavCellText" TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="RowOpBtn" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="24"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>
    <UserControl.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Save" Executed="SaveCommand_Executed"/>
    </UserControl.CommandBindings>
    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <WrapPanel Grid.Row="0" Margin="0,0,0,8">
            <Button x:Name="NewBtn" Content="新增" Style="{StaticResource PrimaryButton}" Margin="0,4,8,4" Click="NewBtn_Click">
                <Button.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="新增收藏" Click="NewFav_Click" Style="{StaticResource ContextMenuItemStyle}">
                            <MenuItem.Icon>
                                <Path Style="{StaticResource MenuIconPath}" Data="M8,3 L8,13 M3,8 L13,8"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="新增目录" Click="NewCat_Click" Style="{StaticResource ContextMenuItemStyle}">
                            <MenuItem.Icon>
                                <Path Style="{StaticResource MenuIconPath}" Data="M3,4 L8,4 8,12 3,12 Z M8,6 L13,6 13,12 8,12"/>
                            </MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>
            <TextBox x:Name="SearchBox" Width="200" MinHeight="32" Margin="0,4,8,4"
                     ToolTip="搜索名称或目标"
                     TextChanged="Search_Changed"/>
            <TextBlock x:Name="MsgText" VerticalAlignment="Center" Margin="8,4,0,4"
                       Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
        </WrapPanel>

        <Grid Grid.Row="1">
            <ListView x:Name="FavList" BorderThickness="1"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      SizeChanged="FavList_SizeChanged"
                      MouseLeftButtonUp="FavList_MouseLeftButtonUp"
                      MouseDoubleClick="FavList_MouseDoubleClick">
                <ListView.ContextMenu>
                    <ContextMenu Opened="ListMenu_Opened" Closed="ListMenu_Closed">
                        <MenuItem x:Name="MenuOpenItem" Header="打开" Click="MenuOpen_Click" Style="{StaticResource ContextMenuItemStyle}">
                            <MenuItem.Icon>
                                <Path Style="{StaticResource MenuIconPath}" Data="M3,8 L8,3 13,8 M8,3 L8,13"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem x:Name="MenuMoveItem" Header="移动" Click="MenuMove_Click" Style="{StaticResource ContextMenuItemStyle}">
                            <MenuItem.Icon>
                                <Path Style="{StaticResource MenuIconPath}" Data="M3,8 L8,3 13,8 M8,3 L8,8 M3,12 L13,12"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem x:Name="MenuAddFavItem" Header="新增收藏" Click="MenuAddFav_Click" Style="{StaticResource ContextMenuItemStyle}">
                            <MenuItem.Icon>
                                <Path Style="{StaticResource MenuIconPath}" Data="M8,3 L8,13 M3,8 L13,8"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem x:Name="MenuAddCatItem" Header="新增目录" Click="MenuAddCat_Click" Style="{StaticResource ContextMenuItemStyle}">
                            <MenuItem.Icon>
                                <Path Style="{StaticResource MenuIconPath}" Data="M3,4 L8,4 8,12 3,12 Z M8,6 L13,6 13,12 8,12"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="置顶" Click="MenuPin_Click" Style="{StaticResource ContextMenuItemStyle}">
                            <MenuItem.Icon>
                                <Path Style="{StaticResource MenuIconPath}" Data="M8,2 L8,10 M5,6 L8,2 11,6"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="取消置顶" Click="MenuUnpin_Click" Style="{StaticResource ContextMenuItemStyle}">
                            <MenuItem.Icon>
                                <Path Style="{StaticResource MenuIconPath}" Data="M8,2 L8,10 M5,6 L8,10 11,6"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="编辑" Click="MenuEdit_Click" Style="{StaticResource ContextMenuItemStyle}">
                            <MenuItem.Icon>
                                <Path Style="{StaticResource MenuIconPath}" Data="M3,13 L5,15 13,7 11,5 Z M12,4 L14,6"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="复制" Click="MenuDup_Click" Style="{StaticResource ContextMenuItemStyle}">
                            <MenuItem.Icon>
                                <Path Style="{StaticResource MenuIconPath}" Data="M5,3 L11,3 11,11 5,11 Z M3,5 L3,13 9,13"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="删除" Click="MenuDelete_Click" Style="{StaticResource ContextMenuItemStyle}">
                            <MenuItem.Icon>
                                <Path Style="{StaticResource MenuIconPath}" Data="M4,4 L12,12 M12,4 L4,12"/>
                            </MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </ListView.ContextMenu>
                <ListView.View>
                    <GridView AllowsColumnReorder="False">
                        <GridViewColumn Header="名称" Width="200">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid Margin="{Binding Indent}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="18"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Width="18" Height="18" MinWidth="18" MinHeight="18" Padding="0"
                                                FontSize="11" Click="Expand_Click"
                                                Visibility="{Binding ExpanderVisibility}"
                                                Content="{Binding ExpanderGlyph}" ToolTip="展开/折叠"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" Style="{StaticResource FavCellText}"
                                                   ToolTip="{Binding Hint}" Margin="4,0,0,0"/>
                                    </Grid>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="类型" Width="80">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding KindText}" Style="{StaticResource FavCellText}"
                                               ToolTip="{Binding KindText}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="目标" Width="180">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Target}" Style="{StaticResource FavCellText}"
                                               ToolTip="{Binding Target}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="打开方式" Width="100">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding OpenWithText}" Style="{StaticResource FavCellText}"
                                               ToolTip="{Binding OpenWithText}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="置顶" Width="52">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding PinText}" Style="{StaticResource FavCellText}"
                                               Foreground="{DynamicResource AccentBrush}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="操作" Width="180">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="打开" Style="{StaticResource RowOpBtn}"
                                                Visibility="{Binding OpenOpsVisibility}" Click="OpOpen_Click"/>
                                        <Button Content="移动" Style="{StaticResource RowOpBtn}"
                                                Visibility="{Binding MoveOpsVisibility}" Click="OpMove_Click"/>
                                        <Button Content="删除" Style="{StaticResource RowOpBtn}"
                                                Visibility="{Binding DeleteOpsVisibility}" Click="OpDelete_Click"/>
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </Grid>

        <Grid x:Name="DrawerHost" Grid.Row="0" Grid.RowSpan="2" Panel.ZIndex="10" Visibility="Collapsed">
                <Border x:Name="DrawerMask" Background="#99000000" MouseLeftButtonDown="DrawerMask_Click"/>
                <Border x:Name="DrawerPanel" HorizontalAlignment="Right"
                        MinWidth="0"
                        Background="{DynamicResource PanelBgBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" Margin="16,12">
                            <Button DockPanel.Dock="Right" Content="×" Width="32" Height="32" MinWidth="32"
                                    Padding="0" Click="DrawerClose_Click" ToolTip="关闭"/>
                            <Button x:Name="DrawerMaxBtn" DockPanel.Dock="Right" Width="32" Height="32"
                                    MinWidth="32" Padding="0" Margin="0,0,4,0"
                                    Click="DrawerMax_Click" ToolTip="最大化">
                                <Grid Width="12" Height="12">
                                    <Path x:Name="IconExpand" Stroke="{DynamicResource TextSecondaryBrush}"
                                          StrokeThickness="1.5" StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          Data="M2,10 L10,2 M5,2 L10,2 L10,7"/>
                                    <Path x:Name="IconRestore" Visibility="Collapsed"
                                          Stroke="{DynamicResource TextSecondaryBrush}"
                                          StrokeThickness="1.5" StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          Data="M10,2 L2,10 M2,5 L2,10 L7,10"/>
                                </Grid>
                            </Button>
                            <TextBlock x:Name="DrawerTitle" Text="收藏" FontSize="16" FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </DockPanel>
                        <ScrollViewer Grid.Row="1" Margin="16,0,4,0" VerticalScrollBarVisibility="Auto">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="名称" VerticalAlignment="Center" Margin="0,0,12,10"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBox x:Name="NameBox" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,10"
                                         TextChanged="Field_Changed"/>
                                <StackPanel x:Name="FavFields" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="类型" VerticalAlignment="Center" Margin="0,0,12,10"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <ComboBox x:Name="KindCombo" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,10"
                                                  SelectionChanged="KindCombo_SelectionChanged">
                                            <ComboBoxItem Content="程序" Tag="app"/>
                                            <ComboBoxItem Content="文件夹" Tag="folder"/>
                                            <ComboBoxItem Content="文件" Tag="file"/>
                                            <ComboBoxItem Content="内网地址" Tag="url"/>
                                        </ComboBox>
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="目标" VerticalAlignment="Center" Margin="0,0,12,10"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBox x:Name="TargetBox" Grid.Row="1" Grid.Column="1" Margin="0,0,8,10"
                                                 TextChanged="Target_Changed"/>
                                        <Button Grid.Row="1" Grid.Column="2" Content="浏览…" Margin="0,0,0,10" Click="Browse_Click"/>
                                        <StackPanel x:Name="OpenWithRow" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Visibility="Collapsed">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="打开方式" VerticalAlignment="Center" Margin="0,0,12,4"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                <TextBox x:Name="OpenWithBox" Grid.Column="1" Margin="0,0,8,4"
                                                         ToolTip="留空则使用系统默认打开方式"
                                                         TextChanged="Field_Changed"/>
                                                <Button Grid.Column="2" Content="浏览…" Margin="0,0,0,4" Click="BrowseOpenWith_Click"/>
                                            </Grid>
                                            <TextBlock x:Name="DefaultHandlerHint" Margin="0,0,0,10" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,10">
                                    <CheckBox x:Name="ConfirmOpenCheck" Content="打开前二次确认"
                                              Margin="0,0,0,8" IsChecked="True"
                                              ToolTip="防止误触。仅对程序类型有效，默认勾选。"
                                              Checked="Field_Changed" Unchecked="Field_Changed"/>
                                    <CheckBox x:Name="PinCheck" Content="置顶"
                                              Checked="Field_Changed" Unchecked="Field_Changed"/>
                                </StackPanel>
                                <TextBlock x:Name="DrawerHint" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3"
                                           TextWrapping="Wrap" VerticalAlignment="Top" Margin="0,0,0,8"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </Grid>
                        </ScrollViewer>
                        <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                                Padding="16,10">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Content="保存" Click="Save_Click" Margin="0,0,8,0" ToolTip="保存 (Ctrl+S)"/>
                                    <Button Content="保存并关闭" Style="{StaticResource PrimaryButton}" Click="SaveClose_Click"/>
                                </StackPanel>
                                <TextBlock x:Name="DrawerMsg" VerticalAlignment="Center" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
    </Grid>
</UserControl>
