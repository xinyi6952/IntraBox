<UserControl x:Class="IntraBox.Modules.PortTest.PortTestView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <WrapPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="主机" VerticalAlignment="Center" Margin="0,4,8,4"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
            <TextBox x:Name="HostBox" MinWidth="180" Margin="0,4,12,4"/>
            <TextBlock Text="端口" VerticalAlignment="Center" Margin="0,4,8,4"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
            <TextBox x:Name="PortBox" Width="80" Margin="0,4,12,4"/>
            <CheckBox x:Name="PingCheck" Content="Ping" Margin="0,4,12,4"/>
            <Button Content="测试" Style="{StaticResource PrimaryButton}" Margin="0,4,8,4" Click="Test_Click"/>
            <TextBlock x:Name="MsgText" VerticalAlignment="Center" Margin="8,4,0,4"
                       Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap"/>
        </WrapPanel>

        <ListBox x:Name="ResultList" Grid.Row="1" FontFamily="Consolas"/>
    </Grid>
</UserControl>
