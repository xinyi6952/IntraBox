<UserControl x:Class="IntraBox.Modules.PortList.PortListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                   Foreground="{DynamicResource WarningBrush}"
                   Text="结束进程会关闭对应程序及其网络连接，可能影响业务或安全软件；系统进程通常需要管理员权限。请确认后再操作。"/>
        <WrapPanel Grid.Row="1" Margin="0,0,0,8">
            <Button Content="刷新" Style="{StaticResource PrimaryButton}" Margin="0,4,8,4" Click="Refresh_Click"/>
            <TextBlock Text="筛选" VerticalAlignment="Center" Margin="8,4,8,4"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
            <TextBox x:Name="FilterBox" Width="180" Margin="0,4,12,4" TextChanged="FilterBox_TextChanged"/>
            <Button Content="复制选中" Margin="0,4,8,4" Click="Copy_Click"/>
            <Button Content="结束进程" Margin="0,4,8,4" Click="Kill_Click"/>
            <TextBlock x:Name="MsgText" VerticalAlignment="Center" Margin="8,4,0,4"
                       Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
        </WrapPanel>

        <DataGrid x:Name="ResultGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" HeadersVisibility="Column" BorderThickness="1"
                  SelectionMode="Extended">
            <DataGrid.Columns>
                <DataGridTextColumn Header="协议" Binding="{Binding Protocol}" Width="70"/>
                <DataGridTextColumn Header="本地地址" Binding="{Binding LocalAddress}" Width="180"/>
                <DataGridTextColumn Header="远程地址" Binding="{Binding RemoteAddress}" Width="180"/>
                <DataGridTextColumn Header="状态" Binding="{Binding State}" Width="110"/>
                <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="80"/>
                <DataGridTextColumn Header="进程名" Binding="{Binding ProcessName}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock x:Name="CountText" Grid.Row="3" Margin="0,8,0,0"
                   Foreground="{DynamicResource TextSecondaryBrush}"/>
    </Grid>
</UserControl>
