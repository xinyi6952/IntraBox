<UserControl x:Class="IntraBox.Modules.MachineInfo.MachineInfoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:IntraBox.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <WrapPanel Margin="0,0,0,8">
            <Button Content="刷新" Style="{StaticResource PrimaryButton}" Margin="0,4,8,4" Click="Refresh_Click"/>
            <Button Content="复制全部" Margin="0,4,8,4" Click="Copy_Click"/>
            <TextBlock x:Name="MsgText" VerticalAlignment="Center" Margin="8,4,0,4"
                       Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
        </WrapPanel>
        <controls:CodeEditor x:Name="OutputBox" Grid.Row="1" IsReadOnly="True" CanMaximize="True"/>
    </Grid>
</UserControl>
