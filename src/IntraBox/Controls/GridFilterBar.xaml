<UserControl x:Class="IntraBox.Controls.GridFilterBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Orientation="Horizontal">
        <TextBlock Text="筛选" VerticalAlignment="Center" Margin="0,0,6,0"
                   Foreground="{DynamicResource TextSecondaryBrush}"/>
        <TextBox x:Name="Box" MinWidth="160" VerticalAlignment="Center"
                 ToolTip="对结果按任意列做包含匹配（不区分大小写）"
                 TextChanged="Box_TextChanged"/>
    </StackPanel>
</UserControl>
