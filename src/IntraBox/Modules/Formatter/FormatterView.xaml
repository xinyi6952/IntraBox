<UserControl x:Class="IntraBox.Modules.Formatter.FormatterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:IntraBox.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="3*"/>
        </Grid.RowDefinitions>

        <WrapPanel x:Name="ToolbarPanel" Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="格式" VerticalAlignment="Center" Margin="0,4,8,4"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
            <ComboBox x:Name="FormatCombo" MinWidth="120" Margin="0,4,16,4"/>
            <TextBlock Text="缩进" VerticalAlignment="Center" Margin="0,4,8,4"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
            <ComboBox x:Name="IndentCombo" MinWidth="90" Margin="0,4,16,4" SelectedIndex="0">
                <ComboBoxItem Content="4 空格"/>
                <ComboBoxItem Content="2 空格"/>
                <ComboBoxItem Content="Tab"/>
            </ComboBox>
            <CheckBox x:Name="CompressCheck" Content="压缩" Margin="0,4,16,4"
                      Checked="OnOptionChanged" Unchecked="OnOptionChanged"/>
            <Button Content="复制结果" Style="{StaticResource PrimaryButton}" Margin="0,4,8,4" Click="CopyBtn_Click"/>
            <TextBlock x:Name="ErrorText" VerticalAlignment="Center" Margin="8,4,0,4"
                       Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap"/>
        </WrapPanel>

        <TextBlock x:Name="InputCaption" Grid.Row="1" Text="输入（粘贴后自动格式化）" Margin="0,0,0,4"
                   Foreground="{DynamicResource TextSecondaryBrush}"/>
        <controls:CodeEditor x:Name="InputBox" Grid.Row="2"/>

        <TextBlock x:Name="OutputCaption" Grid.Row="3" Text="输出" Margin="0,8,0,4" Foreground="{DynamicResource TextSecondaryBrush}"/>
        <controls:CodeEditor x:Name="OutputBox" Grid.Row="4" IsReadOnly="True" CanMaximize="True"/>
    </Grid>
</UserControl>
