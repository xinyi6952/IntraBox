<UserControl x:Class="IntraBox.Modules.ImageConvert.ImageConvertView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <WrapPanel Margin="0,0,0,8">
            <Button Content="选图片" Style="{StaticResource PrimaryButton}" Margin="0,4,8,4" Click="Pick_Click"/>
            <Button Content="选目录" Margin="0,4,8,4" Click="PickDir_Click"/>
            <Button Content="输出目录" Margin="0,4,8,4" Click="Out_Click"/>
            <Button Content="开始转换" Margin="0,4,8,4" Click="Run_Click"/>
        </WrapPanel>
        <WrapPanel Margin="0,0,0,8">
            <TextBlock Text="缩放%" VerticalAlignment="Center" Margin="0,4,4,4" Foreground="{DynamicResource TextSecondaryBrush}"/>
            <TextBox x:Name="ScaleBox" Width="48" Text="100" Margin="0,4,12,4"/>
            <TextBlock Text="宽" VerticalAlignment="Center" Margin="0,4,4,4" Foreground="{DynamicResource TextSecondaryBrush}"/>
            <TextBox x:Name="WBox" Width="56" Margin="0,4,8,4"/>
            <TextBlock Text="高" VerticalAlignment="Center" Margin="0,4,4,4" Foreground="{DynamicResource TextSecondaryBrush}"/>
            <TextBox x:Name="HBox" Width="56" Margin="0,4,12,4"/>
            <TextBlock Text="格式" VerticalAlignment="Center" Margin="0,4,4,4" Foreground="{DynamicResource TextSecondaryBrush}"/>
            <ComboBox x:Name="FmtCombo" Width="80" SelectedIndex="0" Margin="0,4,12,4">
                <ComboBoxItem Content="JPG"/>
                <ComboBoxItem Content="PNG"/>
                <ComboBoxItem Content="BMP"/>
                <ComboBoxItem Content="GIF"/>
            </ComboBox>
            <TextBlock Text="JPEG质量" VerticalAlignment="Center" Margin="0,4,4,4" Foreground="{DynamicResource TextSecondaryBrush}"/>
            <TextBox x:Name="QBox" Width="48" Text="85" Margin="0,4,8,4"/>
            <TextBlock Text="WebP 本版不支持" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
        </WrapPanel>
        <TextBlock x:Name="ListText" TextWrapping="Wrap" Margin="0,0,0,8" Foreground="{DynamicResource TextSecondaryBrush}"/>
        <TextBlock x:Name="MsgText" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>
    </StackPanel>
</UserControl>
