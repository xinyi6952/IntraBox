<UserControl x:Class="IntraBox.Modules.DupFiles.DupFilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <WrapPanel Margin="0,0,0,8">
            <Button Content="选择目录" Style="{StaticResource PrimaryButton}" Margin="0,4,8,4" Click="Pick_Click"/>
            <Button x:Name="ScanBtn" Content="开始查找" Margin="0,4,8,4" Click="Scan_Click"/>
            <Button Content="定位" Margin="0,4,8,4" Click="Locate_Click"/>
            <Button Content="删除选中" Margin="0,4,8,4" Click="Delete_Click"/>
            <CheckBox x:Name="SubCheck" Content="含子目录" IsChecked="True" Margin="8,4,8,4"/>
        </WrapPanel>
        <DockPanel Grid.Row="1" Margin="0,0,0,8">
            <TextBlock Text="目录" VerticalAlignment="Center" Margin="0,0,8,0"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
            <TextBox x:Name="DirBox" IsReadOnly="True" MinHeight="26"
                     ToolTip="当前要查找的目录"/>
        </DockPanel>
        <ProgressBar x:Name="Bar" Grid.Row="2" Height="8" Margin="0,0,0,8" Minimum="0" Maximum="100"/>
        <DataGrid x:Name="ResultGrid" Grid.Row="3" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="All"
                  SelectionMode="Single" SelectionUnit="FullRow" BorderThickness="1">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="名称" Width="240">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid Margin="{Binding Indent}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="18"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Width="18" Height="18" MinWidth="18" MinHeight="18" Padding="0"
                                        FontSize="11" PreviewMouseLeftButtonDown="Expand_Click"
                                        Visibility="{Binding ExpanderVisibility}"
                                        Content="{Binding ExpanderGlyph}" ToolTip="展开/折叠"/>
                                <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="4,0,0,0"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Name}"/>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="大小" Binding="{Binding SizeText}" Width="100"/>
                <DataGridTextColumn Header="哈希" Binding="{Binding HashText}" Width="150"/>
                <DataGridTextColumn Header="路径" Binding="{Binding PathText}" Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            <Setter Property="ToolTip" Value="{Binding PathText}"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>
        <TextBlock x:Name="MsgText" Grid.Row="4" Margin="0,8,0,0" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextSecondaryBrush}"/>
    </Grid>
</UserControl>
