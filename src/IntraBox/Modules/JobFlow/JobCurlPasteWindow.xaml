<Window x:Class="IntraBox.Modules.JobFlow.JobCurlPasteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:IntraBox.Controls"
        Title="从 curl 新建 REST 步骤" Width="640" Height="420"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBgBrush}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   Text="粘贴浏览器「复制为 cURL (bash)」或 curl.exe 命令，识别后写入步骤库（只解析，不发请求、不调用 curl.exe）。"/>
        <controls:RequiredLabel Grid.Row="1" Text="curl 命令" Margin="0,0,0,6"
                                Foreground="{DynamicResource TextSecondaryBrush}"/>
        <TextBox x:Name="CurlBox" Grid.Row="2" AcceptsReturn="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                 FontFamily="Consolas"/>
        <TextBlock x:Name="HintText" Grid.Row="3" Margin="0,8,0,8" TextWrapping="Wrap"
                   Foreground="{DynamicResource DangerBrush}"/>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="识别并填入" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Click="Recognize_Click"/>
            <Button Content="取消" Width="88" IsCancel="True" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
