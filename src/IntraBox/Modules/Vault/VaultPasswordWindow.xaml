<Window x:Class="IntraBox.Modules.Vault.VaultPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="查看密码" Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBgBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontSize="14">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="HintText" Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,14"
                   Foreground="{DynamicResource TextSecondaryBrush}"/>
        <StackPanel x:Name="OldPanel" Grid.Row="1" Margin="0,0,0,10" Visibility="Collapsed">
            <TextBlock Text="当前查看密码" Margin="0,0,0,6"/>
            <PasswordBox x:Name="OldBox"/>
        </StackPanel>
        <StackPanel x:Name="NewPanel" Grid.Row="2" Margin="0,0,0,10">
            <TextBlock x:Name="NewLabel" Text="查看密码" Margin="0,0,0,6"/>
            <PasswordBox x:Name="NewBox"/>
        </StackPanel>
        <StackPanel x:Name="ConfirmPanel" Grid.Row="3" Margin="0,0,0,14">
            <TextBlock Text="再输入一次" Margin="0,0,0,6"/>
            <PasswordBox x:Name="ConfirmBox"/>
        </StackPanel>
        <TextBlock x:Name="ErrorText" Grid.Row="4" Margin="0,0,0,10"
                   Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap"/>
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消" MinWidth="72" Margin="0,0,10,0" IsCancel="True" Click="Cancel_Click"/>
            <Button Content="确定" MinWidth="72" Style="{StaticResource PrimaryButton}"
                    IsDefault="True" Click="Ok_Click"/>
        </StackPanel>
    </Grid>
</Window>
