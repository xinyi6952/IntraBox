<UserControl x:Class="IntraBox.Modules.Todo.TodoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:todo="clr-namespace:IntraBox.Modules.Todo">
    <UserControl.Resources>
        <Style x:Key="TodoCellText" TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>
    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <WrapPanel Grid.Row="0" Margin="0,0,0,8">
            <Button Content="新建" Style="{StaticResource PrimaryButton}" Margin="0,4,8,4" Click="New_Click"/>
            <Button x:Name="ModeListBtn" Content="列表" Margin="0,4,4,4" Click="ModeList_Click"/>
            <Button x:Name="ModeCalBtn" Content="日历" Margin="0,4,8,4" Click="ModeCal_Click"/>
            <TextBlock x:Name="MsgText" VerticalAlignment="Center" Margin="8,4,0,4"
                       Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
        </WrapPanel>

        <Grid Grid.Row="1">
            <Grid x:Name="ListHost">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="True">
                    <Button DockPanel.Dock="Right" Content="导出 xlsx" Margin="12,0,0,0" Click="ExportXlsx_Click"/>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="TabTodo" Content="待办" GroupName="TodoTab" IsChecked="True"
                                     Margin="0,0,12,0" Click="Tab_Click"/>
                        <RadioButton x:Name="TabDone" Content="已办" GroupName="TodoTab"
                                     Margin="0,0,12,0" Click="Tab_Click"/>
                        <TextBlock x:Name="DayFilterHint" VerticalAlignment="Center" Margin="16,0,8,0"
                                   Foreground="{DynamicResource AccentBrush}"/>
                        <Button x:Name="ClearDayBtn" Content="清除日期筛选" Visibility="Collapsed"
                                Click="ClearDay_Click"/>
                    </StackPanel>
                </DockPanel>
                <ListView x:Name="TaskList" Grid.Row="1"
                          BorderThickness="1"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          SizeChanged="TaskList_SizeChanged"
                          GridViewColumnHeader.Click="TaskHeader_Click"
                          MouseLeftButtonUp="TaskList_MouseLeftButtonUp"
                          MouseDoubleClick="TaskList_MouseDoubleClick">
                    <ListView.ContextMenu>
                        <ContextMenu Opened="ListMenu_Opened" Closed="ListMenu_Closed">
                            <MenuItem x:Name="MenuEditItem" Header="编辑" Click="MenuEdit_Click" Style="{StaticResource ContextMenuItemStyle}">
                                <MenuItem.Icon>
                                    <Path Style="{StaticResource MenuIconPath}" Data="M3,13 L5,15 13,7 11,5 Z M12,4 L14,6"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem x:Name="MenuDoneItem" Header="标记为已办" Click="MenuDone_Click" Style="{StaticResource ContextMenuItemStyle}">
                                <MenuItem.Icon>
                                    <Path Style="{StaticResource MenuIconPath}" Data="M3,8 L6.5,12 13,4"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem x:Name="MenuTodoItem" Header="标记为待办" Click="MenuTodo_Click" Style="{StaticResource ContextMenuItemStyle}">
                                <MenuItem.Icon>
                                    <Path Style="{StaticResource MenuIconPath}" Data="M8,3 A5,5 0 1 0 8,13 A5,5 0 1 0 8,3"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem x:Name="MenuDeleteItem" Header="删除" Click="MenuDelete_Click" Style="{StaticResource ContextMenuItemStyle}">
                                <MenuItem.Icon>
                                    <Path Style="{StaticResource MenuIconPath}" Data="M4,4 L12,12 M12,4 L4,12"/>
                                </MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </ListView.ContextMenu>
                    <ListView.View>
                        <GridView AllowsColumnReorder="False">
                            <GridViewColumn Header="状态" Width="56">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource TodoCellText}"
                                                   ToolTip="{Binding StatusText}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Width="80">
                                <GridViewColumn.Header>优先级</GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding PriorityText}" Foreground="{Binding PriorityBrush}"
                                                   FontWeight="SemiBold" Style="{StaticResource TodoCellText}"
                                                   ToolTip="{Binding PriorityText}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="任务ID" Width="120">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Id}" Style="{StaticResource TodoCellText}"
                                                   ToolTip="{Binding Id}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="标题" Width="160">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource TodoCellText}"
                                                   ToolTip="{Binding Title}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="创建时间" Width="128">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding CreatedText}" Style="{StaticResource TodoCellText}"
                                                   ToolTip="{Binding CreatedText}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="修改时间" Width="128">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding UpdatedText}" Style="{StaticResource TodoCellText}"
                                                   ToolTip="{Binding UpdatedText}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="计划完成" Width="128">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DueText}" Foreground="{Binding DueBrush}"
                                                   Style="{StaticResource TodoCellText}"
                                                   ToolTip="{Binding DueText}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="完成时间" Width="128">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding CompletedText}" Style="{StaticResource TodoCellText}"
                                                   ToolTip="{Binding CompletedText}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="提醒" Width="100">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding RemindText}" Style="{StaticResource TodoCellText}"
                                                   ToolTip="{Binding RemindText}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>

            <Grid x:Name="CalPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0,0,0,8">
                    <Button DockPanel.Dock="Left" Width="36" Height="32" MinWidth="36" Padding="0"
                            Click="CalPrev_Click" ToolTip="上个月">
                        <Path Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Width="10" Height="16" Stretch="Uniform" Data="M10,1 L2,8 L10,15"/>
                    </Button>
                    <Button DockPanel.Dock="Right" Width="36" Height="32" MinWidth="36" Padding="0"
                            Click="CalNext_Click" ToolTip="下个月">
                        <Path Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Width="10" Height="16" Stretch="Uniform" Data="M2,1 L10,8 L2,15"/>
                    </Button>
                    <TextBlock x:Name="CalTitle" HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontWeight="SemiBold" FontSize="16"/>
                </DockPanel>
                <UniformGrid x:Name="CalGrid" Grid.Row="1" Columns="7" Rows="7"/>
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                    <Ellipse Width="8" Height="8" Fill="{DynamicResource DangerBrush}" Margin="0,0,4,0"/>
                    <TextBlock Text="高" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Ellipse Width="8" Height="8" Fill="{DynamicResource AccentBrush}" Margin="0,0,4,0"/>
                    <TextBlock Text="中" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Ellipse Width="8" Height="8" Fill="{DynamicResource TextSecondaryBrush}" Margin="0,0,4,0"/>
                    <TextBlock Text="低（待办）" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <Ellipse Width="8" Height="8" Fill="{DynamicResource SuccessBrush}" Margin="0,0,4,0"/>
                    <TextBlock Text="已办" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <TextBlock Text="过期日期" Foreground="{DynamicResource DangerBrush}" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
            </Grid>

            <Grid x:Name="DrawerHost" Grid.Row="0" Grid.RowSpan="2" Panel.ZIndex="10" Visibility="Collapsed">
                <Border x:Name="DrawerMask" Background="#99000000" MouseLeftButtonDown="DrawerMask_Click"/>
                <Border x:Name="DrawerPanel" HorizontalAlignment="Right"
                        MinWidth="0"
                        Background="{DynamicResource PanelBgBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" Margin="16,12">
                            <Button DockPanel.Dock="Right" Content="×" Width="32" Height="32" MinWidth="32"
                                    Padding="0" Click="DrawerClose_Click" ToolTip="关闭"/>
                            <Button x:Name="DrawerMaxBtn" DockPanel.Dock="Right" Width="32" Height="32"
                                    MinWidth="32" Padding="0" Margin="0,0,4,0"
                                    Click="DrawerMax_Click" ToolTip="最大化">
                                <Grid Width="12" Height="12">
                                    <Path x:Name="IconExpand" Stroke="{DynamicResource TextSecondaryBrush}"
                                          StrokeThickness="1.5" StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          Data="M2,10 L10,2 M5,2 L10,2 L10,7"/>
                                    <Path x:Name="IconRestore" Visibility="Collapsed"
                                          Stroke="{DynamicResource TextSecondaryBrush}"
                                          StrokeThickness="1.5" StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          Data="M10,2 L2,10 M2,5 L2,10 L7,10"/>
                                </Grid>
                            </Button>
                            <TextBlock x:Name="DrawerTitle" Text="任务详情" FontSize="16" FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </DockPanel>
                        <todo:TodoEditorPanel x:Name="DrawerEditor" Grid.Row="1" Margin="16,0,4,0"/>
                        <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                                Padding="16,10">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button x:Name="DrawerPreviewBtn" Content="预览提醒" Click="DrawerPreview_Click" Margin="0,0,8,0"/>
                                    <Button x:Name="DrawerSaveBtn" Content="保存" Click="DrawerSave_Click" Margin="0,0,8,0"/>
                                    <Button x:Name="DrawerSaveCloseBtn" Content="保存并关闭" Style="{StaticResource PrimaryButton}" Click="DrawerSaveClose_Click"/>
                                    <Button x:Name="DrawerCloseFooterBtn" Content="关闭" Visibility="Collapsed"
                                            Style="{StaticResource PrimaryButton}" Click="DrawerClose_Click"/>
                                </StackPanel>
                                <TextBlock x:Name="DrawerMsg" VerticalAlignment="Center" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
    </Grid>
</UserControl>
