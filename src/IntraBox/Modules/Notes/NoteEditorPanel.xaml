<UserControl x:Class="IntraBox.Modules.Notes.NoteEditorPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:IntraBox.Controls"
             PreviewKeyDown="Panel_PreviewKeyDown">
    <UserControl.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Save" Executed="SaveCommand_Executed"/>
    </UserControl.CommandBindings>
    <UserControl.Resources>
        <Style x:Key="RteBtn" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="MinWidth" Value="28"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="200"/>
        </Style>
        <Style x:Key="ColorDot" TargetType="Button">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="MinWidth" Value="16"/>
            <Setter Property="MinHeight" Value="16"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Width="14" Height="14" CornerRadius="7"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="bd" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBox x:Name="TitleBox" Grid.Row="0" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"
                 BorderThickness="0,0,0,1" Padding="4,6"
                 TextChanged="TitleBox_TextChanged"/>
        <WrapPanel x:Name="RichToolbar" Grid.Row="1" Margin="0,0,0,6" VerticalAlignment="Center">
            <ComboBox x:Name="StyleCombo" Width="92" Height="28" Margin="1,0" SelectionChanged="RichStyle_Changed">
                <ComboBoxItem Content="正文" IsSelected="True"/>
                <ComboBoxItem Content="标题一"/>
                <ComboBoxItem Content="标题二"/>
                <ComboBoxItem Content="标题三"/>
            </ComboBox>
            <ComboBox x:Name="FontCombo" Width="108" Height="28" Margin="1,0" SelectionChanged="Font_Changed"/>
            <ComboBox x:Name="SizeCombo" Width="56" Height="28" Margin="1,0" SelectionChanged="Size_Changed"/>
            <Rectangle Width="1" Height="16" Fill="{DynamicResource BorderBrush}" Margin="4,0"/>
            <Button Style="{StaticResource RteBtn}" ToolTip="加粗" Command="EditingCommands.ToggleBold" CommandTarget="{Binding ElementName=DetailBox}">
                <TextBlock Text="B" FontWeight="Bold" FontFamily="Times New Roman" FontSize="14"/>
            </Button>
            <Button Style="{StaticResource RteBtn}" ToolTip="斜体" Command="EditingCommands.ToggleItalic" CommandTarget="{Binding ElementName=DetailBox}">
                <TextBlock Text="I" FontStyle="Italic" FontFamily="Times New Roman" FontSize="14"/>
            </Button>
            <Button Style="{StaticResource RteBtn}" ToolTip="下划线" Command="EditingCommands.ToggleUnderline" CommandTarget="{Binding ElementName=DetailBox}">
                <TextBlock Text="U" TextDecorations="Underline" FontFamily="Times New Roman" FontSize="14"/>
            </Button>
            <Button Style="{StaticResource RteBtn}" ToolTip="删除线" Click="Strike_Click">
                <TextBlock Text="S" FontFamily="Times New Roman" FontSize="14" TextDecorations="Strikethrough"/>
            </Button>
            <Rectangle Width="1" Height="16" Fill="{DynamicResource BorderBrush}" Margin="4,0"/>
            <Button Style="{StaticResource RteBtn}" ToolTip="编号" Command="EditingCommands.ToggleNumbering" CommandTarget="{Binding ElementName=DetailBox}">
                <TextBlock Text="1." FontSize="11" FontFamily="Segoe UI"/>
            </Button>
            <Button Style="{StaticResource RteBtn}" ToolTip="项目符号" Command="EditingCommands.ToggleBullets" CommandTarget="{Binding ElementName=DetailBox}">
                <Path Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.4"
                      StrokeStartLineCap="Round" Width="12" Height="12" Stretch="Uniform"
                      Data="M1,2.5 H2.5 M4,2.5 H11 M1,6 H2.5 M4,6 H11 M1,9.5 H2.5 M4,9.5 H11"/>
            </Button>
            <Rectangle Width="1" Height="16" Fill="{DynamicResource BorderBrush}" Margin="4,0"/>
            <Button Style="{StaticResource RteBtn}" ToolTip="左对齐" Command="EditingCommands.AlignLeft" CommandTarget="{Binding ElementName=DetailBox}">
                <Path Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.4"
                      StrokeStartLineCap="Round" Width="12" Height="12" Stretch="Uniform"
                      Data="M1,2.5 H11 M1,6 H8 M1,9.5 H11"/>
            </Button>
            <Button Style="{StaticResource RteBtn}" ToolTip="居中" Command="EditingCommands.AlignCenter" CommandTarget="{Binding ElementName=DetailBox}">
                <Path Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.4"
                      StrokeStartLineCap="Round" Width="12" Height="12" Stretch="Uniform"
                      Data="M2,2.5 H10 M3.5,6 H8.5 M2,9.5 H10"/>
            </Button>
            <Button Style="{StaticResource RteBtn}" ToolTip="右对齐" Command="EditingCommands.AlignRight" CommandTarget="{Binding ElementName=DetailBox}">
                <Path Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.4"
                      StrokeStartLineCap="Round" Width="12" Height="12" Stretch="Uniform"
                      Data="M1,2.5 H11 M4,6 H11 M1,9.5 H11"/>
            </Button>
            <Rectangle Width="1" Height="16" Fill="{DynamicResource BorderBrush}" Margin="4,0"/>
            <Button Style="{StaticResource ColorDot}" Background="{DynamicResource TextPrimaryBrush}"
                    ToolTip="默认颜色" Click="Color_Click" Tag="default"/>
            <Button Style="{StaticResource ColorDot}" Background="#E81123"
                    ToolTip="红色" Click="Color_Click" Tag="#E81123"/>
            <Button Style="{StaticResource ColorDot}" Background="#FF8C00"
                    ToolTip="橙色" Click="Color_Click" Tag="#FF8C00"/>
            <Button Style="{StaticResource ColorDot}" Background="#107C10"
                    ToolTip="绿色" Click="Color_Click" Tag="#107C10"/>
            <Button Style="{StaticResource ColorDot}" Background="#0078D4"
                    ToolTip="蓝色" Click="Color_Click" Tag="#0078D4"/>
            <Button Style="{StaticResource RteBtn}" ToolTip="高亮" Click="Highlight_Click">
                <Path Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.3"
                      StrokeStartLineCap="Round" StrokeLineJoin="Round"
                      Width="12" Height="12" Stretch="Uniform"
                      Data="M2,11 L4,4 L8.5,4 L10.5,11 M3.5,8 H9 M5,4 L6,1.5 H7.2 L8,4"/>
            </Button>
            <Rectangle Width="1" Height="16" Fill="{DynamicResource BorderBrush}" Margin="4,0"/>
            <Button Style="{StaticResource RteBtn}" ToolTip="插入图片" Click="InsertImage_Click">
                <Path Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.3"
                      StrokeStartLineCap="Round" StrokeLineJoin="Round"
                      Width="14" Height="12" Stretch="Uniform"
                      Data="M1,11 L1,1 L13,1 L13,11 Z M1,8 L4.5,5 L7,7.5 L9,6 L13,10"/>
            </Button>
            <Button Style="{StaticResource RteBtn}" ToolTip="插入链接" Click="InsertLink_Click">
                <Path Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.4"
                      StrokeStartLineCap="Round" Width="14" Height="12" Stretch="Uniform"
                      Data="M5.5,8.2 C4.2,8.2 3.2,7.2 3.2,6 C3.2,4.8 4.2,3.8 5.5,3.8 H7.2 M8.5,3.8 C9.8,3.8 10.8,4.8 10.8,6 C10.8,7.2 9.8,8.2 8.5,8.2 H6.8"/>
            </Button>
            <Button Style="{StaticResource RteBtn}" ToolTip="分割线" Click="InsertHr_Click">
                <Path Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.4"
                      StrokeStartLineCap="Round" Width="14" Height="12" Stretch="Uniform"
                      Data="M1,6 H13"/>
            </Button>
            <Button Style="{StaticResource RteBtn}" ToolTip="当前时间" Click="InsertTime_Click">
                <Path Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.3"
                      StrokeStartLineCap="Round" StrokeLineJoin="Round"
                      Width="12" Height="12" Stretch="Uniform"
                      Data="M6,1 A5,5 0 1 1 5.99,1 M6,3.2 V6.2 L8.2,7.5"/>
            </Button>
            <Button Style="{StaticResource RteBtn}" ToolTip="清除格式" Click="ClearFormat_Click">
                <Path Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.3"
                      StrokeStartLineCap="Round" StrokeLineJoin="Round"
                      Width="12" Height="12" Stretch="Uniform"
                      Data="M2.5,10.5 L6.2,2.5 H9.2 L5.5,10.5 Z M3.8,8 H8.2 M2,11.5 H10"/>
            </Button>
        </WrapPanel>
        <WrapPanel x:Name="MdToolbar" Grid.Row="1" Margin="0,0,0,6" Visibility="Collapsed">
            <Button Style="{StaticResource RteBtn}" ToolTip="加粗" Click="MdBold_Click">
                <TextBlock Text="B" FontWeight="Bold" FontFamily="Times New Roman" FontSize="14"/>
            </Button>
            <Button Style="{StaticResource RteBtn}" ToolTip="斜体" Click="MdItalic_Click">
                <TextBlock Text="I" FontStyle="Italic" FontFamily="Times New Roman" FontSize="14"/>
            </Button>
            <Button Style="{StaticResource RteBtn}" ToolTip="下划线" Click="MdUnderline_Click">
                <TextBlock Text="U" TextDecorations="Underline" FontFamily="Times New Roman" FontSize="14"/>
            </Button>
            <Button Style="{StaticResource RteBtn}" ToolTip="删除线" Click="MdStrike_Click">
                <TextBlock Text="S" FontFamily="Times New Roman" FontSize="14" TextDecorations="Strikethrough"/>
            </Button>
            <ComboBox x:Name="MdHeadCombo" Width="72" Height="28" Margin="2,0" SelectionChanged="MdHead_Changed">
                <ComboBoxItem Content="标题" IsSelected="True"/>
                <ComboBoxItem Content="H1"/>
                <ComboBoxItem Content="H2"/>
                <ComboBoxItem Content="H3"/>
                <ComboBoxItem Content="H4"/>
                <ComboBoxItem Content="H5"/>
                <ComboBoxItem Content="H6"/>
            </ComboBox>
            <Rectangle Width="1" Height="16" Fill="{DynamicResource BorderBrush}" Margin="4,0"/>
            <Button Style="{StaticResource RteBtn}" ToolTip="分割线" Click="MdHr_Click">
                <Path Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.4"
                      StrokeStartLineCap="Round" Width="14" Height="12" Stretch="Uniform"
                      Data="M1,6 H13"/>
            </Button>
            <Button Style="{StaticResource RteBtn}" ToolTip="引用" Click="MdQuote_Click">
                <Path Fill="{DynamicResource TextPrimaryBrush}"
                      Width="12" Height="12" Stretch="Uniform"
                      Data="M2,3.5 C2,6.2 3.8,7.6 5.4,8.2 L5.4,10.2 C2.8,9.4 0.8,7.4 0.8,4.6 C0.8,3.4 1.4,2.4 2.4,2.4 C3.4,2.4 4.1,3.2 4.1,4.2 C4.1,5.1 3.5,5.8 2.6,5.8 C2.4,5.8 2.2,5.8 2,5.7 Z M8.6,3.5 C8.6,6.2 10.4,7.6 12,8.2 L12,10.2 C9.4,9.4 7.4,7.4 7.4,4.6 C7.4,3.4 8,2.4 9,2.4 C10,2.4 10.7,3.2 10.7,4.2 C10.7,5.1 10.1,5.8 9.2,5.8 C9,5.8 8.8,5.8 8.6,5.7 Z"/>
            </Button>
            <Button Style="{StaticResource RteBtn}" ToolTip="无序列表" Click="MdUl_Click">
                <Path Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.4"
                      StrokeStartLineCap="Round" Width="12" Height="12" Stretch="Uniform"
                      Data="M1,2.5 H2.5 M4,2.5 H11 M1,6 H2.5 M4,6 H11 M1,9.5 H2.5 M4,9.5 H11"/>
            </Button>
            <Button Style="{StaticResource RteBtn}" ToolTip="有序列表" Click="MdOl_Click">
                <TextBlock Text="1." FontSize="11" FontFamily="Segoe UI"/>
            </Button>
            <Button Style="{StaticResource RteBtn}" ToolTip="待办" Click="MdTask_Click">
                <Path Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.3"
                      StrokeLineJoin="Round" Width="12" Height="12" Stretch="Uniform"
                      Data="M2,2 H10 V10 H2 Z"/>
            </Button>
            <Button Style="{StaticResource RteBtn}" ToolTip="已勾选" Click="MdTaskDone_Click">
                <Path Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.3"
                      StrokeStartLineCap="Round" StrokeLineJoin="Round"
                      Width="12" Height="12" Stretch="Uniform"
                      Data="M2,2 H10 V10 H2 Z M3.2,6.2 L5.2,8.2 L8.8,3.8"/>
            </Button>
            <Rectangle Width="1" Height="16" Fill="{DynamicResource BorderBrush}" Margin="4,0"/>
            <Button Style="{StaticResource RteBtn}" ToolTip="链接" Click="MdLink_Click">
                <Path Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.4"
                      StrokeStartLineCap="Round" Width="14" Height="12" Stretch="Uniform"
                      Data="M5.5,8.2 C4.2,8.2 3.2,7.2 3.2,6 C3.2,4.8 4.2,3.8 5.5,3.8 H7.2 M8.5,3.8 C9.8,3.8 10.8,4.8 10.8,6 C10.8,7.2 9.8,8.2 8.5,8.2 H6.8"/>
            </Button>
            <Button Style="{StaticResource RteBtn}" ToolTip="图片" Click="MdImage_Click">
                <Path Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.3"
                      StrokeStartLineCap="Round" StrokeLineJoin="Round"
                      Width="14" Height="12" Stretch="Uniform"
                      Data="M1,11 L1,1 L13,1 L13,11 Z M1,8 L4.5,5 L7,7.5 L9,6 L13,10"/>
            </Button>
            <Button Style="{StaticResource RteBtn}" ToolTip="行内代码" Click="MdInlineCode_Click">
                <Path Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.4"
                      StrokeStartLineCap="Round" StrokeLineJoin="Round"
                      Width="12" Height="12" Stretch="Uniform"
                      Data="M4.5,2.5 L1.2,6 L4.5,9.5 M7.5,2.5 L10.8,6 L7.5,9.5"/>
            </Button>
            <Button Style="{StaticResource RteBtn}" ToolTip="代码块" Click="MdCodeBlock_Click">
                <Path Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.3"
                      StrokeLineJoin="Round" Width="12" Height="12" Stretch="Uniform"
                      Data="M1.5,2 H10.5 V10 H1.5 Z M3.2,4.5 H8.8 M3.2,6.5 H7.2 M3.2,8.5 H8"/>
            </Button>
            <Button Style="{StaticResource RteBtn}" ToolTip="表格" Click="MdTable_Click">
                <Path Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.2"
                      StrokeLineJoin="Round" Width="12" Height="12" Stretch="Uniform"
                      Data="M1.5,2 H10.5 V10 H1.5 Z M1.5,4.7 H10.5 M1.5,7.3 H10.5 M4.5,2 V10 M7.5,2 V10"/>
            </Button>
            <Button Style="{StaticResource RteBtn}" ToolTip="Markdown 语法" Click="MdHelp_Click">
                <Path Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.3"
                      StrokeStartLineCap="Round" Width="12" Height="12" Stretch="Uniform"
                      Data="M6,1.2 A4.8,4.8 0 1 1 5.99,1.2 M4.8,4.6 C5,3.5 6.6,3.2 7.3,4.2 C8,5.1 6.6,5.8 6,6.8 M6,9.2 V9.6"/>
            </Button>
            <RadioButton x:Name="ModeEdit" Content="编辑" GroupName="MdMode" IsChecked="True" Margin="12,0,8,0"
                         VerticalAlignment="Center" Click="MdMode_Click"/>
            <RadioButton x:Name="ModePreview" Content="预览" GroupName="MdMode" Margin="0,0,8,0"
                         VerticalAlignment="Center" Click="MdMode_Click"/>
            <RadioButton x:Name="ModeSplit" Content="分栏" GroupName="MdMode"
                         VerticalAlignment="Center" Click="MdMode_Click"/>
        </WrapPanel>
        <Grid x:Name="RichHost" Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="40"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{DynamicResource NotesLineNumberBgBrush}"
                    BorderBrush="{DynamicResource NotesLineNumberBrush}" BorderThickness="0,1,2,1"
                    CornerRadius="4,0,0,4">
                <Canvas x:Name="ParaNumberCanvas" ClipToBounds="True"/>
            </Border>
            <Border Grid.Column="1" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,1,1,1" CornerRadius="0,4,4,0"
                    Background="{DynamicResource EditorBackgroundBrush}">
                <RichTextBox x:Name="DetailBox" BorderThickness="0" Padding="10,8"
                             VerticalScrollBarVisibility="Auto" AcceptsReturn="True" AcceptsTab="True"
                             IsDocumentEnabled="False" FontFamily="Microsoft YaHei" FontSize="14"
                             Background="{DynamicResource EditorBackgroundBrush}"
                             Foreground="{DynamicResource EditorForegroundBrush}"
                             CaretBrush="{DynamicResource TextPrimaryBrush}"
                             SelectionChanged="DetailBox_SelectionChanged"
                             TextChanged="DetailBox_TextChanged"
                             AllowDrop="True" PreviewDragOver="DetailBox_PreviewDragOver" Drop="DetailBox_Drop"/>
            </Border>
        </Grid>
        <Grid x:Name="MdHost" Grid.Row="2" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="MdEditCol" Width="*"/>
                <ColumnDefinition x:Name="MdSplitCol" Width="8"/>
                <ColumnDefinition x:Name="MdPreviewCol" Width="0"/>
            </Grid.ColumnDefinitions>
            <controls:CodeEditor x:Name="MdBox" Grid.Column="0"/>
            <GridSplitter x:Name="MdSplitter" Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Visibility="Collapsed"/>
            <Border x:Name="MdPreviewWrap" Grid.Column="2" Visibility="Collapsed"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <WebBrowser x:Name="MdPreview"/>
            </Border>
        </Grid>
        <DockPanel Grid.Row="3" Margin="0,8,0,0">
            <Button DockPanel.Dock="Right" Content="保存" Style="{StaticResource PrimaryButton}"
                    MinWidth="64" Click="Save_Click" ToolTip="保存 (Ctrl+S)"/>
            <CheckBox x:Name="AutoSaveCheck" DockPanel.Dock="Right" Content="自动保存" Margin="0,0,12,0"
                      VerticalAlignment="Center" Checked="AutoSave_Changed" Unchecked="AutoSave_Changed"/>
            <TextBlock x:Name="StatusText" DockPanel.Dock="Left"
                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"
                       VerticalAlignment="Center"/>
            <TextBlock x:Name="SaveHint" HorizontalAlignment="Right" Margin="8,0"
                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"
                       VerticalAlignment="Center" Text="未保存"/>
        </DockPanel>
    </Grid>
</UserControl>
